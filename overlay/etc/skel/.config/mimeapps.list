# Default applications shipped to every fresh home (see 10-image.sh). Without
# this Thunar has no handler for video files and its launcher falls back to
# running a literal "%U" — the "missing exec" error.
#
# play-mpv.desktop (overlay/usr/local/share/applications) is the handler: plain
# `mpv -- %f`, no --player-operation-mode=pseudo-gui. mpv.desktop stays second
# as the fallback; it must resolve to Debian's /usr/share entry, so there is no
# hide-stub shadowing it in /usr/local (a stub with no Exec= made Thunar fail
# with "Desktop file didn't specify Exec field"). Decode policy lives in
# /etc/mpv/mpv.conf.
[Default Applications]
video/mp4=play-mpv.desktop;mpv.desktop
video/x-matroska=play-mpv.desktop;mpv.desktop
video/webm=play-mpv.desktop;mpv.desktop
video/quicktime=play-mpv.desktop;mpv.desktop
video/x-msvideo=play-mpv.desktop;mpv.desktop
video/mpeg=play-mpv.desktop;mpv.desktop
video/x-mpegurl=play-mpv.desktop;mpv.desktop
video/mp2t=play-mpv.desktop;mpv.desktop
video/ogg=play-mpv.desktop;mpv.desktop
video/x-theora+ogg=play-mpv.desktop;mpv.desktop
