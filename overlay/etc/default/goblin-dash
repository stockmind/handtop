# goblin-dash environment (source by /usr/local/bin/goblin-dash or labwc autostart)
# Set these to enable the Jellyfin now-playing panel; empty = off.
DASH_JELLYFIN=""
DASH_API_KEY=""
# DASH_JELLYFIN=http://mediaserver:8096
# DASH_API_KEY=<your-api-key-here>
# goblin TUI transcode defaults (on): server-side 720p h264 for downloads of
# big/tall originals and for streaming. Opt out here if your server is slower
# than your network:
# GOBLIN_DL_TRANSCODE=0
# GOBLIN_STREAM_TRANSCODE=0
