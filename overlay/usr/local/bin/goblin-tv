#!/usr/bin/env python3
"""goblin-tv — browse YouTube and Twitch, play through goblin-watch.

Twitch opens on the top live streams; `3` lists the top categories. YouTube has
no "featured" list without cookies, so `1` shows a few topic shortcuts and the
search box. The box does two jobs: typing filters whatever list is on screen,
Enter searches the current source (YouTube videos, Twitch channels).

Enter on a row plays it with goblin-watch, which decodes on the VPU; B/Esc
closes the stream and comes back to the same list. Recently played items live in
~/.local/state/goblin-tv/recent.json.

Keys: 1 YouTube · 2 Twitch streams · 3 Twitch categories · 4 Recent
      5 480p/720p · Enter search/play · Esc back · r refresh · q quit
"""
import json
import os
import subprocess
import urllib.request

from rich.text import Text
from textual import work
from textual.app import App, ComposeResult
from textual.widgets import Footer, Header, Input, Label, ListItem, ListView, Static

# Twitch's public web client id (the one the website itself uses).
TWITCH_CLIENT_ID = "kimne78kx3ncx6brgo4mv6wki5h1ko"
RECENT_FILE = os.path.expanduser("~/.local/state/goblin-tv/recent.json")
RECENT_MAX = 50
HEIGHTS = (480, 720)

# What `1` shows before a query is typed: one Enter on a row searches that topic.
TOPICS = ("Music", "Gaming", "News", "Movies", "Comedy", "Technology", "Sport")


def gql(query):
    request = urllib.request.Request(
        "https://gql.twitch.tv/gql",
        data=json.dumps([{"query": query}]).encode(),
        headers={"Client-ID": TWITCH_CLIENT_ID, "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)[0]["data"]


def fmt_duration(seconds):
    try:
        seconds = int(seconds)
    except (TypeError, ValueError):
        return ""
    if seconds >= 3600:
        return f"{seconds // 3600}:{seconds % 3600 // 60:02d}:{seconds % 60:02d}"
    return f"{seconds // 60}:{seconds % 60:02d}"


def fmt_viewers(count):
    count = count or 0
    return f"{count / 1000:.1f}k" if count >= 1000 else str(count)


def youtube_search(query, count=30):
    result = subprocess.run(
        ["yt-dlp", "--flat-playlist", "--dump-json", f"ytsearch{count}:{query}"],
        capture_output=True, text=True, timeout=180,
    )
    items = []
    for line in result.stdout.splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if not entry.get("id"):
            continue
        meta = " · ".join(x for x in (
            entry.get("channel") or entry.get("uploader") or "",
            fmt_duration(entry.get("duration"))) if x)
        items.append({
            "title": entry.get("title") or entry["id"],
            "meta": meta,
            "url": "https://www.youtube.com/watch?v=" + entry["id"],
        })
    return items


def twitch_search(query, count=30):
    """Twitch channel search: live channels first, offline ones marked."""
    inner = ('channels{edges{item{ ... on User { login displayName '
             'stream{ title viewersCount game{name} } } }}}')
    data = gql('{ searchFor(userQuery:%s, platform:"web"){ %s } }'
               % (json.dumps(query), inner))["searchFor"]["channels"]["edges"]
    items = []
    for edge in data:
        user = edge["item"]
        stream = user.get("stream")
        if stream:
            meta = (f"{fmt_viewers(stream['viewersCount'])} viewers · "
                    f"{stream['game']['name']} · {stream['title']}")
        else:
            meta = "offline"
        items.append({
            "title": user["displayName"],
            "meta": meta,
            "url": "https://www.twitch.tv/" + user["login"],
            "live": bool(stream),
        })
    items.sort(key=lambda item: not item["live"])
    return items[:count]


def twitch_streams(game=None, count=30):
    if game:
        inner = ('streams(first:%d){edges{node{title viewersCount '
                 'broadcaster{login displayName} game{name}}}}' % count)
        node = gql('{ game(name:%s){ %s } }' % (json.dumps(game), inner))["game"]
    else:
        node = gql('{ streams(first:%d){edges{node{title viewersCount '
                   'broadcaster{login displayName} game{name}}}} }' % count)
    items = []
    for edge in node["streams"]["edges"]:
        stream = edge["node"]
        items.append({
            "title": stream["title"],
            "meta": f"{fmt_viewers(stream['viewersCount'])} viewers · {stream['game']['name']}",
            "url": "https://www.twitch.tv/" + stream["broadcaster"]["login"],
        })
    return items


def twitch_games(count=30):
    data = gql('{ games(first:%d){edges{node{name displayName viewersCount}}} }' % count)
    items = []
    for edge in data["games"]["edges"]:
        game = edge["node"]
        items.append({
            "kind": "game",
            "name": game["name"],
            "title": game["displayName"],
            "meta": f"{fmt_viewers(game['viewersCount'])} viewers",
            "url": None,
        })
    return items


def youtube_topics():
    return [{"kind": "topic", "title": topic, "meta": "search YouTube", "url": None}
            for topic in TOPICS]


def load_recent():
    try:
        with open(RECENT_FILE) as handle:
            items = json.load(handle)
        return [item for item in items if item.get("url")]
    except (OSError, ValueError):
        return []


def save_recent(items):
    os.makedirs(os.path.dirname(RECENT_FILE), exist_ok=True)
    temporary = RECENT_FILE + ".tmp"
    with open(temporary, "w") as handle:
        json.dump(items[:RECENT_MAX], handle, ensure_ascii=False)
    os.replace(temporary, RECENT_FILE)


class Tv(App):
    CSS = """
    #q { dock: top; }
    #title { padding: 0 1; color: $text-muted; }
    ListView { padding: 0 1; }
    #status { dock: bottom; padding: 0 1; color: $text-muted; }
    """
    BINDINGS = [
        ("1", "youtube", "YouTube"),
        ("2", "twitch", "Twitch"),
        ("3", "games", "Categories"),
        ("4", "recent", "Recent"),
        ("5", "quality", "480p/720p"),
        ("escape", "back", "Back"),
        ("/", "focus_search", "Search"),
        ("r", "refresh", "Refresh"),
        ("q", "quit", "Quit"),
    ]

    def __init__(self):
        super().__init__()
        self.all_items = []
        self.items = []
        self.mode = "youtube"
        self.query = ""
        self.game = None
        self.height = 480

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        yield Static("", id="title")
        yield Input(placeholder="type to filter · Enter searches YouTube", id="q")
        yield ListView(id="list")
        yield Static("", id="status")
        yield Footer()

    def on_mount(self):
        self.action_start()

    def action_start(self):
        """Ask what to watch first: Twitch or YouTube."""
        self.mode, self.game = "start", None
        self.query_one("#q", Input).display = False
        self.query_one("#q", Input).value = ""
        picker = [
            {"kind": "source", "source": "twitch", "title": "Twitch",
             "meta": "live streams, categories and channel search", "url": None},
            {"kind": "source", "source": "youtube", "title": "YouTube",
             "meta": "search videos, or pick a topic", "url": None},
        ]
        self.fill(picker, "What do you want to watch?", True)

    # ---- loading -------------------------------------------------------
    @work(thread=True, exclusive=True, group="load")
    def load(self, loader, label):
        self.call_from_thread(self.set_status, f"loading {label}…")
        try:
            items = loader()
        except Exception as error:                     # network, yt-dlp, GQL
            self.call_from_thread(self.set_status, f"{label}: {error}")
            return
        self.call_from_thread(self.fill, items, label, True)

    def fill(self, items, label, focus_list=False):
        self.all_items = items
        self.query_one("#title", Static).update(label)
        self.apply_filter(focus_list)

    def apply_filter(self, focus_list=False):
        needle = self.query_one("#q", Input).value.strip().lower()
        if needle:
            self.items = [item for item in self.all_items
                          if needle in item["title"].lower()
                          or needle in item.get("meta", "").lower()]
        else:
            self.items = list(self.all_items)
        view = self.query_one(ListView)
        view.clear()
        for item in self.items:
            # Titles contain '[' (Twitch: "[654/730]"), so no markup: build a
            # rich Text and keep the label plain.
            line = Text(item["title"])
            line.append("   " + item["meta"], style="dim")
            view.append(ListItem(Label(line, markup=False)))
        if focus_list:
            view.focus()                  # Enter must select a row
            self.call_after_refresh(self.highlight_first)
        suffix = f" · filtered from {len(self.all_items)}" if needle else ""
        self.set_status(f"{len(self.items)} entries{suffix} — Enter plays, {self.height}p")

    def highlight_first(self):
        view = self.query_one(ListView)
        if view.children:
            view.index = 0

    def set_status(self, text):
        self.query_one("#status", Static).update(text)

    # ---- actions -------------------------------------------------------
    def action_twitch(self):
        self.mode, self.game = "twitch", None
        self.query_one("#q", Input).display = True
        self.placeholder("Twitch: type to filter · Enter searches channels")
        self.load(twitch_streams, "Twitch · top live streams")

    def action_games(self):
        self.mode, self.game = "games", None
        self.query_one("#q", Input).display = True
        self.placeholder("Twitch categories: type to filter")
        self.load(twitch_games, "Twitch · top categories")

    def action_recent(self):
        self.mode, self.game = "recent", None
        self.query_one("#q", Input).display = True
        self.placeholder("Recent: type to filter")
        self.fill(load_recent(), "Recent", True)

    def action_youtube(self):
        # Focus the list, not the box: Enter must pick a topic row. `/` (or Tab)
        # moves to the search box, which is also where typing goes once it has
        # focus.
        self.mode, self.game = "youtube", None
        self.query_one("#q", Input).display = True
        self.placeholder("YouTube: / to search · Enter on a topic")
        self.query_one("#q", Input).value = ""
        self.fill(youtube_topics(), "YouTube · pick a topic, or / to search", True)

    def placeholder(self, text):
        self.query_one("#q", Input).placeholder = text

    def action_focus_search(self):
        self.query_one("#q", Input).focus()

    def action_quality(self):
        self.height = HEIGHTS[1] if self.height == HEIGHTS[0] else HEIGHTS[0]
        self.set_status(f"quality {self.height}p")

    def action_refresh(self):
        {"twitch": self.action_twitch, "games": self.action_games,
         "recent": self.action_recent, "youtube": self.action_youtube,
         "start": self.action_start}.get(
            self.mode, self.action_twitch)()

    def action_back(self):
        if self.query_one("#q", Input).has_focus:
            self.query_one("#q", Input).value = ""
            self.apply_filter()
            self.query_one(ListView).focus()
        elif self.game:
            self.action_games()
        elif self.mode not in ("start",):
            self.action_start()
        else:
            self.query_one(ListView).focus()

    # ---- search: Enter in the box searches the current source ----------
    def on_input_submitted(self, event):
        needle = event.value.strip()
        if not needle:
            return
        if self.mode == "youtube":
            self.load(lambda: youtube_search(needle), f"YouTube · “{needle}”")
        else:
            self.load(lambda: twitch_search(needle), f"Twitch · channels “{needle}”")
        self.query_one("#q", Input).value = needle

    def on_input_changed(self, event):
        self.apply_filter()

    def on_list_view_selected(self, event):
        index = event.list_view.index
        if index is None or index >= len(self.items):
            return
        item = self.items[index]
        if item.get("kind") == "source":
            {"twitch": self.action_twitch, "youtube": self.action_youtube}[item["source"]]()
            return
        if item.get("kind") == "game":
            self.game = item["name"]
            self.load(lambda: twitch_streams(item["name"]), f"Twitch · {item['title']}")
            return
        if item.get("kind") == "topic":
            self.load(lambda: youtube_search(item["title"]), f"YouTube · {item['title']}")
            return
        self.play(item)

    def play(self, item):
        url = item["url"]
        self.set_status(f"playing {url}")
        self.remember(item)
        try:
            with self.suspend():                       # give the terminal to mpv
                subprocess.run(["goblin-watch", "--fs", url],
                               check=False,
                               env=dict(os.environ,
                                        GOBLIN_WATCH_MAX_HEIGHT=str(self.height)))
        except FileNotFoundError:
            self.set_status("goblin-watch is not installed")
        self.set_status(f"ready — Enter plays, {self.height}p")

    def remember(self, item):
        recent = [entry for entry in load_recent() if entry.get("url") != item["url"]]
        recent.insert(0, {key: item.get(key) for key in ("title", "meta", "url")})
        try:
            save_recent(recent)
        except OSError:
            pass


if __name__ == "__main__":
    Tv().run()
