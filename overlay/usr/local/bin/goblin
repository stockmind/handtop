#!/usr/bin/env python3
"""goblin — unified handheld TUI suite."""
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

from textual.app import App, ComposeResult
from textual.containers import Container, Vertical
from textual.widgets import Button, Footer, Header, Input, Label, ListView, ListItem, Static


def read_file(path, default="?"):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def meminfo():
    info = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, v = line.partition(":")
                info[k] = int(v.strip().split()[0])
    except (OSError, ValueError):
        return None
    total = info.get("MemTotal", 0)
    avail = info.get("MemAvailable", 0)
    if not total:
        return None
    used = total - avail
    return used / 1024.0, total / 1024.0, used / total


def cpu_load():
    try:
        with open("/proc/loadavg") as f:
            parts = f.read().split()
        return [float(x) for x in parts[:3]]
    except (OSError, ValueError):
        return None


def cpu_temp():
    import glob
    for zone in sorted(glob.glob("/sys/class/thermal/thermal_zone*/temp")):
        raw = read_file(zone)
        if raw != "?":
            try:
                return int(raw) / 1000.0
            except ValueError:
                pass
    return None


def battery_status():
    base = "/sys/class/power_supply"
    if not os.path.isdir(base):
        return None
    for psu in os.listdir(base):
        cap = read_file(f"{base}/{psu}/capacity")
        if cap == "?":
            continue
        status = read_file(f"{base}/{psu}/status", "?")
        try:
            return int(cap), status
        except ValueError:
            pass
    return None


def uptime_str():
    raw = read_file("/proc/uptime")
    if raw == "?":
        return "?"
    secs = float(raw.split()[0])
    d, rem = divmod(int(secs), 86400)
    h, rem = divmod(rem, 3600)
    m, _ = divmod(rem, 60)
    return (f"{d}d " if d else "") + f"{h}h {m:02d}m"


CSS = """
Screen { background: #1e1e2e; color: #cdd6f4; }
Header { background: #181825; color: #89b4fa; }
Footer { background: #181825; color: #a6adc8; }
#dashboard-panel { height: auto; padding: 1 2; margin: 0 1; background: #2a2a3e; border: solid #7f849c; }
#breadcrumb { height: 1; padding: 0 1; color: #89dceb; text-style: bold; }
#search-box { height: 3; padding: 0 1; }
#main-content { height: 1fr; padding: 0 1; }
ListView { height: auto; }
ListItem { height: 3; padding: 0; }
Button { width: 100%; height: 100%; background: #313244; color: #cdd6f4; border: solid #585b70; text-align: left; }
Button:hover { background: #45475a; border: solid #89b4fa; }
Button:focus { background: #45475a; border: solid #89dceb; }
Input { background: #2a2a3e; color: #cdd6f4; border: solid #585b70; }
Input:focus { border: solid #89dceb; }
"""


class DashboardPanel(Static):
    def on_mount(self):
        self.refresh_stats()
        self.set_interval(2.0, self.refresh_stats)
    
    def refresh_stats(self):
        load = cpu_load()
        temp = cpu_temp()
        mem = meminfo()
        bat = battery_status()
        
        lines = []
        if load:
            lines.append(f"[bold #89b4fa]Load[/]     {load[0]:.2f} {load[1]:.2f} {load[2]:.2f}")
        if temp is not None:
            lines.append(f"[bold #89b4fa]Temp[/]     {temp:.0f}°C")
        if mem:
            used, total, frac = mem
            bar_w = 16
            filled = int(round(frac * bar_w))
            bar = "█" * filled + "░" * (bar_w - filled)
            lines.append(f"[bold #89b4fa]Memory[/]   {bar} {used:.0f}/{total:.0f}M")
        if bat:
            cap, status = bat
            icon = "🔌" if "Charging" in status else "🔋"
            lines.append(f"[bold #89b4fa]Battery[/]  {icon} {cap}%")
        lines.append(f"[bold #89b4fa]Uptime[/]   {uptime_str()}")
        self.update("\n".join(lines))


class MediaItem(ListItem):
    def __init__(self, name, item_id, item_type, **kwargs):
        super().__init__(**kwargs)
        self.media_name = name      # Don't use .name (reserved by ListItem)
        self.item_id = item_id
        self.item_type = item_type
    
    def compose(self):
        icons = {"Collection": "📁", "Series": "📺", "Season": "🗓️", "Episode": "▶️", "Movie": "🎬"}
        icon = icons.get(self.item_type, "📄")
        yield Button(f"{icon} {self.media_name}", id=self.item_id, variant="default")


class GoblinApp(App):
    TITLE = "Goblin"
    CSS = CSS
    
    BINDINGS = [
        ("up", "cursor_up", "Up"), ("down", "cursor_down", "Down"),
        ("enter", "select", "Select"), ("escape", "back_or_quit", "Back"),
        ("q", "quit", "Quit"), ("d", "show_dashboard", "Dashboard"),
        ("p", "show_play", "Play"), ("m", "show_music", "Music"),
        ("r", "show_run", "Run"),
    ]
    
    def __init__(self, mode="menu"):
        super().__init__()
        self.mode = mode
        
        # Load config from /etc/default/goblin-dash if env vars not set
        if not os.environ.get("JELLYFIN_URL"):
            try:
                with open("/etc/default/goblin-dash") as f:
                    for line in f:
                        if line.startswith("DASH_JELLYFIN="):
                            val = line.split("=", 1)[1].strip().strip('"').strip("'")
                            os.environ["JELLYFIN_URL"] = val
                        elif line.startswith("DASH_API_KEY="):
                            val = line.split("=", 1)[1].strip().strip('"').strip("'")
                            os.environ["JELLYFIN_KEY"] = val
            except OSError:
                pass
        
        self.jellyfin_url = os.environ.get("JELLYFIN_URL", "").rstrip("/")
        self.api_key = os.environ.get("JELLYFIN_KEY", "")
        self.nav_stack = []
        self.current_parent_id = None
    
    def api_get(self, endpoint, params=None):
        url = f"{self.jellyfin_url}{endpoint}"
        if params:
            url += "?" + "&".join(params)
        req = urllib.request.Request(url, headers={
            "Authorization": f'MediaBrowser Token="{self.api_key}"'
        })
        try:
            with urllib.request.urlopen(req, timeout=8) as r:
                return json.load(r)
        except Exception as e:
            self.notify(f"API error: {e}", severity="error")
            return None
    
    def compose(self):
        yield Header(show_clock=True)
        with Vertical():
            yield DashboardPanel(id="dashboard-panel")
            yield Label("", id="breadcrumb")
            yield Input(placeholder="Search...", id="search-box")
            with Container(id="main-content"):
                yield ListView(id="items-view")
        yield Footer()
    
    async def on_mount(self):
        if self.mode == "play":
            await self.show_libraries()
        elif self.mode == "dashboard":
            await self.show_dashboard()
        else:
            await self.show_menu()
    
    async def show_menu(self):
        self.mode = "menu"
        self.query_one("#breadcrumb", Label).update("")
        self.query_one("#search-box", Input).display = False
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        for label, key in [("Dashboard", "d"), ("Play Media", "p"), 
                           ("Music", "m"), ("Run App", "r"), ("Quit", "q")]:
            btn = Button(label, id=key, variant="default")
            await list_view.append(ListItem(btn))
    
    async def show_dashboard(self):
        self.mode = "dashboard"
        self.query_one("#breadcrumb", Label).update("📊 Dashboard")
        self.query_one("#search-box", Input).display = False
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        stats = [
            ("CPU Load", f"{cpu_load()[0]:.2f}" if cpu_load() else "?"),
            ("Temperature", f"{cpu_temp():.0f}°C" if cpu_temp() else "?"),
            ("Memory", f"{meminfo()[0]:.0f}/{meminfo()[1]:.0f}M" if meminfo() else "?"),
            ("Battery", f"{battery_status()[0]}%" if battery_status() else "?"),
            ("Uptime", uptime_str()),
        ]
        
        for label, value in stats:
            btn_id = label.lower().replace(" ", "-")
            btn = Button(f"{label}: {value}", id=btn_id, variant="default")
            await list_view.append(ListItem(btn))
    
    async def show_libraries(self):
        self.mode = "play"
        self.current_parent_id = None
        self.nav_stack = []
        
        self.query_one("#breadcrumb", Label).update("🏠 Home")
        self.query_one("#search-box", Input).display = True
        
        data = self.api_get("/Library/VirtualFolders?format=json")
        libs = data if isinstance(data, list) else []
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        for lib in libs:
            name = lib.get("Name", "?")
            item_id = lib.get("ItemId", "") or lib.get("Id", "")  # VirtualFolders uses ItemId
            if item_id:
                await list_view.append(MediaItem(name, item_id, "Collection"))
        
        if not libs:
            self.notify("No libraries found", severity="warning")
    
    async def show_items(self, parent_id, parent_name, item_types=None):
        self.current_parent_id = parent_id
        
        parts = ["🏠 Home"]
        for _, name in self.nav_stack[-2:]:
            parts.append(name)
        parts.append(parent_name)
        self.query_one("#breadcrumb", Label).update(" › ".join(parts))
        
        params = ["Recursive=false", "format=json", "Limit=200", f"ParentId={parent_id}"]
        if item_types:
            params.append(f"IncludeItemTypes={','.join(item_types)}")
        
        data = self.api_get("/Items", params)
        items = data.get("Items", []) if data else []
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        for item in items[:100]:
            name = item.get("Name", "?")
            item_id = item.get("Id", "")
            item_type = item.get("Type", "Folder")
            if item_id:
                await list_view.append(MediaItem(name, item_id, item_type))
    
    async def show_seasons(self, series_id, series_name):
        self.nav_stack.append((series_id, series_name))
        self.current_parent_id = series_id
        
        parts = ["🏠 Home"]
        for _, name in self.nav_stack[-2:]:
            parts.append(name)
        self.query_one("#breadcrumb", Label).update(" › ".join(parts))
        
        data = self.api_get("/Items", 
                           ["Recursive=false", "format=json", f"ParentId={series_id}",
                            "IncludeItemTypes=Season"])
        seasons = data.get("Items", []) if data else []
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        for season in seasons:
            name = season.get("Name", "?")
            item_id = season.get("Id", "")
            if item_id:
                await list_view.append(MediaItem(name, item_id, "Season"))
    
    async def show_episodes(self, season_id, season_name):
        self.nav_stack.append((season_id, season_name))
        self.current_parent_id = season_id
        
        parts = ["🏠 Home"]
        for _, name in self.nav_stack[-2:]:
            parts.append(name)
        self.query_one("#breadcrumb", Label).update(" › ".join(parts))
        
        data = self.api_get("/Items",
                           ["Recursive=false", "format=json", f"ParentId={season_id}",
                            "IncludeItemTypes=Episode"])
        episodes = data.get("Items", []) if data else []
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        for ep in episodes:
            name = ep.get("Name", "?")
            item_id = ep.get("Id", "")
            if item_id:
                await list_view.append(MediaItem(name, item_id, "Episode"))
    
    def on_input_changed(self, event):
        search = event.value.lower()
        list_view = self.query_one("#items-view", ListView)
        for child in list_view.children:
            if isinstance(child, MediaItem):
                child.display = search in child.media_name.lower()
    
    async def on_button_pressed(self, event):
        btn = event.button
        item_id = btn.id
        
        if self.mode == "menu":
            if item_id == "d":
                await self.show_dashboard()
            elif item_id == "p":
                await self.show_libraries()
            elif item_id == "m":
                self.notify("Music player coming soon!")
            elif item_id == "r":
                self.exit("RUN_APP")
            elif item_id == "q":
                self.exit()
            return
        
        if self.mode == "play":
            media_item = btn.parent
            while media_item and not isinstance(media_item, MediaItem):
                media_item = media_item.parent
            
            if not media_item:
                return
            
            item_type = media_item.item_type
            item_name = media_item.media_name
            
            if item_type == "Collection":
                self.nav_stack.append((item_id, item_name))
                await self.show_items(item_id, item_name, ["Movie", "Series"])
            elif item_type == "Series":
                await self.show_seasons(item_id, item_name)
            elif item_type == "Season":
                await self.show_episodes(item_id, item_name)
            elif item_type in ("Episode", "Movie"):
                stream_url = f"{self.jellyfin_url}/Videos/{item_id}/stream"
                stream_url += f"?api_key={self.api_key}&MaxStreamingBitrate=40000000"
                self.exit(stream_url)
    
    def action_back_or_quit(self):
        import asyncio
        if self.mode == "play":
            if len(self.nav_stack) >= 2:
                self.nav_stack.pop()
                parent_id, parent_name = self.nav_stack[-1]
                asyncio.run_coroutine_threadsafe(
                    self.show_seasons(parent_id, parent_name), self._loop
                )
            elif len(self.nav_stack) == 1:
                self.nav_stack.pop()
                asyncio.run_coroutine_threadsafe(
                    self.show_libraries(), self._loop
                )
            else:
                asyncio.run_coroutine_threadsafe(
                    self.show_menu(), self._loop
                )
        else:
            self.exit()


if __name__ == "__main__":
    import asyncio
    
    mode = sys.argv[1] if len(sys.argv) > 1 else "menu"
    app = GoblinApp(mode)
    result = app.run()
    
    if result == "RUN_APP":
        subprocess.run(["goblin-run"])
    elif result:
        cmd = ["mpv", "--force-window=yes", "--idle=no", result]
        subprocess.run(cmd)
