Button:hover { background: #45475a; border: solid #89b4fa; }
Button:focus { background: #45475a; border: solid #89dceb; }
Input { background: #2a2a3e; color: #cdd6f4; border: solid #585b70; }
Input:focus { border: solid #89dceb; }
"""


class DashboardPanel(Static):
    def on_mount(self):
        self.refresh_stats()
        self.set_interval(2.0, self.refresh_stats)
    
    def refresh_stats(self):
        load = cpu_load()
        temp = cpu_temp()
        mem = meminfo()
        bat = battery_status()
        
        lines = []
        if load:
            lines.append(f"[bold #89b4fa]Load[/]     {load[0]:.2f} {load[1]:.2f} {load[2]:.2f}")
        if temp is not None:
            lines.append(f"[bold #89b4fa]Temp[/]     {temp:.0f}°C")
        if mem:
            used, total, frac = mem
            bar_w = 16
            filled = int(round(frac * bar_w))
            bar = "█" * filled + "░" * (bar_w - filled)
            lines.append(f"[bold #89b4fa]Memory[/]   {bar} {used:.0f}/{total:.0f}M")
        if bat:
            cap, status = bat
            icon = "🔌" if "Charging" in status else "🔋"
            lines.append(f"[bold #89b4fa]Battery[/]  {icon} {cap}%")
        lines.append(f"[bold #89b4fa]Uptime[/]   {uptime_str()}")
        self.update("\n".join(lines))


PLAYABLE_TYPES = {"Episode", "Movie", "MusicVideo", "Video", "Audio"}

# Offline copies live here (SD card root, NOT /tmp which is 128 MB tmpfs).
OFFLINE_DIR = Path(os.environ.get("GOBLIN_OFFLINE_DIR", str(Path.home() / "Offline")))


def safe_name(s):
    return re.sub(r"[^A-Za-z0-9._ -]+", "_", s).strip()[:60] or "media"


def offline_size():
    """Total bytes of local copies + free space, for the Home line."""
    try:
        used = sum(f.stat().st_size for f in OFFLINE_DIR.glob("*") if f.is_file())
    except OSError:
        used = 0
    try:
        free = shutil.disk_usage(str(OFFLINE_DIR.parent) if OFFLINE_DIR.parent.exists()
                                 else str(OFFLINE_DIR)).free
    except OSError:
        free = 0
    def hum(b):
        return f"{b/1e9:.1f}G" if b >= 1e9 else f"{int(b/1e6)}M"
    return hum(used), hum(free)


def load_manifest():
    """item_id -> [filenames under OFFLINE_DIR]; written by the download action."""
    try:
        return json.loads((OFFLINE_DIR / "manifest.json").read_text())
    except (OSError, ValueError):
        return {}


def save_manifest(m):
    OFFLINE_DIR.mkdir(parents=True, exist_ok=True)
    (OFFLINE_DIR / "manifest.json").write_text(json.dumps(m))


# Jellyfin virtual folders map to the item types their children have; without
# this a MusicVideos library lists nothing (its children are MusicVideo).
# Music libraries are listed flat (all tracks, like a giant playlist): artists
# and albums would need three browse levels for zero benefit on 640x480.
COLLECTION_TYPES = {
    "movies": ["Movie"],
    "tvshows": ["Series"],
    "musicvideos": ["MusicVideo"],
    "music": ["Audio"],
}


class MediaItem(ListItem):
    def __init__(self, name, item_id, item_type, collection_type=None, index_number=None,
                 container=None, offline=False, file_size=None, video_height=None, **kwargs):
        super().__init__(**kwargs)
        self.media_name = name      # Don't use .name (reserved by ListItem)
        self.item_id = item_id
        self.item_type = item_type
        self.collection_type = collection_type
        self.index_number = index_number   # Season number, for the Episodes fallback
        self.container = container         # for the Download naming
        self.offline = offline             # already stored on device -> show ✓
        self.file_size = file_size         # bytes, for the transcode decision
        self.video_height = video_height

    def compose(self):
        icons = {"Collection": "📁", "Series": "📺", "Season": "🗓️", "Episode": "▶️",
                 "Movie": "🎬", "MusicVideo": "🎵", "Audio": "🎧", "Video": "🎞️"}
        icon = icons.get(self.item_type, "📄")
        mark = " ✓" if self.offline else ""
        # Jellyfin ids are hex and often start with a digit; Textual ids must
        # not (BadIdentifier otherwise). The real id lives in self.item_id,
        # which is what all handlers read. Text() so names with [brackets]
        # are not parsed as markup.
        yield Label(Text(f"{icon} {self.media_name}{mark}"))


class LoadMoreItem(ListItem):
    """Sentinel row: the only pagination we need (libraries rarely overflow)."""

    def __init__(self, remaining, **kwargs):
        super().__init__(**kwargs)
        self.remaining = remaining

    def compose(self):
        yield Label(f"⬇ …and {self.remaining} more")


class RowItem(ListItem):
    """Menu/dashboard row: plain Label like MediaItem (cheap), carries a key."""

    def __init__(self, label, key=None, **kwargs):
        super().__init__(**kwargs)
        self.row_label = label
        self.key = key

    def compose(self):
        yield Label(Text(self.row_label))


class GoblinApp(App):
    TITLE = "Goblin"
    CSS = CSS
    
    
    BINDINGS = [
        # up/down/enter/space are handled natively by ListView and its focused
        # Button; app-level duplicates here had no matching actions.
        ("escape", "back_or_quit", "Back"),
        ("q", "quit", "Quit"), ("d", "show_dashboard", "Dashboard"),
        ("p", "show_play", "Play"), ("m", "show_music", "Music"),
        ("r", "show_run", "Run"),
        ("s", "shuffle_play", "Shuffle"), ("f", "download_item", "Save"),
        ("x", "remove_item", "Remove"),
    ]
    
    def __init__(self, mode="menu", resume=None):
        super().__init__()
        self.mode = mode
        # Navigation snapshot from a previous play session (see _capture_nav):
        # {"stack": [(id,name,types)...], "index": n, "search": q} -> reopen there.
        self.resume = resume
        self.play_state = None
        
        # Config was seeded from /etc/default/goblin-dash at import time.
        
        self.jellyfin_url = os.environ.get("JELLYFIN_URL", "").rstrip("/")
        self.api_key = os.environ.get("JELLYFIN_KEY", "")
        self.nav_stack = []
        self.current_parent_id = None
        self.last_show = None      # (parent_id, name, child_types, episodes_of)
        self.index_memory = {}     # parent_id -> cursor row, restored on Back
        self._search_timer = None
        self.applied_search = ""   # what the current list was fetched with
        self.page_offset = 0       # items loaded for the current view (Load-more)
        self.page_total = 0
    
    def api_get(self, endpoint, params=None):
        url = f"{self.jellyfin_url}{endpoint}"
        if params:
            url += "?" + "&".join(params)
        req = urllib.request.Request(url, headers={
            "Authorization": f'MediaBrowser Token="{self.api_key}"'
        })
        try:
            with urllib.request.urlopen(req, timeout=8) as r:
                return json.load(r)
        except Exception as e:
            self.notify(f"API error: {e}", severity="error")
            return None
    
    def compose(self):
        yield Header(show_clock=True)
        with Vertical():
            yield DashboardPanel(id="dashboard-panel")
            yield Label("", id="breadcrumb")
            yield Input(placeholder="Search...", id="search-box")
            with Container(id="main-content"):
                yield ListView(id="items-view")
            with Horizontal(id="action-bar"):
                yield Button("▶ Play (⏎)", id="btn-play", variant="primary")
                yield Button("🔀 Shuffle (s)", id="btn-shuffle", variant="default")
                yield Button("⬇ Save (f)", id="btn-dl", variant="default")
                yield Button("🗑 Remove (x)", id="btn-rm", variant="default")
        yield Footer()
    
    async def on_mount(self):
        if self.mode == "play":
            await self.show_libraries()
            if self.resume:
                await self._resume_into(self.resume)
        elif self.mode == "dashboard":
            await self.show_dashboard()
        else:
            await self.show_menu()

    def _capture_nav(self):
        """Snapshot where we are so a relaunch after mpv can reopen here."""
        try:
            lv = self.query_one("#items-view", ListView)
            index = lv.index or 0
        except Exception:
            index = 0
        self.play_state = {"stack": [tuple(e) for e in self.nav_stack],
                           "index": index, "search": self.applied_search}

    async def _resume_into(self, st):
        stack = st.get("stack") or []
        for i, entry in enumerate(stack):
            pid, name, types = entry[0], entry[1], entry[2]
            last = i == len(stack) - 1
            await self.show_children(pid, name, types,
                                     search=(st.get("search") or "") if last else "")
        if not stack:
            return
        box = self.query_one("#search-box", Input)
        if st.get("search"):
            box.value = st["search"]
        lv = self.query_one("#items-view", ListView)
        n = sum(1 for c in lv.children if isinstance(c, (MediaItem, LoadMoreItem)))
        lv.index = min(st.get("index") or 0, max(n - 1, 0))
        lv.focus()
    
    async def show_menu(self):
        self.mode = "menu"
        self.query_one("#breadcrumb", Label).update("")
        self.query_one("#search-box", Input).display = False
        self.query_one("#action-bar").display = False
        self.query_one("#dashboard-panel").display = True
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        for label, key in [("📊 Dashboard", "d"), ("▶️ Play Media", "p"),
                           ("🎵 Music", "m"), ("🚀 Run App", "r"), ("⏻ Quit", "q")]:
            await list_view.append(RowItem(label, key))
        list_view.index = 0
        list_view.focus()
    
    async def show_dashboard(self):
        self.mode = "dashboard"
        self.query_one("#breadcrumb", Label).update("📊 Dashboard")
        self.query_one("#search-box", Input).display = False
        self.query_one("#action-bar").display = False
        self.query_one("#dashboard-panel").display = True
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        stats = [
            ("CPU Load", f"{cpu_load()[0]:.2f}" if cpu_load() else "?"),
            ("Temperature", f"{cpu_temp():.0f}°C" if cpu_temp() else "?"),
            ("Memory", f"{meminfo()[0]:.0f}/{meminfo()[1]:.0f}M" if meminfo() else "?"),
            ("Battery", f"{battery_status()[0]}%" if battery_status() else "?"),
            ("Uptime", uptime_str()),
        ]
        
        for label, value in stats:
            await list_view.append(RowItem(f"{label}: {value}"))
        list_view.index = 0
        list_view.focus()
    
    async def show_libraries(self):
        self.mode = "play"
        self.current_parent_id = None
        self.nav_stack = []
        
        used, free = offline_size()
        self.query_one("#breadcrumb", Label).update(f"🏠 Home   ·   {used} saved · {free} free")
        self.query_one("#search-box", Input).display = True
        self.query_one("#action-bar").display = True
        # The 480-px screen belongs to the list: stats only live in menu/dashboard.
        self.query_one("#dashboard-panel").display = False
        
        data = self.api_get("/Library/VirtualFolders?format=json")
        libs = data if isinstance(data, list) else []
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        for lib in libs:
            name = lib.get("Name", "?")
            item_id = lib.get("ItemId", "") or lib.get("Id", "")  # VirtualFolders uses ItemId
            if item_id:
                await list_view.append(MediaItem(name, item_id, "Collection",
                                                 collection_type=lib.get("CollectionType")))
        
        if not libs:
            self.notify("No libraries found", severity="warning")
        list_view.index = 0    # otherwise the search box steals the dpad at start
        list_view.focus()
    
    async def show_children(self, parent_id, parent_name, item_types, episodes_of=None,
                            search=""):
        """List children of parent_id; one code path for libraries, series and seasons.

        episodes_of=(series_id, season_number) enables the Episodes fallback:
        on Jellyfin 12 some season nodes hold no children (episodes stay
        parented to the series), and /Shows/{id}/Episodes?Season=N finds them.
        search goes server-side (SearchTerm): libraries hold far more items
        than we ever load, so filtering the loaded page alone hides most of them.
        """
        # remember where the cursor was before replacing this list (Back restores)
        lv_old = self.query_one("#items-view", ListView)
        if self.current_parent_id is not None and lv_old.children:
            self.index_memory[self.current_parent_id] = lv_old.index
        
        self.current_parent_id = parent_id
        self.last_show = (parent_id, parent_name, item_types, episodes_of)
        
        parts = ["🏠 Home"] + [name for _, name, _ in self.nav_stack[-2:]] + [parent_name]
        crumb = " › ".join(parts)
        
        # Recursive=true: ParentId+Recursive=false returns zero Episodes under
        # a season on this server family (measured on Jellyfin 12.2/aurora).
        # ponytail: hard page of 200, no Load-more row — server-side SearchTerm
        # covers reach into big libraries; add pagination if anyone really
        # dpads past item 200.
        params = ["Recursive=true", "format=json", "Limit=200", f"ParentId={parent_id}",
                  "Fields=Width,Height"]
        if item_types:
            params.append(f"IncludeItemTypes={','.join(item_types)}")
        if search:
            params.append(f"SearchTerm={urllib.parse.quote(search)}")
        
        data = self.api_get("/Items", params)
        items = data.get("Items", []) if data else []
        total = data.get("TotalRecordCount", len(items)) if data else 0
        if not items and episodes_of and not search:
            series_id, season_no = episodes_of
            data = self.api_get(f"/Shows/{series_id}/Episodes",
                                [f"Season={season_no}", "format=json"])
            items = data.get("Items", []) if data else []
            total = data.get("TotalRecordCount", len(items)) if data else total
        
        list_view = self.query_one("#items-view", ListView)
        await list_view.clear()
        
        await self._add_media_items(items)
        if not items:
            self.notify("No items", severity="warning")
        self.page_offset = len(items)
        self.page_total = total
        if total > len(items):
            await list_view.append(LoadMoreItem(total - len(items)))
        self.query_one("#breadcrumb", Label).update(Text(crumb))
        # restore the cursor where it was (or row 0); Enter/gamepad-A works at once
        idx = self.index_memory.get(parent_id)
        list_view.index = idx if idx is not None and idx < len(items) else 0
        list_view.focus()
        self.applied_search = search
    
    async def _add_media_items(self, items):
        manifest = load_manifest()
        lv = self.query_one("#items-view", ListView)
        for item in items:
            item_id = item.get("Id", "")
            if item_id:
                files = manifest.get(item_id, [])
                offline = bool(files) and (OFFLINE_DIR / files[0]).exists()
                await lv.append(MediaItem(item.get("Name", "?"), item_id,
                                          item.get("Type", "Folder"),
                                          index_number=item.get("IndexNumber"),
                                          container=item.get("Container"),
                                          offline=offline,
                                          file_size=item.get("FileSize"),
                                          video_height=item.get("Height")))
    
    async def _load_more(self):
        """Append the next page under the sentinel (see Limit note above)."""
        pid, name, types, epi = self.last_show
        params = ["Recursive=true", "format=json", "Limit=200", f"ParentId={pid}",
                  "Fields=Width,Height", f"StartIndex={self.page_offset}"]
        if types:
            params.append(f"IncludeItemTypes={','.join(types)}")
        if self.applied_search:
            params.append(f"SearchTerm={urllib.parse.quote(self.applied_search)}")
        data = self.api_get("/Items", params)
        new = data.get("Items", []) if data else []
        lv = self.query_one("#items-view", ListView)
        await lv.query_one(LoadMoreItem).remove()
        await self._add_media_items(new)
        self.page_offset += len(new)
        left = self.page_total - self.page_offset
        if left > 0:
            await lv.append(LoadMoreItem(left))
        lv.focus()
    
    def on_input_changed(self, event):
        if self.mode != "play":
            return
        # Debounce: typing fires per keystroke; each search is an API call.
        if self._search_timer:
            self._search_timer.stop()
        self._search_timer = self.set_timer(0.35, self._apply_search)

    async def _apply_search(self):
        box = self.query_one("#search-box", Input)
        q = box.value.strip()
        if self.current_parent_id is None:
            # Home: few libraries, filter client-side
            lv = self.query_one("#items-view", ListView)
            for child in lv.children:
                if isinstance(child, MediaItem):
                    child.display = q.lower() in child.media_name.lower()
            return
        if q == self.applied_search:
            return
        pid, name, types, epi = self.last_show
        await self.show_children(pid, name, types, episodes_of=epi, search=q)
    
    async def _activate(self, child):
        """Single activation path for mouse clicks AND keyboard/gamepad Enter."""
        if child is None:
            return
        
        if isinstance(child, LoadMoreItem):
            await self._load_more()
            return
        
        if self.mode == "menu":
            btn_id = getattr(child, "key", None)
            if btn_id == "d":
                await self.show_dashboard()
            elif btn_id == "p":
                await self.show_libraries()
            elif btn_id == "m":
                self.notify("Music lives in Jellyfin — Play Media → Music 🎧")
            elif btn_id == "r":
                self.exit("RUN_APP")
            elif btn_id == "q":
                self.exit()
            return
        
        if self.mode == "play":
            media_item = child if isinstance(child, MediaItem) else None
            if media_item is None:
                node = child
                while node and not isinstance(node, MediaItem):
                    node = node.parent
                media_item = node
            if media_item is None:
                return
            
            item_id = media_item.item_id
            item_name = media_item.media_name
            item_type = media_item.item_type
            
            # The stack stores what to re-show on Back: (id, name, child-types).
            if item_type in ("Collection", "Series", "Season"):
                self.query_one("#search-box", Input).value = ""   # filter was for this level
            if item_type == "Collection":
                child_types = COLLECTION_TYPES.get(media_item.collection_type,
                                                   ["Movie", "Series"])
                self.nav_stack.append((item_id, item_name, child_types))
                await self.show_children(item_id, item_name, child_types)
            elif item_type == "Series":
                self.nav_stack.append((item_id, item_name, ["Season"]))
                await self.show_children(item_id, item_name, ["Season"])
            elif item_type == "Season":
                self.nav_stack.append((item_id, item_name, ["Episode"]))
                series = self.nav_stack[-2] if len(self.nav_stack) >= 2 else None
                epi = ((series[0], media_item.index_number)
                       if series and media_item.index_number is not None else None)
                await self.show_children(item_id, item_name, ["Episode"], episodes_of=epi)
            elif item_type in PLAYABLE_TYPES:
                await self._play_from(media_item)

    def _visible_playables(self):
        """MediaItems currently shown (search filter applied), in list order."""
        lv = self.query_one("#items-view", ListView)
        return [c for c in lv.children
                if isinstance(c, MediaItem) and c.display and c.item_type in PLAYABLE_TYPES]

    def _resolve_url(self, m):
        """Local copy when we have one, stream otherwise."""
        files = load_manifest().get(m.item_id, [])
        if files and (OFFLINE_DIR / files[0]).exists():
            return str(OFFLINE_DIR / files[0])
        if self.STREAM_TRANSCODE:
            return self._transcode_url(m.item_id)
        url = f"{self.jellyfin_url}/Videos/{m.item_id}/stream"
        return url + f"?api_key={self.api_key}&MaxStreamingBitrate=40000000"

    async def _play_from(self, mi, shuffle=False):
        """Exit with the whole filtered playlist; ordered starts at the cursor."""
        items = self._visible_playables()
        urls = [self._resolve_url(m) for m in items]
        if not urls:
            urls = [self._resolve_url(mi)]
        start = items.index(mi) if mi in items else 0
        if not shuffle:
            urls = urls[start:] + urls[:start]
        self._capture_nav()
        self.exit(("PL", urls, shuffle))

    async def action_shuffle_play(self):
        if self.mode != "play":
            return
        mi = self._highlighted_media() or None
        items = self._visible_playables()
        if not items:
            self.notify("Nothing to play", severity="warning")
            return
        urls = [self._resolve_url(m) for m in items]
        self._capture_nav()
        self.exit(("PL", urls, True))

    async def on_list_view_selected(self, event):
        await self._activate(event.item)

    async def on_button_pressed(self, event):
        bid = event.button.id
        if bid == "btn-play":
            mi = self._highlighted_media()
            if mi is not None and mi.item_type in PLAYABLE_TYPES:
                await self._play_from(mi)
            elif mi is not None:
                await self._activate(mi)
            return
        if bid == "btn-shuffle":
            await self.action_shuffle_play()
            return
        if bid == "btn-dl":
            await self.action_download_item()
            return
        if bid == "btn-rm":
            self.action_remove_item()
            return

    def _highlighted_media(self):
        lv = self.query_one("#items-view", ListView)
        child = lv.highlighted_child
        return child if isinstance(child, MediaItem) else None

    # Transcoding ON by default both ways (aurora transcodes ~16x realtime vs
    # ~6 MB/s Wi-Fi, so a server-side 720p mp4 lands faster than the original
    # AND plays guaranteed-hardware in mpv). Opt out per direction with
    # GOBLIN_DL_TRANSCODE=0 / GOBLIN_STREAM_TRANSCODE=0. Downloads only
    # transcode originals bigger than this or taller than the panel anyway;
    # streaming always asks for <=720p (Jellyfin direct-remuxes when it can).
    DL_TRANSCODE = os.environ.get("GOBLIN_DL_TRANSCODE", "1") == "1"
    STREAM_TRANSCODE = os.environ.get("GOBLIN_STREAM_TRANSCODE", "1") == "1"
    DL_TRANSCODE_ABOVE = int(os.environ.get("GOBLIN_DL_TRANSCODE_MB", "1024")) * 1024 * 1024
    DL_TRANSCODE_HEIGHT = int(os.environ.get("GOBLIN_DL_TRANSCODE_HEIGHT", "720"))

    def _transcode_url(self, iid):
        return (f"{self.jellyfin_url}/Videos/{iid}/stream"
                f"?Container=mp4&VideoCodec=h264&AudioCodec=aac"
                f"&MaxWidth=1280&MaxHeight=720&api_key={self.api_key}")

    def _dl_choice(self, file_size, video_height):
        """(kind, ext) for one item: direct original vs server-transcoded 720p."""
        if not self.DL_TRANSCODE:
            return "direct", None
        big = (file_size or 0) > self.DL_TRANSCODE_ABOVE
        tall = (video_height or 0) > self.DL_TRANSCODE_HEIGHT
        if big or tall:
            return "transcode", "mp4"
        return "direct", None

    def _download_targets(self, mi):
        """[(item_id, filename)] for a playable item, or all episodes for a Series."""
        def fname(iid, name, container, force_ext=None):
            ext = force_ext or (container or "mp4").split(",")[0]
            return f"{safe_name(name)}.{ext}"

        if mi.item_type == "Series":
            data = self.api_get("/Items", ["Recursive=true", "format=json", "Limit=500",
                                           f"ParentId={mi.item_id}",
                                           "IncludeItemTypes=Episode",
                                           "Fields=Width,Height"])
            eps = data.get("Items", []) if data else []
            out = []
            for ep in eps:
                if not ep.get("Id"):
                    continue
                kind, ext = self._dl_choice(ep.get("FileSize"), ep.get("Height"))
                out.append((ep["Id"], fname(ep["Id"], f"{mi.media_name} - {ep.get('Name', 'ep')}",
                                            ep.get("Container"), ext), kind))
            return out
        if mi.item_type in PLAYABLE_TYPES:
            kind, ext = self._dl_choice(mi.file_size, mi.video_height)
            return [(mi.item_id, fname(mi.item_id, mi.media_name, mi.container, ext), kind)]
        return []

    def _do_download(self, top_id, todo):
        """Runs in a worker thread: direct copies or server-transcoded 720p mp4s."""
        OFFLINE_DIR.mkdir(parents=True, exist_ok=True)   # worker runs before save_manifest
        manifest = load_manifest()
        done = skipped = 0
        errors = []
        for iid, fn, kind in todo:
            dest = OFFLINE_DIR / fn
            if dest.exists() and dest.stat().st_size > 0:
                skipped += 1
                manifest[iid] = [fn]
                continue
            tmp = dest.with_suffix(dest.suffix + ".part")
            try:
                if kind == "transcode":
                    url = self._transcode_url(iid)
                else:
                    url = f"{self.jellyfin_url}/Items/{iid}/Download"
                req = urllib.request.Request(
                    url, headers={"Authorization": f'MediaBrowser Token="{self.api_key}"'})
                with urllib.request.urlopen(req, timeout=600) as r, open(tmp, "wb") as fh:
                    shutil.copyfileobj(r, fh)
                os.replace(tmp, dest)
                manifest[iid] = [fn]
                done += 1
            except Exception as e:
                errors.append(f"{fn}: {e}")
                tmp.unlink(missing_ok=True)     # no orphaned partials eating the SD card
        manifest[top_id] = [fn for _, fn, _ in todo]   # whole-series bookkeeping
        save_manifest(manifest)
        return done, skipped, errors

    async def action_download_item(self):
        if self.mode != "play":
            return
        mi = self._highlighted_media()
        if mi is None:
            self.notify("Nothing selected", severity="warning")
            return
        todo = self._download_targets(mi)
        if not todo:
            self.notify(f"Not downloadable ({mi.item_type})", severity="warning")
            return
        # SD card is small (~5 GB free): refuse up-front when it clearly won't fit.
        free = shutil.disk_usage(str(OFFLINE_DIR.parent) if OFFLINE_DIR.parent.exists()
                                 else str(OFFLINE_DIR)).free
        need = max(mi.file_size or 0, 300 * 1024 * 1024)   # unknown size -> 300 MB floor
        if free < need:
            self.notify(f"Only {free // 1024 // 1024} MB free — won't fit", severity="error")
            return
        n_tc = sum(1 for _, _, k in todo if k == "transcode")
        self.notify(f"Downloading {len(todo)} file(s)" +
                    (f", {n_tc} transcoded" if n_tc else "") + "…")
        # run_worker(thread=True)+wait(): works on Debian's textual 2.1.2 and newer
        worker = self.run_worker(lambda: self._do_download(mi.item_id, todo),
                                 group="dl", exclusive=True, thread=True)
        await worker.wait()
        done, skipped, errors = worker.result
        if errors:
            self.notify(f"Saved {done}, errors: {errors[0]}", severity="error")
        else:
            self.notify(f"Saved to device ✓ ({done} new, {skipped} already there)")
        await self.show_children(*self.last_show[:3], episodes_of=self.last_show[3])

    def action_remove_item(self):
        if self.mode != "play":
            return
        mi = self._highlighted_media()
        if mi is None:
            return
        manifest = load_manifest()
        files = manifest.pop(mi.item_id, [])
        if not files:
            self.notify("Not stored on device", severity="warning")
            return
        remaining = set()
        for v in manifest.values():
            remaining.update(v)
        removed = 0
        for fn in files:
            if fn in remaining:          # still referenced by another entry
                continue
            try:
                (OFFLINE_DIR / fn).unlink()
                removed += 1
            except OSError:
                pass
        save_manifest(manifest)
        self.notify(f"Removed {removed} file(s) from device")
    
    async def action_back_or_quit(self):
        if self.mode == "play":
            box = self.query_one("#search-box", Input)
            if box.value:                       # Back first clears the filter
                box.value = ""
                return
            if self.nav_stack:
                self.nav_stack.pop()
            if self.nav_stack:
                parent_id, parent_name, child_types = self.nav_stack[-1]
                await self.show_children(parent_id, parent_name, child_types)
            elif self.current_parent_id is not None:
                await self.show_libraries()   # Back from a library -> Home
            else:
                await self.show_menu()        # Back from Home -> menu
        else:
            self.exit()


if __name__ == "__main__":
    import asyncio
    
    mode = sys.argv[1] if len(sys.argv) > 1 else "menu"
    resume = None
    while True:
        app = GoblinApp(mode, resume=resume)
        result = app.run()

        if isinstance(result, tuple) and result and result[0] == "PL":
            # ("PL", [urls], shuffle) — play the filtered list; mpv --shuffle randomizes it.
            _, urls, shuffle = result
            cmd = ["mpv", "--force-window=yes", "--idle=no"] + (["--shuffle"] if shuffle else []) + urls
            subprocess.run(cmd)
            # Back where we left off, not back to square one: reopen the media
            # browser at the same folder/cursor so something else can be queued.
            mode, resume = "play", app.play_state
            continue
        if result == "RUN_APP":
            subprocess.run(["goblin-run"])
            mode, resume = "menu", None
            continue
        if result:                        # legacy single-url exit
            subprocess.run(["mpv", "--force-window=yes", "--idle=no", result])
            mode, resume = "play", app.play_state
            continue
        break                             # plain quit
