#!/usr/bin/env python3
"""goblin — unified handheld TUI suite."""
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

from rich.text import Text
from textual.app import App, ComposeResult
from textual.containers import Container, Horizontal, Vertical
from textual.widgets import Button, Footer, Header, Input, Label, ListView, ListItem, Static


def _load_default_config():
    """Seed env from /etc/default/goblin-dash: DASH_JELLYFIN/DASH_API_KEY map to
    JELLYFIN_URL/JELLYFIN_KEY; any GOBLIN_* line passes through. Runs at import
    so class-body defaults (DL_TRANSCODE etc.) see it."""
    try:
        with open("/etc/default/goblin-dash") as f:
            for line in f:
                if "=" not in line or line.lstrip().startswith("#"):
                    continue
                key, val = line.split("=", 1)
                val = val.split("#")[0].strip().strip('"').strip("'")
                key = key.strip()
                if key == "DASH_JELLYFIN":
                    os.environ.setdefault("JELLYFIN_URL", val)
                elif key == "DASH_API_KEY":
                    os.environ.setdefault("JELLYFIN_KEY", val)
                elif key.startswith("GOBLIN_"):
                    os.environ.setdefault(key, val)
    except OSError:
        pass


_load_default_config()


def read_file(path, default="?"):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def meminfo():
    info = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, v = line.partition(":")
                info[k] = int(v.strip().split()[0])
    except (OSError, ValueError):
        return None
    total = info.get("MemTotal", 0)
    avail = info.get("MemAvailable", 0)
    if not total:
        return None
    used = total - avail
    return used / 1024.0, total / 1024.0, used / total


def cpu_load():
    try:
        with open("/proc/loadavg") as f:
            parts = f.read().split()
        return [float(x) for x in parts[:3]]
    except (OSError, ValueError):
        return None


def cpu_temp():
    import glob
    for zone in sorted(glob.glob("/sys/class/thermal/thermal_zone*/temp")):
        raw = read_file(zone)
        if raw != "?":
            try:
                return int(raw) / 1000.0
            except ValueError:
                pass
    return None


def battery_status():
    base = "/sys/class/power_supply"
    if not os.path.isdir(base):
        return None
    for psu in os.listdir(base):
        cap = read_file(f"{base}/{psu}/capacity")
        if cap == "?":
            continue
        status = read_file(f"{base}/{psu}/status", "?")
        try:
            return int(cap), status
        except ValueError:
            pass
    return None


def uptime_str():
    raw = read_file("/proc/uptime")
    if raw == "?":
        return "?"
    secs = float(raw.split()[0])
    d, rem = divmod(int(secs), 86400)
    h, rem = divmod(rem, 3600)
    m, _ = divmod(rem, 60)
    return (f"{d}d " if d else "") + f"{h}h {m:02d}m"


CSS = """
Screen { background: #1e1e2e; color: #cdd6f4; }
Header { background: #181825; color: #89b4fa; }
Footer { background: #181825; color: #a6adc8; }
#dashboard-panel { height: auto; padding: 1 2; margin: 0 1; background: #2a2a3e; border: solid #7f849c; }
#breadcrumb { height: 1; padding: 0 1; color: #89dceb; text-style: bold; }
#search-box { height: 3; padding: 0 1; }
#main-content { height: 1fr; padding: 0 1; }
/* Action bar: compact equal-width buttons along the bottom (media-center remote style). */
#action-bar { height: 3; padding: 0 1; }
#action-bar Button { width: 1fr; height: auto; margin: 0 1 0 0; padding: 0 1; border: round #585b70; background: #262637; text-align: center; }
#action-bar Button:hover { border: round #89b4fa; background: #313244; }
#action-bar Button#btn-play { color: #a6e3a1; }
#action-bar Button#btn-shuffle { color: #cba6f7; }
#action-bar Button#btn-dl { color: #89dceb; }
#action-bar Button#btn-rm { color: #f38ba8; margin-right: 0; }
/* ListView must stay viewport-sized (1fr): height:auto made it grow to fit
   every row, so the list overflowed the screen and never scrolled. */
ListView { height: 1fr; }
ListItem { height: 3; padding: 0; }
/* Media rows are plain Labels (1 line): 200 bordered Buttons per page were
   too slow to mount/paint on the A53 and looked like a hang. */
MediaItem, LoadMoreItem, RowItem { height: 1; padding: 0 1; }
MediaItem > Label, LoadMoreItem > Label, RowItem > Label { width: 100%; }
