#!/usr/bin/env python3
"""goblin — unified handheld TUI suite.

A single modern interface for all daily tools:
- Dashboard: live system stats with graphs
- Play: hierarchical Jellyfin browser (Libraries → Shows → Episodes)  
- Run: fast app launcher
- Music: audio player (placeholder)

Controls:
  Gamepad: D-pad=navigate, A=select, B=back/quit
  Keyboard: arrows+enter+escape, or d/p/m/r/q shortcuts
  
Built on textual framework, Catppuccin Mocha theme, optimized for 640×480.
"""
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

from textual import on, work
from textual.app import App, ComposeResult
from textual.containers import Container, Vertical
from textual.widgets import Button, Footer, Header, Input, Label, ListView, ListItem, Static


# ─── System helpers ──────────────────────────────────────────────────────────

def read_file(path, default="?"):
    """Read a file and return stripped content."""
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def meminfo():
    """Get memory usage as (used_mb, total_mb, fraction)."""
    info = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, v = line.partition(":")
                info[k] = int(v.strip().split()[0])
    except (OSError, ValueError):
        return None
    
    total = info.get("MemTotal", 0)
    avail = info.get("MemAvailable", 0)
    if not total:
        return None
    
    used = total - avail
    return used / 1024.0, total / 1024.0, used / total


def cpu_load():
    """Get CPU load averages."""
    try:
        with open("/proc/loadavg") as f:
            parts = f.read().split()
        return [float(x) for x in parts[:3]]
    except (OSError, ValueError):
        return None


def cpu_temp():
    """Get CPU temperature in Celsius."""
    import glob
    for zone in sorted(glob.glob("/sys/class/thermal/thermal_zone*/temp")):
        raw = read_file(zone)
        if raw != "?":
            try:
                return int(raw) / 1000.0
            except ValueError:
                pass
    return None


def battery_status():
    """Get battery capacity and charging status."""
    base = "/sys/class/power_supply"
    if not os.path.isdir(base):
        return None
    
    for psu in os.listdir(base):
        cap = read_file(f"{base}/{psu}/capacity")
        if cap == "?":
            continue
        status = read_file(f"{base}/{psu}/status", "?")
        try:
            return int(cap), status
        except ValueError:
            pass
    return None


def uptime_str():
    """Format system uptime as human-readable string."""
    raw = read_file("/proc/uptime")
    if raw == "?":
        return "?"
    
    secs = float(raw.split()[0])
    d, rem = divmod(int(secs), 86400)
    h, rem = divmod(rem, 3600)
    m, _ = divmod(rem, 60)
    return (f"{d}d " if d else "") + f"{h}h {m:02d}m"


