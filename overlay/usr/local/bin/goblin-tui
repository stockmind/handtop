# ─── Widgets ─────────────────────────────────────────────────────────────────

class StatusPanel(Static):
    """Live system stats with mini-bars."""
    
    def on_mount(self):
        self.update_stats()
        self.set_interval(2.0, self.update_stats)
    
    def update_stats(self):
        load = cpu_load()
        temp = cpu_temp()
        mem = meminfo()
        bat = battery()
        
        lines = []
        if load:
            lines.append(f"[bold #89b4fa]Load[/]     {load[0]:.2f} {load[1]:.2f} {load[2]:.2f}")
        if temp is not None:
            lines.append(f"[bold #89b4fa]Temp[/]     {temp:.0f}°C")
        if mem:
            used, total, frac = mem
            bar_w = 16
            filled = int(round(frac * bar_w))
            bar = "█" * filled + "░" * (bar_w - filled)
            lines.append(f"[bold #89b4fa]Memory[/]   {bar} {used:.0f}/{total:.0f}M")
        if bat:
            cap, status = bat
            icon = "🔌" if "Charging" in status else "🔋"
            lines.append(f"[bold #89b4fa]Battery[/]  {icon} {cap}%")
        lines.append(f"[bold #89b4fa]Uptime[/]   {uptime_str()}")
        
        self.update("\n".join(lines))


# ─── Main app ────────────────────────────────────────────────────────────────

class GoblinTUI(App):
    """The unified handheld launcher."""
    
    TITLE = "Goblin"
    CSS = GOBLIN_CSS
    
    BINDINGS = [
        ("q", "quit", "Quit"),
        ("d", "show_dashboard", "Dashboard"),
        ("p", "show_play", "Play"),
        ("m", "show_music", "Music"),
        ("r", "show_run", "Run"),
    ]
    
    def __init__(self, mode="menu"):
        super().__init__()
        self.mode = mode  # menu, dashboard, play, music, run
    
    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Vertical(id="main-container"):
            yield StatusPanel(id="status-panel")
            with Container(id="main-content"):
                yield Static("Loading...", id="content-area")
        yield Footer()
    
    def on_mount(self):
        if self.mode == "dashboard":
            self.show_dashboard()
        elif self.mode == "play":
            self.show_play()
        elif self.mode == "music":
            self.show_music()
        elif self.mode == "run":
            self.show_run()
        else:
            self.show_menu()
    
    def show_menu(self):
        content = self.query_one("#content-area", Static)
        content.update("[bold #89dceb]Select a tool:[/]\n\n"
                      "  [bold]d[/] Dashboard    [dim]system stats[/]\n"
                      "  [bold]p[/] Play         [dim]Jellyfin media[/]\n"
                      "  [bold]m[/] Music        [dim]audio player[/]\n"
                      "  [bold]r[/] Run          [dim]app launcher[/]\n"
                      "  [bold]q[/] Quit")
    
    def show_dashboard(self):
        content = self.query_one("#content-area", Static)
        content.update("[bold #89dceb]Dashboard[/]\n\n"
                      "System stats are shown above.\n"
                      "Press [bold]d[/] to refresh, [bold]q[/] to quit.")
    
    def show_play(self):
        content = self.query_one("#content-area", Static)
        content.update("[bold #89dceb]Play Media[/]\n\n"
                      "Browse Jellyfin library...\n"
                      "[dim](coming soon)[/]")
    
    def show_music(self):
        content = self.query_one("#content-area", Static)
        content.update("[bold #89dceb]Music Player[/]\n\n"
                      "Audio jukebox...\n"
                      "[dim](coming soon)[/]")
    
    def show_run(self):
        content = self.query_one("#content-area", Static)
        content.update("[bold #89dceb]Run App[/]\n\n"
                      "Type to search apps...\n"
                      "[dim](coming soon)[/]")
    
    def action_show_dashboard(self):
        self.show_dashboard()
    
    def action_show_play(self):
        self.show_play()
    
    def action_show_music(self):
        self.show_music()
    
    def action_show_run(self):
        self.show_run()


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "menu"
    GoblinTUI(mode).run()
