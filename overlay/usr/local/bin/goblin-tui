#!/usr/bin/env python3
"""goblin-tui — unified launcher for all handheld tools.

A single modern interface (textual-based) that provides:
- Live system dashboard with graphs
- Jellyfin media browser  
- Music player
- Fast app launcher (bemenu-style, but inline)
- System actions (htop, screen-off, etc.)

All in one place, mouse-friendly, neon-styled, sized for 640×480.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

from textual import on, work
from textual.app import App, ComposeResult
from textual.containers import Container, Horizontal, Vertical
from textual.reactive import reactive
from textual.widgets import (
    Button,
    DataTable,
    Footer,
    Header,
    Input,
    Label,
    ListView,
    ListItem,
    Static,
)


# ─── Shared helpers ──────────────────────────────────────────────────────────

def read(path, default="?"):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def meminfo():
    info = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, v = line.partition(":")
                info[k] = int(v.strip().split()[0])
    except OSError:
        return None
    total = info.get("MemTotal", 0)
    avail = info.get("MemAvailable", 0)
    if not total:
        return None
    used = total - avail
    return used / 1024.0, total / 1024.0, used / total


def cpu_load():
    try:
        with open("/proc/loadavg") as f:
            parts = f.read().split()
        return [float(x) for x in parts[:3]]
    except (OSError, ValueError):
        return None


def cpu_temp():
    import glob
    for z in sorted(glob.glob("/sys/class/thermal/thermal_zone*/temp")):
        raw = read(z)
        if raw != "?":
            try:
                return int(raw) / 1000.0
            except ValueError:
                pass
    return None


def battery():
    base = "/sys/class/power_supply"
    if not os.path.isdir(base):
        return None
    for psu in os.listdir(base):
        cap = read(f"{base}/{psu}/capacity")
        if cap == "?":
            continue
        status = read(f"{base}/{psu}/status", "?")
        try:
            return int(cap), status
        except ValueError:
            pass
    return None


def uptime_str():
    raw = read("/proc/uptime")
    if raw == "?":
        return "?"
    secs = float(raw.split()[0])
    d, rem = divmod(int(secs), 86400)
    h, rem = divmod(rem, 3600)
    m, _ = divmod(rem, 60)
    return (f"{d}d " if d else "") + f"{h}h {m:02d}m"


