      head2.lastChild.textContent = items.length +
        (on ? ' \u25be' : ' \u25b8 \u2014 tap to open');
      head2.setAttribute('aria-expanded', on ? 'true' : 'false');
      if (on && !built) {
        built = true;
        for (const b of items) box.appendChild(stRow(b));
      }
    };
    head2.onclick = toggle;
    head2.onkeydown = e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    };
    list.appendChild(head2);
    list.appendChild(box);
