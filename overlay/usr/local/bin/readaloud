  document.getElementById('tagline').textContent = d.title || BOOK;
  document.getElementById('redlab').textContent = 'chapter';
  document.getElementById('topaut').textContent = d.author || '';
  document.getElementById('slimaut').textContent = d.author || '';
  document.getElementById('dur').textContent = fmt(duration);
  if (d.cover) {
    document.getElementById('cov').src = '/label/' + encodeURIComponent(BOOK);
    const art = '/art/' + encodeURIComponent(BOOK);
    document.getElementById('stk').src = art;
