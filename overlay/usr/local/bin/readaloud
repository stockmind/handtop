  musicSort = musicSort === 'artist' ? 'album' : musicSort === 'album' ? 'year' : 'artist';
  document.getElementById('sortbtn').textContent =
    musicSort === 'artist' ? 'Artist' : musicSort === 'album' ? 'Album' : 'Year';
  renderMusic();
};
document.getElementById('shufbtn').onclick = () => { location.href = '/play?shuffle=1'; };
// Download a readaloud epub from Storyteller, with a live byte bar.
function startDownload(row, book) {
  if (row.dataset.dl) return;
  row.dataset.dl = '1';
  const meta = row.querySelector('.m');
  let bar = row.querySelector('.bar');
  if (!bar) {
    bar = document.createElement('div');
    bar.className = 'bar';
    row.appendChild(bar);          // same absolutely-positioned bar as local rows
  }
  row.classList.add('dl');
  if (meta) meta.textContent = 'downloading\u2026';
  const act = row.querySelector('.act');
  if (act) act.innerHTML = '<div class="spinner"></div>';
  const mb = n => (n / 1048576).toFixed(0);
  fetch('/api/download', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({uuid: book.uuid, title: book.title}),
  }).catch(() => {});
  const timer = setInterval(() => {
    fetch('/api/download/' + encodeURIComponent(book.uuid)).then(r => r.json()).then(s => {
      const pct = s.total ? Math.round(100 * s.done / s.total) : 0;
      bar.style.width = Math.min(100, pct) + '%';
      if (s.state === 'running' && meta) {
        meta.textContent = s.total
          ? 'downloading ' + pct + '% \u00b7 ' + mb(s.done) + ' of ' + mb(s.total) + ' MB'
          : 'downloading\u2026';
      }
      if (s.state === 'done') {
        clearInterval(timer);
        if (meta) meta.textContent = 'downloaded \u00b7 opening\u2026';
        bar.style.width = '100%';
        setTimeout(() => location.reload(), 900);
      } else if (s.state === 'failed') {
        clearInterval(timer);
        row.dataset.dl = '';
        row.classList.remove('dl');
        if (meta) meta.textContent = 'download failed \u00b7 check the server';
        bar.style.width = '0%';
      }
    }).catch(() => {});
  }, 800);
}


// ---- UI self-tests (?check=ui): clicks and gamepad ----
async function runUITests() {
  const results = [];
  const check = async (name, fn) => {
    try { await fn(); results.push(name + ' PASS'); }
    catch (e) { results.push(name + ' FAIL ' + ((e && e.message) || e)); }
  };
  const assert = (c, m) => { if (!c) throw new Error(m || 'assert'); };
  const pad = {index: 0, buttons: Array.from({length: 18}, () => ({pressed: false}))};
  navigator.getGamepads = () => [pad];
  const tap = i => {
    pad.buttons[i].pressed = true;
    padTick();
    pad.buttons[i].pressed = false;
    padTick();
  };

  await check('rows are focusable', async () => {
    const r = rows();
    assert(r.length > 0, 'no rows');
    assert(typeof r[0].focus === 'function', 'row not focusable');
  });
  await check('view button cycles', async () => {
    const before = view;
    document.getElementById('viewbtn').click();
    assert(view !== before, 'view unchanged');
    document.getElementById('viewbtn').click();
  });
  await check('keyboard v cycles view', async () => {
    const before = view;
    dispatchEvent(new KeyboardEvent('keydown', {key: 'v'}));
    assert(view !== before, 'view unchanged');
  });
  await check('pad down moves focus', async () => {
    if (rows().length < 2) return;          // single-book fixture
    focusRow(0);
    const before = sel;
    tap(13);
    assert(sel !== before, 'focus did not move');
  });
  await check('pad up moves focus back', async () => {
    if (rows().length < 2) return;
    focusRow(rows().length - 1);
    const before = sel;
    tap(12);
    assert(sel !== before, 'focus did not move');
  });
  await check('series header expands on click', async () => {
    const head = document.querySelector('#list .series');
    if (!head) return;                       // no Storyteller configured
    const box = head.nextElementSibling;
    head.click();
    assert(box.classList.contains('open'), 'group did not open');
    head.click();
    assert(!box.classList.contains('open'), 'group did not close');
  });
  await check('theme sheet applies a theme', async () => {
    document.getElementById('themebtn').click();
    const cards = document.querySelectorAll('#themegrid .tcard');
    assert(cards.length >= 6, 'theme cards missing');
    cards[3].click();
    const applied = document.documentElement.style.getPropertyValue('--bg').trim();
    assert(applied && applied.toLowerCase() !== '#141414', 'theme not applied');
    assert(document.querySelector('#themegrid .tcard.sel'), 'no selection shown');
    closeThemes();
    applyTheme('midnight');
  });
  await check('series header opens with pad A', async () => {
    const head = document.querySelector('#list .series');
    if (!head) return;
    head.focus();
    tap(0);
    assert(head.nextElementSibling.classList.contains('open'), 'pad A did not open');
    head.click();
  });

  const pass = results.filter(r => r.includes(' PASS')).length;
  document.title = 'UITESTS ' + pass + '/' + results.length + ' ' + results.join(' | ');
}


