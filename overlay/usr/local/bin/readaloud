  fetch('/api/jack').then(r => r.json()).then(s => {
    if (jackWas === true && s.inserted === false && !audio.paused) toggle();
    if (typeof s.inserted === 'boolean') jackWas = s.inserted;
  }).catch(() => {});
}, 2000);

