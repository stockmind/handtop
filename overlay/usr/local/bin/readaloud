  });
}
const held = {};
function padTick() {
  for (const gp of (navigator.getGamepads ? navigator.getGamepads() : [])) {
    if (!gp) continue;
    if (gp.axes && gp.axes.some(a => Math.abs(a) > 0.25)) activity();
    gp.buttons.forEach((b, i) => {
      const k = gp.index + ':' + i;
      if (b.pressed && !held[k]) {
        if (tracksOpen) {
          if (i === 0) { const r = rows()[sel]; if (r) r.click(); }
          else if (i === 1 || i === 8) closeTracks();
          else if (i === 12) moveFocus(-1);
          else if (i === 13) moveFocus(1);
          held[k] = b.pressed;
          return;
        }
        if (i === 12) moveFocus(-1);
        else if (i === 13) moveFocus(1);
        else if (i === 14) focusRow(sel - 1);
        else if (i === 15) focusRow(sel + 1);
        else if (i === 4) setTab('books');
        else if (i === 5) setTab('music');
        else if (i === 3) cycleView();
        else if (i === 2) cycleView();
        else if (i === 0) {
          const r = rows()[sel];
          if (r) r.click();
          if (r && r.classList.contains('series')) focusRow(sel + 1);
        }
        else if (i === 1 || i === 8) fetch('/quit').catch(() => {});
      }
      held[k] = b.pressed;
    });
  }
}
