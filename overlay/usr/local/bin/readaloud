#!/usr/bin/env python3
"""Minimal EPUB3 read-aloud player for small screens.

Serves a folder of .epub files, renders the book's own XHTML in an <iframe>,
and drives one <audio> element from the book's SMIL media overlays, highlighting
the text of the current <par>.

    ./readaloud.py ~/Downloads          # library at http://127.0.0.1:8099/
    ./readaloud.py --selftest book.epub

Audio goes through Chromium's own ffmpeg, so no GStreamer plugin hunting.
ponytail: SMIL walk is a linear scan per timeupdate (a book has ~1k pars);
fine at this size, index it if a book ever stalls the loop.
"""
import argparse
import gzip
import hashlib
import html
import json
import mimetypes
import os
import posixpath
import re
import select
import struct
import sys
import threading
import time
import zipfile
import xml.etree.ElementTree as ET
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, unquote, urlparse

CACHE_DIR = os.path.expanduser('~/.cache/readaloud')

TYPES = {
    '.xhtml': 'application/xhtml+xml', '.html': 'text/html', '.opf': 'application/oebps-package+xml',
    '.ncx': 'application/x-dtbncx+xml', '.css': 'text/css', '.js': 'text/javascript',
    '.mp4': 'audio/mp4', '.m4a': 'audio/mp4', '.mp3': 'audio/mpeg', '.ogg': 'audio/ogg',
    '.jpg': 'image/jpeg', '.png': 'image/png', '.svg': 'image/svg+xml', '.gif': 'image/gif',
    '.woff': 'font/woff', '.woff2': 'font/woff2', '.ttf': 'font/ttf', '.otf': 'font/otf',
}


def mime(path):
    ext = posixpath.splitext(path)[1].lower()
    return TYPES.get(ext) or mimetypes.guess_type(path)[0] or 'application/octet-stream'


def strip_ns(root):
    for el in root.iter():
        if '}' in el.tag:
            el.tag = el.tag.split('}', 1)[1]


def parse_clock(v):
    if not v:
        return 0.0
    v = v.strip()
    for suffix, mul in (('ms', 0.001), ('min', 60.0), ('s', 1.0), ('h', 3600.0)):
        if v.endswith(suffix):
            return float(v[:-len(suffix)]) * mul
    if ':' in v:
        parts = [float(x) for x in v.split(':')]
        while len(parts) < 3:
            parts.insert(0, 0.0)
        return parts[0] * 3600 + parts[1] * 60 + parts[2]
    return float(v)


def resolve(href, frm):
    """Resolve an href from a manifest/SMIL file to a zip path."""
    p = posixpath.normpath(posixpath.join(posixpath.dirname(frm), unquote(href)))
    return p.lstrip('/')


def title_of(z, name, fallback):
    try:
        m = re.search(r'<title[^>]*>(.*?)</title>', z.read(name).decode('utf-8', 'replace'), re.S)
        if m:
            return html.unescape(re.sub(r'\s+', ' ', m.group(1))).strip() or fallback
    except Exception:
        pass
    return fallback


def parse_smil(z, path):
    root = ET.fromstring(z.read(path))
    strip_ns(root)
    out = []
    for par in root.iter('par'):
        t, a = par.find('text'), par.find('audio')
        if t is None or a is None or not t.get('src') or not a.get('src'):
            continue
        src, _, frag = t.get('src').partition('#')
        out.append({
            'file': resolve(src, path),
            'frag': frag,
            'audio': resolve(a.get('src'), path),
            'begin': parse_clock(a.get('clipBegin')),
            'end': parse_clock(a.get('clipEnd')),
        })
    return out


def load_book(path):
    z = zipfile.ZipFile(path)
    try:
        names = set(z.namelist())
        container = ET.fromstring(z.read('META-INF/container.xml'))
        strip_ns(container)
        opf_path = container.find('.//rootfile').get('full-path')
        opf = ET.fromstring(z.read(opf_path))
        strip_ns(opf)
        manifest = {
            it.get('id'): {'href': it.get('href'), 'overlay': it.get('media-overlay'),
                           'type': it.get('media-type') or ''}
            for it in opf.iter('item')
        }
        toc = read_toc(z, opf, opf_path, names)
        sections = []
        for ref in opf.iter('itemref'):
            it = manifest.get(ref.get('idref'))
            if not it or not it.get('overlay'):
                continue
            ov = manifest.get(it['overlay'], {})
            if not ov.get('href'):
                continue
            smil = resolve(ov['href'], opf_path)
            if smil not in names:
                continue
            pars = [p for p in parse_smil(z, smil) if p['audio'] in names]
            if not pars:
                continue
            href = resolve(it['href'], opf_path)
            sections.append({
                'href': href,
                'title': title_of(z, href, 'Section %d' % (len(sections) + 1)),
                'label': toc.get(href) or '',
                'pars': pars,
            })
        if not sections:
            # Plain epub: expose the spine so it can still be read, and paced by
            # words per minute instead of narration.
            for ref in opf.iter('itemref'):
                it = manifest.get(ref.get('idref'))
                if not it or not it.get('href'):
                    continue
                if not it['type'].endswith(('xhtml+xml', 'html')):
                    continue
                href = resolve(it['href'], opf_path)
                if href not in names:
                    continue
                sections.append({
                    'href': href,
                    'title': title_of(z, href, 'Section %d' % (len(sections) + 1)),
                    'label': toc.get(href) or '',
                    'pars': [],
                })
        side = posixpath.splitext(path)[0] + '.words.json'
        if os.path.exists(side):
            try:
                with open(side) as f:
                    times = json.load(f)
                for s in sections:
                    for p in s['pars']:
                        key = p['file'] + '#' + p['frag']
                        if key in times:
                            p['times'] = times[key]
            except Exception:
                pass
        info = book_info(path)
        return {'title': info['title'], 'author': info['author'],
                'subtitle': info['subtitle'],
                'narration': any(s['pars'] for s in sections),
                'sections': sections}
    finally:
        z.close()


JACK = {'inserted': None}
SCREEN = {'on': True}


def _backlight():
    import glob
    for p in glob.glob('/sys/class/backlight/*/brightness'):
        return p
    return ''


def _bright_state():
    d = os.environ.get('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid()
    return os.path.join(d, 'rg35xxh-readaloud-bright')


def screen_set(on):
    """Panel off by backlight, not DPMS: the Wayland output stays enabled, so
    pointer motion still reaches the page and can wake it. Audio never stops."""
    bl = _backlight()
    if not bl:
        SCREEN['on'] = bool(on)
        return False
    state = _bright_state()
    import subprocess
    env = dict(os.environ)
    env.setdefault('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())
    env.setdefault('WAYLAND_DISPLAY', 'wayland-0')
    try:
        # The output must stay enabled: a DPMS-off output stops delivering
        # pointer motion, and that is what made a mouse move unable to wake it.
        subprocess.run(['wlopm', '--on', '*'], env=env, timeout=5, capture_output=True)
        if on:
            try:
                with open(state) as f:
                    val = f.read().strip()
            except OSError:
                val = ''
            if val:
                with open(bl, 'w') as f:
                    f.write(val)
                os.unlink(state)
        else:
            if not os.path.exists(state):
                with open(bl) as f:
                    cur = f.read().strip()
                with open(state, 'w') as f:
                    f.write(cur or '255')
            with open(bl, 'w') as f:
                f.write('0')
    except Exception:
        return False
    SCREEN['on'] = bool(on)
    return True


def player_active(on):
    """A flag autosleep checks: listening with the panel on must not suspend."""
    d = os.environ.get('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid()
    p = os.path.join(d, 'rg35xxh-player')
    try:
        if on:
            open(p, 'a').close()
        else:
            os.unlink(p)
    except OSError:
        pass
    return True
_CACHE = {}
_INFO = {}
_CACHE_LOCK = threading.Lock()


def watch_jack(path='/dev/input/event1'):
    """Track the headphone switch so the page can pause when headphones leave."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return
    while True:
        try:
            ready, _, _ = select.select([fd], [], [], 30)
        except OSError:
            return
        if not ready:
            continue
        try:
            data = os.read(fd, 24 * 64)
        except (BlockingIOError, OSError):
            continue
        for i in range(0, len(data) - 23, 24):
            _, _, typ, code, val = struct.unpack_from('llHHi', data, i)
            if typ == 5 and code == 2:          # EV_SW, SW_HEADPHONE_INSERT
                JACK['inserted'] = (val == 1)


def close_app():
    """Close only the player window. The server keeps running so the app reopens
    instantly and never lands on a dead port."""
    time.sleep(0.2)
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            cl = open('/proc/%s/cmdline' % pid, 'rb').read().decode('utf8', 'replace')
        except Exception:
            continue
        if 'chrom' in cl and '127.0.0.1' in cl and '--kiosk' in cl:
            try:
                os.kill(int(pid), 15)
            except Exception:
                pass


_CACHE_ORDER = []


def _remember(key, entry):
    with _CACHE_LOCK:
        for k in [k for k in _CACHE if k[0] == key[0]]:
            _CACHE.pop(k, None)
        _CACHE[key] = entry
        if key in _CACHE_ORDER:
            _CACHE_ORDER.remove(key)
        _CACHE_ORDER.append(key)
        while len(_CACHE_ORDER) > 4:            # 2 MB each: do not hoard books
            old = _CACHE_ORDER.pop(0)
            _CACHE.pop(old, None)


def load_book_cached(path):
    """Parsing a book costs ~1.9 s for a 13k-par novel, so the parse and both
    encodings are cached in memory and on disk, keyed on mtime/size."""
    st = os.stat(path)
    key = (path, st.st_mtime_ns, st.st_size)
    with _CACHE_LOCK:
        hit = _CACHE.get(key)
    if hit is not None:
        return hit

    digest = hashlib.sha1(('b1|%s|%d|%d' % key).encode()).hexdigest()[:16]
    disk = os.path.join(CACHE_DIR, digest + '.book.json.gz')
    if os.path.exists(disk):
        try:
            with open(disk, 'rb') as f:
                gz = f.read()
            raw = gzip.decompress(gz)
            entry = (json.loads(raw), raw, gz)
            _remember(key, entry)
            return entry
        except Exception:
            pass

    data = load_book(path)
    raw = json.dumps(data).encode()
    gz = gzip.compress(raw, 6)
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = disk + '.tmp'
        with open(tmp, 'wb') as f:
            f.write(gz)
        os.replace(tmp, disk)
    except Exception:
        pass
    entry = (data, raw, gz)
    _remember(key, entry)
    return entry


def read_package(z):
    container = ET.fromstring(z.read('META-INF/container.xml'))
    strip_ns(container)
    opf_path = container.find('.//rootfile').get('full-path')
    opf = ET.fromstring(z.read(opf_path))
    strip_ns(opf)
    return opf, opf_path


def read_meta(opf, fallback):
    md = opf.find('metadata')
    if md is None:
        md = opf

    def text(tag):
        el = md.find(tag)
        return (el.text or '').strip() if el is not None else ''

    title = text('title') or fallback
    # Edition epubs list translators and the original author again; the first
    # real name reads best on a 640 px row, so keep that and count the rest.
    names, seen = [], set()
    for c in md.findall('creator'):
        name = (c.text or '').strip()
        if not name or name.startswith('[') or name.lower() in seen:
            continue
        seen.add(name.lower())
        names.append(name)
    author = names[0] if names else ''
    if len(names) > 1:
        author += ' +%d' % (len(names) - 1)
    series = ''
    for m in md.findall('meta'):
        if (m.get('property') or '') == 'belongs-to-collection' and not series:
            series = (m.text or '').strip()
    subtitle = ''
    if ':' in title:                       # how most epubs carry a subtitle
        head, tail = title.split(':', 1)
        if tail.strip():
            title, subtitle = head.strip(), tail.strip()
    return {'title': title, 'author': author, 'subtitle': subtitle, 'series': series}


def read_toc(z, opf, opf_path, names):
    """href -> label from the EPUB3 nav document, falling back to the NCX."""
    toc = {}
    nav = None
    for it in opf.iter('item'):
        if 'nav' in (it.get('properties') or '').split():
            nav = resolve(it.get('href'), opf_path)
            break
    if nav and nav in names:
        try:
            doc = ET.fromstring(z.read(nav))
            strip_ns(doc)
            for n in doc.iter('nav'):
                kind = n.get('type') or ''
                if kind and 'toc' not in kind:
                    continue
                for a in n.iter('a'):
                    href = a.get('href') or ''
                    label = ' '.join((a.text or '').split())
                    if href and label:
                        toc.setdefault(resolve(href.split('#')[0], nav), label)
                if toc:
                    break
        except Exception:
            pass
    if toc:
        return toc
    ncx = None
    for it in opf.iter('item'):
        if (it.get('media-type') or '').endswith('ncx'):
            ncx = resolve(it.get('href'), opf_path)
            break
    if ncx and ncx in names:
        try:
            doc = ET.fromstring(z.read(ncx))
            strip_ns(doc)
            for point in doc.iter('navPoint'):
                label = point.find('navLabel/text')
                content = point.find('content')
                if label is None or content is None or not content.get('src'):
                    continue
                href = resolve(content.get('src').split('#')[0], ncx)
                text = ' '.join((label.text or '').split())
                if text:
                    toc.setdefault(href, text)
        except Exception:
            pass
    return toc


def find_cover(z, opf, opf_path):
    by_id, props_href = {}, None
    for it in opf.iter('item'):
        href = it.get('href') or ''
        by_id[it.get('id')] = href
        if 'cover-image' in (it.get('properties') or ''):
            props_href = href
    cover_id = None
    for m in opf.iter('meta'):
        if m.get('name') == 'cover':
            cover_id = m.get('content')
    target = props_href or by_id.get(cover_id) or next(
        (h for i, h in by_id.items() if 'cover' in (i or '').lower()), None)
    if not target:
        return None, None
    return z.read(resolve(target, opf_path)), mime(resolve(target, opf_path))


def book_info(path):
    """Metadata, cover path and flags. Cached in memory and on disk, keyed on
    mtime+size so a replaced file invalidates itself."""
    fallback = posixpath.splitext(os.path.basename(path))[0]
    blank = {'title': fallback, 'author': '', 'subtitle': '', 'series': '',
             'cover': False, 'readaloud': False, 'key': ''}
    try:
        st = os.stat(path)
    except OSError:
        return blank
    key = hashlib.sha1(('v2|%s|%d|%d' % (path, st.st_mtime_ns, st.st_size)).encode()).hexdigest()[:16]
    with _CACHE_LOCK:
        hit = _INFO.get(key)
    if hit is not None:
        return hit

    info = dict(blank, key=key)
    cached = os.path.join(CACHE_DIR, key + '.json')
    if os.path.exists(cached):
        try:
            with open(cached) as f:
                info.update(json.load(f))
        except Exception:
            pass
    else:
        try:
            with zipfile.ZipFile(path) as z:
                opf, opf_path = read_package(z)
                info.update(read_meta(opf, fallback))
                info['readaloud'] = any(n.lower().endswith('.smil') for n in z.namelist())
                data, ctype = find_cover(z, opf, opf_path)
                if data:
                    os.makedirs(CACHE_DIR, exist_ok=True)
                    with open(os.path.join(CACHE_DIR, key + '.cover'), 'wb') as f:
                        f.write(data)
                    with open(os.path.join(CACHE_DIR, key + '.mime'), 'w') as f:
                        f.write(ctype or 'image/jpeg')
                    info['cover'] = True
                    try:
                        make_thumb(os.path.join(CACHE_DIR, key + '.cover'), key)
                    except Exception:
                        pass
        except Exception:
            pass
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            with open(cached, 'w') as f:
                json.dump(info, f)
        except Exception:
            pass
    with _CACHE_LOCK:
        _INFO[key] = info
    return info


_THUMB_QUEUE = []
_THUMB_LOCK = threading.Lock()
_THUMB_RUNNING = {'on': False}


def _thumb_worker():
    import subprocess
    while True:
        with _THUMB_LOCK:
            if not _THUMB_QUEUE:
                _THUMB_RUNNING['on'] = False       # idle: stop the thread
                return
            src_img, out = _THUMB_QUEUE.pop(0)
        if os.path.exists(out):
            continue                                # already made (or another pass did)
        tmp = out + '.tmp.jpg'
        try:
            subprocess.run(['ffmpeg', '-y', '-nostdin', '-threads', '1', '-v', 'error',
                            '-i', src_img, '-vf', 'scale=96:-2', '-q:v', '6', tmp],
                           timeout=60, capture_output=True)
        except Exception:
            pass
        # rename only when complete: a request must never read a half-written file
        if os.path.exists(tmp) and os.path.getsize(tmp) > 512:
            os.replace(tmp, out)
        else:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def make_thumb(img, key):
    """Covers are drawn 40x58. The thumbnail is made once, stored next to the
    cover and reused; encoding never happens in a request and never in a loop."""
    thumb = os.path.join(CACHE_DIR, key + '.thumb.jpg')
    try:
        if os.path.getsize(thumb) > 512:
            return thumb
        os.unlink(thumb)                 # half-written or garbage: redo it
    except OSError:
        pass
    with _THUMB_LOCK:
        if (img, thumb) not in _THUMB_QUEUE and len(_THUMB_QUEUE) < 64:
            _THUMB_QUEUE.append((img, thumb))
        start = not _THUMB_RUNNING['on']
        if start:
            _THUMB_RUNNING['on'] = True
    if start:
        threading.Thread(target=_thumb_worker, daemon=True).start()
    return img


def warm_thumbs():
    """Generate any missing thumbnails once, off the request path."""
    try:
        for name in os.listdir(CACHE_DIR):
            if name.endswith('.cover'):
                make_thumb(os.path.join(CACHE_DIR, name), name[:-len('.cover')])
            elif name.startswith('st-') and name.endswith('.img'):
                make_thumb(os.path.join(CACHE_DIR, name), name[:-len('.img')])
    except Exception:
        pass


def cover_file(book):
    info = media_info(book)
    p = os.path.join(CACHE_DIR, info['key'] + '.cover') if info.get('key') else ''
    if not info.get('cover') or not p or not os.path.exists(p):
        # The metadata cache can hold cover:false from a failed extraction (or a
        # cache dir that was cleaned). Redo it once instead of serving nothing.
        if info.get('key'):
            try:
                os.unlink(os.path.join(CACHE_DIR, info['key'] +
                                       ('.audio.json' if is_audio(book) else '.json')))
            except OSError:
                pass
            with _CACHE_LOCK:
                if is_audio(book):
                    _AINFO.pop(info['key'], None)
                else:
                    _INFO.pop(info['key'], None)
            info = media_info(book)
            p = os.path.join(CACHE_DIR, info['key'] + '.cover')
        if not info.get('cover') or not os.path.exists(p):
            return None, None
    return make_thumb(p, info['key']), 'image/jpeg'


def is_readaloud(path):
    return book_info(path)['readaloud']


# ---- m4b / m4a: audiobooks with no epub ---------------------------------
# The MP4 boxes we need are read with seeks only, so a 1 GB m4b costs no more
# than its headers. Parsed metadata, the cover and a label-sized crop are
# cached on disk next to the epub covers.
AUDIO_EXTS = ('.m4b', '.m4a')
MUSIC_EXTS = ('.mp3', '.m4a', '.aac', '.flac', '.ogg', '.opus', '.wav')
MUSIC_ALL = tuple(dict.fromkeys(AUDIO_EXTS + MUSIC_EXTS))
_AINFO = {}
_LABEL_LOCK = threading.Lock()
_MUSIC = {'at': 0.0, 'root': '', 'data': None}


def is_audio(path):
    return os.path.splitext(path)[1].lower() in MUSIC_ALL


def _atoms(f, start, end):
    """Walk one MP4 box list. Yields (type, payload_start, payload_end)."""
    pos = start
    while pos + 8 <= end:
        f.seek(pos)
        h = f.read(8)
        if len(h) < 8:
            return
        size, typ = struct.unpack('>I4s', h)
        hlen = 8
        if size == 1:
            more = f.read(8)
            if len(more) < 8:
                return
            size = struct.unpack('>Q', more)[0]
            hlen = 16
        elif size == 0:
            size = end - pos
        if size < hlen or pos + size > end:
            return
        yield typ, pos + hlen, pos + size
        pos += size


def _child(f, start, end, typ):
    for t, ps, pe in _atoms(f, start, end):
        if t == typ:
            return ps, pe
    return None


def _descend(f, start, end, path):
    for typ in path:
        n = _child(f, start, end, typ)
        if not n:
            return None
        start, end = n
        if typ == b'meta':
            start += 4                  # full box: version and flags
    return start, end


_MP4_TAGS = {b'\xa9nam': 'title', b'\xa9alb': 'album', b'\xa9ART': 'artist',
             b'aART': 'albumartist', b'\xa9wrt': 'author', b'\xa9grp': 'series',
             b'\xa9day': 'year', b'\xa9gen': 'genre'}


def _mp4_ilst(f, start, end):
    """iTunes-style metadata items: {box type: (data type, payload)}."""
    out = {}
    for typ, ps, pe in _atoms(f, start, end):
        data = _child(f, ps, pe, b'data')
        if not data:
            continue
        ds, de = data
        f.seek(ds)
        head = f.read(8)
        if len(head) < 8:
            continue
        out.setdefault(typ, (struct.unpack('>I', head[:4])[0], f.read(max(0, de - ds - 8))))
    return out


def _mp4_duration(f, moov):
    m = _child(f, moov[0], moov[1], b'mvhd')
    if not m:
        return 0.0
    f.seek(m[0])
    b = f.read(32)
    if len(b) < 20:
        return 0.0
    if b[0] == 1 and len(b) >= 32:
        scale, dur = struct.unpack('>IQ', b[20:32])
    else:
        scale, dur = struct.unpack('>II', b[12:20])
    return round(dur / scale, 2) if scale else 0.0


def _mp4_chpl(f, moov):
    """Nero chapter list, what ffmpeg and most converters write."""
    boxes = [_child(f, moov[0], moov[1], b'chpl')]
    udta = _child(f, moov[0], moov[1], b'udta')
    if udta:
        boxes.append(_child(f, udta[0], udta[1], b'chpl'))
    for box in boxes:
        if not box:
            continue
        f.seek(box[0])
        data = f.read(box[1] - box[0])
        if len(data) < 9:
            continue
        out, pos = [], 9
        for _ in range(data[8]):
            if pos + 9 > len(data):
                break
            start = struct.unpack('>Q', data[pos:pos + 8])[0] / 1e7
            ln = data[pos + 8]
            pos += 9
            title = data[pos:pos + ln].decode('utf-8', 'replace').strip()
            pos += ln
            out.append({'title': title or 'Chapter %d' % (len(out) + 1),
                        'start': round(start, 3)})
        if out:
            return out
    return []


def _mp4_chapter_track(f, moov):
    """QuickTime chapter track: a text trak referenced by tref/chap."""
    traks = [(ps, pe) for typ, ps, pe in _atoms(f, moov[0], moov[1]) if typ == b'trak']
    refs = set()
    for ps, pe in traks:
        tref = _child(f, ps, pe, b'tref')
        if not tref:
            continue
        chap = _child(f, tref[0], tref[1], b'chap')
        if not chap:
            continue
        f.seek(chap[0])
        data = f.read(chap[1] - chap[0])
        for i in range(0, len(data) - 3, 4):
            refs.add(struct.unpack('>I', data[i:i + 4])[0])
    for ps, pe in traks:
        tkhd = _child(f, ps, pe, b'tkhd')
        if not tkhd:
            continue
        f.seek(tkhd[0])
        h = f.read(24)
        if len(h) < 16:
            continue
        tid = struct.unpack('>I', h[20:24] if h[0] == 1 and len(h) >= 24 else h[12:16])[0]
        if tid not in refs:
            continue
        mdia = _child(f, ps, pe, b'mdia')
        stbl = mdia and _descend(f, mdia[0], mdia[1], [b'minf', b'stbl'])
        mdhd = mdia and _child(f, mdia[0], mdia[1], b'mdhd')
        if not stbl or not mdhd:
            continue
        f.seek(mdhd[0])
        mh = f.read(32)
        if len(mh) < 20:
            continue
        scale = struct.unpack('>I', mh[20:24] if mh[0] == 1 and len(mh) >= 32 else mh[12:16])[0]
        stts = _child(f, stbl[0], stbl[1], b'stts')
        stsz = _child(f, stbl[0], stbl[1], b'stsz')
        stsc = _child(f, stbl[0], stbl[1], b'stsc')
        stco = _child(f, stbl[0], stbl[1], b'stco')
        co64 = _child(f, stbl[0], stbl[1], b'co64')
        if not (scale and stts and stsz and stsc and (stco or co64)):
            continue
        f.seek(stts[0])
        st = f.read(stts[1] - stts[0])
        f.seek(stsz[0])
        sz = f.read(stsz[1] - stsz[0])
        f.seek(stsc[0])
        sc = f.read(stsc[1] - stsc[0])
        f.seek((stco or co64)[0])
        co = f.read((stco or co64)[1] - (stco or co64)[0])
        if len(st) < 8 or len(sz) < 12 or len(sc) < 8 or len(co) < 8:
            continue
        deltas, t = [], 0.0
        for i in range(struct.unpack('>I', st[4:8])[0]):
            cnt, delta = struct.unpack('>II', st[8 + i * 8:16 + i * 8])
            for _ in range(min(cnt, 100000)):
                deltas.append(t)
                t += delta / scale
        fixed = struct.unpack('>I', sz[4:8])[0]
        n = struct.unpack('>I', sz[8:12])[0]
        sizes = [fixed] * n if fixed else [struct.unpack('>I', sz[12 + i * 4:16 + i * 4])[0]
                                           for i in range(n)]
        chunks = struct.unpack('>I', co[4:8])[0]
        width = 8 if co64 and (stco is None) else 4
        offsets = [struct.unpack('>Q' if width == 8 else '>I',
                                 co[8 + i * width:8 + i * width + width])[0]
                   for i in range(chunks)]
        runs = []
        for i in range(struct.unpack('>I', sc[4:8])[0]):
            first, per = struct.unpack('>II', sc[8 + i * 12:16 + i * 12])
            runs.append((first - 1, per))
        per_chunk = []
        for ci in range(chunks):
            per = 1
            for first, cnt in runs:
                if first <= ci:
                    per = cnt
            per_chunk.append(per)
        out, si = [], 0
        for ci, off in enumerate(offsets):
            for _ in range(per_chunk[ci]):
                if si >= len(sizes) or si >= len(deltas):
                    break
                f.seek(off)
                data = f.read(sizes[si])
                if len(data) >= 2:
                    ln = struct.unpack('>H', data[:2])[0]
                    title = data[2:2 + ln].decode('utf-8', 'replace').strip()
                    if title:
                        out.append({'title': title, 'start': round(deltas[si], 3)})
                off += sizes[si]
                si += 1
        if out:
            return out
    return []


def _track_pair(v):
    try:
        a, _, b = str(v or '').partition('/')
        return int(a or 0), int(b or 0)
    except Exception:
        return 0, 0


def _extract_cover(path, key):
    """One embedded picture (or folder.jpg) to <key>.cover, like the epub path."""
    import subprocess
    cover = os.path.join(CACHE_DIR, key + '.cover')
    mime = os.path.join(CACHE_DIR, key + '.mime')
    if os.path.exists(cover) and os.path.getsize(cover) > 256:
        return True
    try:
        proc = subprocess.run(['ffmpeg', '-y', '-nostdin', '-threads', '1', '-v', 'error',
                               '-i', path, '-map', '0:v:0', '-c', 'copy', '-frames:v', '1',
                               '-f', 'image2pipe', '-'],
                              timeout=30, capture_output=True)
        data = proc.stdout
        kind = 'image/jpeg' if data[:3] == b'\xff\xd8\xff' else \
               'image/png' if data[:8] == b'\x89PNG\r\n\x1a\n' else ''
        if kind and len(data) > 256:
            os.makedirs(CACHE_DIR, exist_ok=True)
            with open(cover, 'wb') as f:
                f.write(data)
            with open(mime, 'w') as f:
                f.write(kind)
            return True
    except Exception:
        pass
    folder = os.path.dirname(path)
    for name in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
        low = name.lower()
        if low.rsplit('.', 1)[0] in ('cover', 'folder', 'front', 'album') and \
           low.endswith(('.jpg', '.jpeg', '.png', '.webp')):
            src = os.path.join(folder, name)
            try:
                with open(src, 'rb') as f:
                    data = f.read()
                if len(data) < 256:
                    continue
                os.makedirs(CACHE_DIR, exist_ok=True)
                with open(cover, 'wb') as f:
                    f.write(data)
                with open(mime, 'w') as f:
                    f.write('image/png' if low.endswith('.png') else
                            'image/webp' if low.endswith('.webp') else 'image/jpeg')
                return True
            except Exception:
                continue
    return False


def _probe_into(info, path, key):
    """ffprobe fallback for mp3/flac/ogg/... (the MP4 path reads boxes itself)."""
    import subprocess
    try:
        proc = subprocess.run(['ffprobe', '-v', 'error', '-show_format', '-show_streams',
                               '-of', 'json', path], timeout=30, capture_output=True)
        d = json.loads(proc.stdout or b'{}')
        tags = {k.lower(): v for k, v in (d.get('format', {}).get('tags') or {}).items()}
        get = lambda *names: next((str(tags[n]).strip() for n in names if tags.get(n)), '')
        title = get('title')
        if title:
            info['title'] = title
        info['author'] = get('artist', 'album_artist', 'author')
        info['album'] = get('album')
        info['albumartist'] = get('album_artist')
        info['genre'] = get('genre')
        info['year'] = get('date', 'year')[:4]
        info['track'], info['track_total'] = _track_pair(get('track'))
        try:
            info['duration'] = round(float(d.get('format', {}).get('duration') or 0), 2)
        except Exception:
            info['duration'] = 0.0
        if _extract_cover(path, key):
            info['cover'] = True
    except Exception:
        pass


def audio_info(path):
    """Metadata, chapters and cover for an audio file, cached like book_info."""
    fallback = posixpath.splitext(os.path.basename(path))[0]
    blank = {'title': fallback, 'author': '', 'subtitle': '', 'series': '',
             'album': '', 'albumartist': '', 'track': 0, 'track_total': 0,
             'year': '', 'genre': '',
             'cover': False, 'readaloud': False, 'audio': True, 'duration': 0.0,
             'chapters': [], 'key': ''}
    try:
        st = os.stat(path)
    except OSError:
        return blank
    key = hashlib.sha1(('a1|%s|%d|%d' % (path, st.st_mtime_ns, st.st_size)).encode()).hexdigest()[:16]
    with _CACHE_LOCK:
        hit = _AINFO.get(key)
    if hit is not None:
        return hit

    info = dict(blank, key=key)
    cached = os.path.join(CACHE_DIR, key + '.audio.json')
    if os.path.exists(cached):
        try:
            with open(cached) as f:
                info.update(json.load(f))
        except Exception:
            pass
    else:
        ext = posixpath.splitext(path)[1].lower()
        if ext not in ('.m4b', '.m4a'):
            _probe_into(info, path, key)
        try:
            if ext not in ('.m4b', '.m4a'):
                raise StopIteration       # probe path fills the same fields
            with open(path, 'rb') as f:
                size = os.fstat(f.fileno()).st_size
                moov = _child(f, 0, size, b'moov')
                if moov:
                    info['duration'] = _mp4_duration(f, moov)
                    meta = (_descend(f, moov[0], moov[1], [b'udta', b'meta', b'ilst']) or
                            _descend(f, moov[0], moov[1], [b'meta', b'ilst']))
                    tags = _mp4_ilst(f, meta[0], meta[1]) if meta else {}
                    get = lambda t: (tags.get(t) or (0, b''))[1].decode('utf-8', 'replace').strip()
                    title = get(b'\xa9nam') or get(b'\xa9alb')
                    author = get(b'\xa9ART') or get(b'aART') or get(b'\xa9wrt')
                    if title:
                        info['title'] = title
                    info['author'] = author
                    info['series'] = get(b'\xa9grp')
                    info['album'] = get(b'\xa9alb')
                    info['albumartist'] = get(b'aART')
                    info['genre'] = get(b'\xa9gen')
                    info['year'] = get(b'\xa9day')[:4]
                    trk = tags.get(b'trkn')
                    if trk and len(trk[1]) >= 6:
                        info['track'], info['track_total'] = struct.unpack('>HH', trk[1][2:6])
                    covr = tags.get(b'covr')
                    if covr and covr[1]:
                        mime = {13: 'image/jpeg', 14: 'image/png', 27: 'image/bmp'}.get(covr[0], 'image/jpeg')
                        os.makedirs(CACHE_DIR, exist_ok=True)
                        with open(os.path.join(CACHE_DIR, key + '.cover'), 'wb') as cf:
                            cf.write(covr[1])
                        with open(os.path.join(CACHE_DIR, key + '.mime'), 'w') as mf:
                            mf.write(mime)
                        info['cover'] = True
                    info['chapters'] = _mp4_chpl(f, moov) or _mp4_chapter_track(f, moov)
        except StopIteration:
            pass
        except Exception:
            pass
        if info['title'] and ':' in info['title']:
            head, tail = info['title'].split(':', 1)
            if tail.strip():
                info['title'], info['subtitle'] = head.strip(), tail.strip()
        if info['cover']:
            try:
                make_thumb(os.path.join(CACHE_DIR, key + '.cover'), key)
            except Exception:
                pass
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            with open(cached, 'w') as f:
                json.dump(info, f)
        except Exception:
            pass
    with _CACHE_LOCK:
        _AINFO[key] = info
        while len(_AINFO) > 8:
            _AINFO.pop(next(iter(_AINFO)))
    return info


def media_info(path):
    return audio_info(path) if is_audio(path) else book_info(path)


def label_file(book):
    """One 576x262 crop for the tape label, made once on the play path."""
    info = media_info(book)
    key = info.get('key')
    src = os.path.join(CACHE_DIR, key + '.cover') if key else ''
    if not info.get('cover') or not src or not os.path.exists(src):
        return None
    out = os.path.join(CACHE_DIR, key + '.label3.jpg')
    if os.path.exists(out) and os.path.getsize(out) > 512:
        return out
    with _LABEL_LOCK:
        if os.path.exists(out) and os.path.getsize(out) > 512:
            return out
        import subprocess
        tmp = out + '.tmp.jpg'
        # Social-post fill: the whole cover sharp on a blurred, enlarged copy of
        # itself, so a portrait cover never leaves a flat/blank label area.
        cmd = ['ffmpeg', '-y', '-nostdin', '-threads', '1', '-v', 'error',
               '-i', src, '-filter_complex',
               '[0:v]scale=576:262:force_original_aspect_ratio=increase,crop=576:262,'
               'gblur=sigma=24,eq=brightness=-0.02:saturation=1.08[bg];'
               '[0:v]scale=576:262:force_original_aspect_ratio=decrease[fg];'
               '[bg][fg]overlay=(W-w)/2:(H-h)/2,format=yuv420p',
               '-frames:v', '1', '-q:v', '3', tmp]
        try:
            subprocess.run(cmd, timeout=30, capture_output=True)
        except Exception:
            pass
        if os.path.exists(tmp) and os.path.getsize(tmp) > 512:
            os.replace(tmp, out)
            return out
        try:
            os.unlink(tmp)
        except OSError:
            pass
    return src


def art_file(book):
    """A square print of the cover for the skins that stick it on the shell."""
    info = media_info(book)
    key = info.get('key')
    src = os.path.join(CACHE_DIR, key + '.cover') if key else ''
    if not info.get('cover') or not src or not os.path.exists(src):
        return None
    out = os.path.join(CACHE_DIR, key + '.art3.jpg')
    if os.path.exists(out) and os.path.getsize(out) > 512:
        return out
    with _LABEL_LOCK:
        if os.path.exists(out) and os.path.getsize(out) > 512:
            return out
        import subprocess
        tmp = out + '.tmp.jpg'
        try:
            subprocess.run(['ffmpeg', '-y', '-nostdin', '-threads', '1', '-v', 'error',
                            '-i', src, '-filter_complex',
                            '[0:v]scale=360:360:force_original_aspect_ratio=increase,crop=360:360,'
                            'gblur=sigma=18,eq=brightness=-0.02:saturation=1.08[bg];'
                            '[0:v]scale=344:344:force_original_aspect_ratio=decrease[fg];'
                            '[bg][fg]overlay=(W-w)/2:(H-h)/2,format=yuv420p',
                            '-frames:v', '1', '-q:v', '3', tmp], timeout=30, capture_output=True)
        except Exception:
            pass
        if os.path.exists(tmp) and os.path.getsize(tmp) > 512:
            os.replace(tmp, out)
            return out
        try:
            os.unlink(tmp)
        except OSError:
            pass
    return src



# ---- music library ------------------------------------------------------
# Tracks are grouped into albums by tag (or by folder when untagged). Per-file
# metadata is cached by audio_info, so the grouping is a listdir plus JSON reads.
def music_data(root):
    now = time.time()
    if _MUSIC['data'] is not None and _MUSIC['root'] == root and now - _MUSIC['at'] < 30:
        return _MUSIC['data']
    groups = {}
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith('.')]
        for name in files:
            if posixpath.splitext(name)[1].lower() not in MUSIC_EXTS:
                continue
            path = os.path.join(dirpath, name)
            try:
                i = audio_info(path)
            except Exception:
                continue
            album = (i.get('album') or '').strip() or os.path.basename(dirpath)
            artist = (i.get('albumartist') or i.get('author') or '').strip() or 'Unknown artist'
            key = (album.lower(), artist.lower(), '' if i.get('album') else dirpath)
            gid = hashlib.sha1(('m1|' + '|'.join(key)).encode()).hexdigest()[:10]
            g = groups.setdefault(gid, {'id': gid, 'album': album, 'artist': artist,
                                        'year': (i.get('year') or ''), 'cover': '',
                                        'tracks': [], 'duration': 0.0})
            if not g['year'] and i.get('year'):
                g['year'] = i['year']
            if not g['cover'] and i.get('cover'):
                g['cover'] = os.path.relpath(path, root).replace(os.sep, '/')
            g['tracks'].append({
                'file': os.path.relpath(path, root).replace(os.sep, '/'),
                'title': i.get('title') or name,
                'artist': artist,
                'album': album,
                'track': int(i.get('track') or 0),
                'duration': float(i.get('duration') or 0),
                'cover': bool(i.get('cover')),
            })
    albums = []
    for g in groups.values():
        g['tracks'].sort(key=lambda t: (t['track'] or 9999, t['title'].lower()))
        g['duration'] = round(sum(t['duration'] for t in g['tracks']), 1)
        if not g['cover']:
            g['cover'] = g['tracks'][0]['file'] if g['tracks'] else ''
        albums.append(g)
    albums.sort(key=lambda a: (a['artist'].lower(), a['album'].lower()))
    _MUSIC.update(at=now, root=root, data=albums)
    return albums


def music_queue(root, album='', shuffle=False):
    import random
    albums = music_data(root)
    if album:
        tracks = next((a['tracks'] for a in albums if a['id'] == album), [])
    else:
        tracks = [t for a in albums for t in a['tracks']]
    tracks = list(tracks)
    if shuffle:
        random.shuffle(tracks)
    return tracks


def bg_file(book):
    """A 640x480 blurred, darkened cover for the room behind the cassette.
    Made once (ffmpeg) so the page never runs a full-screen blur per frame."""
    info = media_info(book)
    key = info.get('key')
    src = os.path.join(CACHE_DIR, key + '.cover') if key else ''
    if not info.get('cover') or not src or not os.path.exists(src):
        return None
    out = os.path.join(CACHE_DIR, key + '.bg.jpg')
    if os.path.exists(out) and os.path.getsize(out) > 512:
        return out
    with _LABEL_LOCK:
        if os.path.exists(out) and os.path.getsize(out) > 512:
            return out
        import subprocess
        tmp = out + '.tmp.jpg'
        try:
            subprocess.run(['ffmpeg', '-y', '-nostdin', '-threads', '1', '-v', 'error',
                            '-i', src, '-vf',
                            'scale=640:480:force_original_aspect_ratio=increase,'
                            'crop=640:480,gblur=sigma=24,eq=brightness=-0.06:saturation=1.12',
                            '-q:v', '5', tmp], timeout=30, capture_output=True)
        except Exception:
            pass
        if os.path.exists(tmp) and os.path.getsize(tmp) > 512:
            os.replace(tmp, out)
            return out
        try:
            os.unlink(tmp)
        except OSError:
            pass
    return None


def palette_file(book):
    """Average colours from the cover border, for the room around the cassette.
    Decoded to 8x8 once with ffmpeg and cached next to the cover; the page uses
    the top and bottom edge colours as a soft ambience, so the black around the
    tape takes on the cover instead of staying black."""
    info = media_info(book)
    key = info.get('key')
    src = os.path.join(CACHE_DIR, key + '.cover') if key else ''
    if not info.get('cover') or not src or not os.path.exists(src):
        return {}
    out = os.path.join(CACHE_DIR, key + '.palette.json')
    try:
        with open(out) as f:
            pal = json.load(f)
        if all(k in pal for k in ('top', 'bottom', 'left', 'right', 'middle')):
            return pal
    except Exception:
        pass
    import subprocess
    try:
        proc = subprocess.run(['ffmpeg', '-y', '-nostdin', '-threads', '1', '-v', 'error',
                               '-i', src, '-vf', 'scale=8:8:flags=area',
                               '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-'],
                              timeout=30, capture_output=True)
    except Exception:
        return {}
    data = proc.stdout
    if len(data) < 192:
        return {}
    def mean(chunk):
        n = len(chunk) // 3
        return [round(sum(chunk[i * 3 + c] for i in range(n)) / n) for c in range(3)]
    rows = [data[i * 24:(i + 1) * 24] for i in range(8)]
    col = lambda c: b''.join(rows[i][c * 3:c * 3 + 3] for i in range(8))
    pal = {'top': mean(rows[0] + rows[1]),
           'bottom': mean(rows[6] + rows[7]),
           'left': mean(col(0)),
           'right': mean(col(7)),
           'middle': mean(b''.join(rows[2:6]))}
    try:
        with open(out, 'w') as f:
            json.dump(pal, f)
    except Exception:
        pass
    return pal


