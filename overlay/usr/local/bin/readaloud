function focusRow(i) {
  const r = rows();
  if (!r.length) return;
  sel = (i + r.length) % r.length;
  r[sel].focus();
  r[sel].scrollIntoView({block: 'nearest', inline: 'center'});
  styleFlow();
}
function moveFocus(step) {
  focusRow(sel + step * (view === 'grid' ? 3 : 1));
}

// iPod-style cover flow: neighbours rotate away, the focused cover faces you.
function centerFlow() {
  if (view !== 'flow') return;
  const r = rows()[sel];
  if (!r) return;
  // Measure after the transform is applied so the *visible* cover is centred.
  const el = activeEl();
  const rb = r.getBoundingClientRect(), cb = el.getBoundingClientRect();
  el.scrollLeft += (rb.left + rb.width / 2) - (cb.left + cb.width / 2);
}

function styleFlow() {
  if (view !== 'flow') return;
  rows().forEach((el, i) => {
    const d = i - sel, ad = Math.abs(d);
    const rot = d === 0 ? 0 : (d < 0 ? 1 : -1) * Math.min(70, 40 + ad * 8);
    const z = 0;   // no depth offset: GPUs here cull the cover raster at large -Z

    const scale = d === 0 ? 1.04 : Math.max(0.55, 0.90 - ad * 0.07);
    el.style.transform = 'translateZ(' + z + 'px) rotateY(' + rot + 'deg) scale(' + scale + ')';
    el.style.opacity = ad > 4 ? 0.12 : (d === 0 ? 1 : 0.85);
    el.style.zIndex = 200 - ad;
  });
  centerFlow();
}

function moveSel(i) {
  const r = rows();
  if (!r.length) return;
  sel = Math.max(0, Math.min(r.length - 1, i));
  r[sel].focus();
  r[sel].scrollIntoView({block: 'nearest', inline: 'center'});
  styleFlow();
}
