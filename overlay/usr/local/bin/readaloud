function wrapWords(d, el) {
  if (!el.dataset.raWrapped) {
    const walker = d.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    const nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    for (const t of nodes) {
      if (!/\S/.test(t.nodeValue)) continue;
      const frag = d.createDocumentFragment();
      for (const part of t.nodeValue.split(/(\s+)/)) {
        if (!part) continue;
        if (/^\s+$/.test(part)) frag.appendChild(d.createTextNode(part));
        else {
          const s = d.createElement('span');
          s.className = 'ra-word';
          const pivot = Math.min(part.length - 1,
                                 Math.max(0, Math.round(part.length * 0.3) - 1));
          const o = d.createElement('span');
          o.className = 'orp';
          o.textContent = part[pivot];
          s.append(d.createTextNode(part.slice(0, pivot)), o,
                   d.createTextNode(part.slice(pivot + 1)));
          frag.appendChild(s);
        }
      }
      t.parentNode.replaceChild(frag, t);
    }
    el.dataset.raWrapped = '1';
  }
  return [...el.querySelectorAll('.ra-word')];
}

// Word pacing. The SMIL gives one duration per par (sentence), no word timings,
// so the par is modelled as: syllables cost time, the gaps between words cost
// time, punctuation costs more. Weights are ceil(len/3) as a cheap syllable
// count; gaps are 0.05 s, 0.12 s after , ; : and 0.30 s after . ! ?. Everything
// is scaled so the par's pars still add up to end - begin.
// ponytail: a linear model, not forced alignment. It fits slow narration well
// and reads slightly ahead on fast runs; real timings would come from whisper.
function wordTimes(words, begin, end) {
  const n = words.length;
  if (!n) return [];
  const D = Math.max(0.05, end - begin);
  const even = () => {
    const per = D / n;
    return words.map((_, i) => ({start: begin + i * per, dur: per}));
  };
  const w = words.map(s => Math.max(1, Math.ceil(s.length / 3)));
  const gap = words.map(s => /[.!?]$/.test(s) ? 0.30 : /[,;:]$/.test(s) ? 0.12 : 0.05);
  const gaps = gap.slice(0, n - 1).reduce((a, b) => a + b, 0);
  const units = w.reduce((a, b) => a + b, 0);
  const a = (D - gaps) / units;                 // seconds per weight unit
  if (!(a > 0.01)) return even();
  const out = [];
  let cur = begin;
  for (let i = 0; i < n; i++) {
    const d = Math.max(0.05, a * w[i]);
    out.push({start: cur, dur: d});
    cur += d + (i < n - 1 ? gap[i] : 0);
  }
  return out;
}

let lastFilled = [];
// Exact per-word starts from a sidecar alignment file (seconds, absolute) when
// one exists; otherwise the character/gap model.
function parTimes(p, words) {
  const text = words.map(w => (typeof w === 'string' ? w : w.textContent));
  if (p.times && p.times.length === text.length) {
    return p.times.map((t, i) => ({
      start: t,
      dur: Math.max(0.05, (i + 1 < p.times.length ? p.times[i + 1] : p.end) - t),
    }));
  }
  return wordTimes(text, p.begin, p.end);
}

// Smoke hook for the test suite: parTimes must accept strings (Spritz) and
// DOM nodes (karaoke). `?check=1` reports through document.title.
if (new URLSearchParams(location.search).get('check') === '1') {
  try {
    const a = parTimes({begin: 0, end: 10}, ['a', 'bb', 'ccc']);
    const b = parTimes({begin: 0, end: 10, times: [0, 4, 7]}, ['a', 'bb', 'ccc']);
    const ok = a.length === 3 && b.length === 3 && b[1].start === 4
      && a[1].start > a[0].start && a[2].dur > 0;
    document.title = ok ? 'CHECK OK' : 'CHECK FAIL';
  } catch (e) {
    document.title = 'CHECK ERROR ' + e.message;
  }
}


// ---- UI self-tests (?check=ui): clicks and gamepad, no human needed ----
async function runUITests() {
  const results = [];

  const check = async (name, fn) => {
    try { await fn(); results.push(name + ' PASS'); }
    catch (e) { results.push(name + ' FAIL ' + ((e && e.message) || e)); }
  };
  const assert = (c, m) => { if (!c) throw new Error(m || 'assert'); };

  const pad = {index: 0, buttons: Array.from({length: 18}, () => ({pressed: false}))};
  navigator.getGamepads = () => [pad];
  const tap = i => {
    pad.buttons[i].pressed = true;
    padTick();
    pad.buttons[i].pressed = false;
    padTick();
  };

  await check('toc button opens picker', async () => {
    document.getElementById('tocbtn').click();
    assert(tocOpen, 'picker did not open');
  });
  await check('spritz row reacts to click', async () => {
    const row = tocRows.find(r => /Spritz view/.test(r.textContent));
    assert(row, 'no spritz row');
    row.click();
    assert(spritz === true, 'spritz did not toggle');
    setSpritz(false);
  });
  await check('tape view toggles', async () => {
    setTape(true);
    assert(document.body.classList.contains('tape'), 'tape did not open');
    setTape(false);
    assert(!document.body.classList.contains('tape'), 'tape did not close');
  });
  await check('skins cycle', async () => {
    const before = tapeSkin;
    cycleSkin();
    assert(tapeSkin !== before, 'skin unchanged');
    applySkin(before);
  });
  await check('skin sheet previews and cancels', async () => {
    setTape(true);
    openSkins();
    assert(skOpen, 'sheet did not open');
    assert(skCards.length === SKINS.length, 'missing tiles');
    skCards.find(c => c.dataset.skin === 'chrome').focus();
    assert(document.getElementById('tape').dataset.skin === 'chrome', 'no live preview');
    closeSkins(false);
    assert(tapeSkin === 'label', 'cancel did not restore');
    setTape(false);
  });
  await check('chapter row click jumps', async () => {
    openToc();
    const before = sec;
    const target = tocRows[tocRows.length - 1];
    target.click();
    assert(!tocOpen, 'picker stayed open');
    assert(sec !== before || data.sections.length === 1, 'chapter unchanged');
  });
  await check('pad opens picker', async () => {
    await tap(8);
    assert(tocOpen, 'pad did not open picker');
  });
  await check('pad moves selection', async () => {
    const before = tocSel;
    await tap(13);
    assert(tocSel > before, 'selection did not move');
  });
  await check('pad activates selection', async () => {
    while (tocSel < tocRows.length - 1) tap(13);      // walk to a chapter row
    tap(0);
    assert(!tocOpen, 'picker did not close on pad A');
  });
  await check('pad A toggles playback', async () => {
    const before = autoplay;
    await tap(0);
    assert(autoplay !== before, 'play state unchanged');
    autoplay = false;
    audio.pause();
  });
  await check('pad X grows the text', async () => {
    const before = fontPct;
    await tap(2);
    assert(fontPct > before, 'font size unchanged');
  });
  await check('pad up raises speed', async () => {
    const before = narrated ? rate : wpm;
    await tap(12);
    const after = narrated ? rate : wpm;
    assert(after > before, 'speed unchanged');
  });
  await check('pad shoulder changes chapter', async () => {
    const before = sec;
    await tap(5);
    assert(sec !== before || data.sections.length === 1, 'chapter unchanged');
  });
  await check('scrubber seeks', async () => {
    seekFrac(0.5);
    if (narrated && pars().length > 1) assert(par > 0, 'par not moved');
    assert(Math.abs(scrubFrac() - 0.5) < 0.25, 'position not applied');
  });
  await check('picker cycles theme', async () => {
    const before = currentThemeId();
    cycleTheme();
    assert(currentThemeId() !== before, 'theme unchanged');
    applyTheme(before);
  });
  await check('speed buttons click', async () => {
    const before = rate;
    document.getElementById('fast').click();
    assert(rate > before, 'rate unchanged');
    document.getElementById('slow').click();
    document.getElementById('slow').click();
    assert(rate < before + 0.01, 'rate did not drop');
  });

  const pass = results.filter(r => r.includes(' PASS')).length;
  document.title = 'UITESTS ' + pass + '/' + results.length + ' ' + results.join(' | ');
}


