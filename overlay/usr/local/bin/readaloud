const themeById = id => THEMES.find(t => t.id === id) || THEMES[0];
function currentThemeId() {
  let id = 'midnight';
  try { id = localStorage.getItem('ra:theme') || 'midnight'; } catch (e) {}
  const forced = new URLSearchParams(location.search).get('theme');
  if (forced && THEMES.some(t => t.id === forced)) id = forced;
  return themeById(id).id;
}

function applyTheme(id) {
  const t = themeById(id);
  const r = document.documentElement.style;
  r.setProperty('--bg', t.bg);
  r.setProperty('--panel', t.panel);
  r.setProperty('--card', t.card);
  r.setProperty('--text', t.text);
  r.setProperty('--dim', t.dim);
  r.setProperty('--line', t.line);
  r.setProperty('--accent', t.accent);
  r.setProperty('--accent2', t.accent2);
  r.setProperty('--page', t.page);
  r.setProperty('--ink', t.ink);
  r.setProperty('color-scheme', (t.bg === '#f5f2ec' || t.bg === '#efe9dd') ? 'light' : 'dark');
  try { localStorage.setItem('ra:theme', t.id); } catch (e) {}
  const d = f.contentDocument;
  if (d && d.documentElement) {
    d.documentElement.style.setProperty('--ra-accent', t.accent);
    d.documentElement.style.setProperty('--ra-accent2', t.accent2);
    d.documentElement.style.setProperty('--ra-page', t.page);
    d.documentElement.style.setProperty('--ra-ink', t.ink);
  }
  return t;
}

function cycleTheme() {
  const cur = THEMES.findIndex(t => t.id === currentThemeId());
  const next = THEMES[(cur + 1) % THEMES.length];
  applyTheme(next.id);
  renderToc();
  return next.name;
}

function karaoke() {
  if (tapeMode) return;
  const d = ensureStyle();
  const p = cur();
  if (!d || !p) return;
  const el = d.getElementById(p.frag);
  if (!el) return;
  const words = wrapWords(d, el);
  if (!words.length) return;
  const times = parTimes(p, words);
  const now = audio.currentTime;
  // Only the live sentence keeps its fill; earlier ones would paint the page amber.
  if (lastFilled !== words) {
    lastFilled.forEach(w => {
      w.classList.remove('ra-fill', 'ra-done');
      w.style.animation = 'none';
    });
    lastFilled = words;
  }
  const todo = [];
  words.forEach((w, i) => {
    const t = times[i];
    w.style.animation = 'none';
    w.classList.add('ra-fill');
    w.classList.toggle('ra-done', now >= t.start + t.dur);
    if (now < t.start + t.dur) {
      const off = Math.max(0, t.start - now) / rate;
      const len = Math.max(0.06, (t.start + t.dur - Math.max(t.start, now)) / rate);
      w.style.setProperty('--delay', off.toFixed(3) + 's');
      w.style.setProperty('--dur', len.toFixed(3) + 's');
      todo.push(w);
    }
  });
  void el.offsetWidth;
  todo.forEach(w => { w.style.animation = ''; });
  d.documentElement.classList.toggle('ra-paused', audio.paused);
}

function hl() {
  if (tapeMode) { updateTape(); return; }
  const d = ensureStyle();
  if (!d) return;
  d.querySelectorAll('.ra-hl').forEach(e => e.classList.remove('ra-hl'));
  const p = cur();
  if (!p || !p.frag) return;
  const el = d.getElementById(p.frag);
  if (!el) return;
  el.classList.add('ra-hl');
  karaoke();
  const r = el.getBoundingClientRect(), h = f.contentWindow.innerHeight;
  if (r.top < 40 || r.bottom > h - 40) el.scrollIntoView({block: 'center'});
}

// ---- scrubber -----------------------------------------------------------
const scrub = document.getElementById('scrub');
const scrubFill = document.getElementById('scrubfill');
const scrubGrab = document.getElementById('scrubgrab');

function scrubFrac() {
  if (!data) return 0;
  if (narrated) {
    const ps = pars();
    if (!ps.length) return 0;
    const a = ps[0].begin, b = ps[ps.length - 1].end;
    return b > a ? Math.min(1, Math.max(0, (audio.currentTime - a) / (b - a))) : 0;
  }
  const n = wpWords ? wpWords.length : 0;
  return n ? Math.min(1, wpIdx / n) : 0;
}

function paintScrub(f) {
  const pct = (Math.min(1, Math.max(0, f)) * 100).toFixed(2) + '%';
  scrubFill.style.width = pct;
  scrubGrab.style.left = pct;
}

function seekFrac(f) {
  if (!data) return;
  f = Math.min(0.999, Math.max(0, f));
  if (narrated) {
    const ps = pars();
    if (!ps.length) return;
    par = Math.min(ps.length - 1, Math.floor(f * ps.length));
    seekPar();
    const el = f.contentDocument && f.contentDocument.querySelector('.ra-hl');
    if (el) el.scrollIntoView({block: 'center'});
  } else {
    if (!wpWords) wpWords = wrapSection().map(s => s.textContent);
    if (!wpWords.length) return;
    wpIdx = Math.min(wpWords.length - 1, Math.floor(f * wpWords.length));
    if (wpmTimer) { stopWpm(); startWpm(); }
    else { markWord(wpIdx); if (spritz) renderWord(wpWords[wpIdx]); }
  }
  paintScrub(f);
  save();
}

let dragging = false;
const fracAt = e => {
  const r = scrub.getBoundingClientRect();
  return r.width ? (e.clientX - r.left) / r.width : 0;
};
scrub.addEventListener('pointerdown', e => {
  dragging = true;
  try { scrub.setPointerCapture(e.pointerId); } catch (err) {}
  paintScrub(fracAt(e));
});
scrub.addEventListener('pointermove', e => { if (dragging) paintScrub(fracAt(e)); });
scrub.addEventListener('pointerup', e => {
  if (!dragging) return;
  dragging = false;
  seekFrac(fracAt(e));
});
scrub.addEventListener('pointercancel', () => { dragging = false; });

// ---- chapter picker -----------------------------------------------------
let tocOpen = false, tocSel = 0, tocRows = [];

function chapterName(i) {
  const s = data.sections[i] || {};
  return s.label || s.title || ('Section ' + (i + 1));
}

// ---- listen-only tape (the same audio element, so switching is seamless) ----
let tapeMode = false, tapeDur = null, tapeSkin = 'label';
const SKINS = ['label', 'studio', 'slim', 'paper', 'chrome', 'clear', 'wood', 'vinyl', 'minidisc', 'walkman', 'cart', 'boombox'];
const SKIN_NAMES = {label: 'Mixtape', studio: 'Studio', slim: 'Slim', paper: 'Paper',
  chrome: 'Chrome', clear: 'Clear', wood: 'Wood', vinyl: 'Vinyl', minidisc: 'MiniDisc',
  walkman: 'Walkman', cart: '8-Track', boombox: 'Boombox'};
try { tapeSkin = localStorage.getItem('ra:skin') || 'label'; } catch (e) {}
const forcedSkinR = new URLSearchParams(location.search).get('skin');
if (SKINS.includes(forcedSkinR)) tapeSkin = forcedSkinR;
if (!SKINS.includes(tapeSkin)) tapeSkin = 'label';

function applySkin(id, savePref) {
  if (!SKINS.includes(id)) id = 'label';
  tapeSkin = id;
  const t = document.getElementById('tape');
  if (t) t.dataset.skin = id;
  if (savePref !== false) { try { localStorage.setItem('ra:skin', id); } catch (e) {} }
}
function cycleSkin() {
  applySkin(SKINS[(SKINS.indexOf(tapeSkin) + 1) % SKINS.length]);
  if (tocOpen) renderToc();
}

// ---- skin picker: a filmstrip with the real cover in every skin ----
let skOpen = false, skCards = [], skSel = 0, skBefore = 'label';
function renderSkins() {
  const g = document.getElementById('skingrid');
  if (!g) return;
  g.textContent = '';
  skCards = [];
  for (const id of SKINS) {
    const c = document.createElement('div');
    c.className = 'skcard';
    c.dataset.skin = id;
    c.tabIndex = 0;
    const t = document.createElement('div');
    t.className = 'skthumb';
    const im = document.createElement('img');
    im.alt = '';
    im.src = '/cover/' + encodeURIComponent(BOOK);
    im.onerror = () => { im.style.display = 'none'; };
    t.appendChild(im);
    for (const k of ['a', 'b']) {
      const b = document.createElement('b');
      b.className = k;
      t.appendChild(b);
    }
    const n = document.createElement('span');
    n.className = 'skname';
    n.textContent = SKIN_NAMES[id];
    c.append(t, n);
    c.onfocus = () => {
      skSel = skCards.indexOf(c);
      applySkin(id, false);
      document.getElementById('skinnow').textContent = SKIN_NAMES[id];
      c.scrollIntoView({inline: 'center', block: 'nearest'});
    };
    c.onclick = () => { applySkin(id, true); closeSkins(true); };
    g.appendChild(c);
    skCards.push(c);
  }
}
function openSkins() {
  const cur = document.getElementById('tape').dataset.skin || 'label';
  skBefore = cur;
  renderSkins();
  skOpen = true;
  document.getElementById('skins').classList.add('open');
  document.getElementById('skinnow').textContent = SKIN_NAMES[cur] || '';
  const i = Math.max(0, SKINS.indexOf(cur));
  if (skCards[i]) skCards[i].focus();
}
function closeSkins(commit) {
  if (!skOpen) return;
  skOpen = false;
  document.getElementById('skins').classList.remove('open');
  if (!commit) applySkin(skBefore, false);
}
function skinStep(d) {
  if (!skCards.length) return;
  skinStep.at = ((skSel + d) % skCards.length + skCards.length) % skCards.length;
  skCards[skinStep.at].focus();
}
document.getElementById('skinsx').onclick = () => closeSkins(false);

const fmtT = t => {
  t = Math.max(0, Math.floor(t || 0));
  const h = Math.floor(t / 3600), m = Math.floor(t / 60) % 60, s = t % 60;
  return (h ? h + ':' + String(m).padStart(2, '0') : String(m)) +
    ':' + String(s).padStart(2, '0');
};

// Total audio time is not in the epub: each section's SMIL gives its own clock.
// Sum the section spans for the label and the elapsed estimate; seeking stays
// on the parser's section/par fraction, which is exact.
function tapeTotals() {
  if (!tapeDur) {
    const durs = data.sections.map(s => {
      if (!s.pars || !s.pars.length) return 0;
      let a = Infinity, b = 0;
      for (const p of s.pars) { a = Math.min(a, p.begin); b = Math.max(b, p.end); }
      return Math.max(0, b - a);
    });
    tapeDur = {durs, total: durs.reduce((x, y) => x + y, 0)};
  }
  let done = 0;
  for (let i = 0; i < sec; i++) done += tapeDur.durs[i] || 0;
  const ps = pars();
  if (ps.length) {
    done += Math.min(tapeDur.durs[sec] || 0,
                     Math.max(0, audio.currentTime - ps[0].begin));
  }
  return {done, total: tapeDur.total};
}

function tapeInit() {
  if (!data) return;
  const ttl = (data.title || '') + (data.subtitle ? ': ' + data.subtitle : '');
  document.getElementById('ttl').textContent = ttl;
  document.getElementById('aut').textContent = data.author || '';
  document.getElementById('tagline').textContent = data.title || '';
  document.getElementById('topaut').textContent = data.author || '';
  document.getElementById('slimaut').textContent = data.author || '';
  const art = '/art/' + encodeURIComponent(BOOK);
  const cov = document.getElementById('cov');
  cov.src = '/label/' + encodeURIComponent(BOOK);
  cov.onerror = () => { cov.style.visibility = 'hidden'; };
  for (const id of ['stk', 'slimcov', 'big']) {
    const im = document.getElementById(id);
    im.src = art;
    im.onerror = () => { im.style.visibility = 'hidden'; };
  }
  const bl = document.getElementById('blurimg');
  if (bl) { bl.src = '/bg/' + encodeURIComponent(BOOK); }
  const shc = document.getElementById('slimheadcov');
  if (shc) { shc.src = '/label/' + encodeURIComponent(BOOK); }
  if (!tapeInit.palette) {
    tapeInit.palette = true;
    fetch('/colors/' + encodeURIComponent(BOOK)).then(r => r.json()).then(c => {
      const st = document.documentElement.style;
      if (c.top) st.setProperty('--amb-top', 'rgb(' + c.top.join(',') + ')');
      if (c.bottom) st.setProperty('--amb-bot', 'rgb(' + c.bottom.join(',') + ')');
      if (c.left) st.setProperty('--amb-left', 'rgb(' + c.left.join(',') + ')');
      if (c.right) st.setProperty('--amb-right', 'rgb(' + c.right.join(',') + ')');
    }).catch(() => {});
  }
  const tt = tapeTotals();
  document.getElementById('dur').textContent = fmtT(tt.total);
}

function updateTape() {
  if (!tapeMode || !data) return;
  const f = scrubFrac(), pct = Math.round(f * 100);
  const t = document.getElementById('tape');
  t.style.setProperty('--pa', (0.62 + 0.38 * (1 - f)).toFixed(3));
  t.style.setProperty('--pb', (0.62 + 0.38 * f).toFixed(3));
  const tt = tapeTotals();
  document.getElementById('counter').textContent = fmtT(tt.done);
  document.getElementById('pct').textContent = pct + '%';
  document.getElementById('slimtime').textContent = fmtT(tt.done);
  document.getElementById('slimpct').textContent = 'read along \u00b7 ' + pct + '%';
  document.getElementById('stkcap').textContent =
    'CH ' + String(sec + 1).padStart(2, '0') + ' \u00b7 ' + pct + '%';
  document.getElementById('rednum').textContent = String(sec + 1).padStart(2, '0');
  const total = data.sections.length;
  document.getElementById('chp').textContent =
    'Ch ' + (sec + 1) + '/' + total + ' \u00b7 ' + chapterName(sec);
  document.getElementById('slimline').textContent =
    (data.title || '') + '  \u00b7  Ch ' + (sec + 1) + '/' + total;
  document.body.classList.toggle('playing', isPlaying());
}

function setTape(on, savePref) {
  tapeMode = !!on && narrated;
  document.body.classList.toggle('tape', tapeMode);
  if (tapeMode) {
    if (spritz) setSpritz(false);
    tapeInit();
    updateTape();
  } else {
    hl();
  }
  if (savePref !== false) {
    try { localStorage.setItem('ra:tape', tapeMode ? '1' : '0'); } catch (e) {}
  }
  const tb = document.getElementById('tapebtn');
  if (tb) tb.classList.toggle('on', tapeMode);
  if (tapeMode) scheduleXoff();
  else { clearTimeout(xoffTimer); wakeScreen(); }
  showUI();
}
applySkin(tapeSkin, false);
const xoffEnabled = () => tapeMode;

// ---- display off after inactivity ---------------------------------------
let xoffMin = 3, xoffTimer = null, screenOff = false, lastAct = 0;
try {
  const v = localStorage.getItem('ra:xoff');
  if (v !== null) xoffMin = Math.max(0, +v || 0);
} catch (e) {}
const forceXoff = new URLSearchParams(location.search).get('xoff');
if (forceXoff !== null) xoffMin = Math.max(0, parseFloat(forceXoff) || 0);
function scheduleXoff() {
  clearTimeout(xoffTimer);
  if (!xoffEnabled() || xoffMin <= 0) return;
  xoffTimer = setTimeout(sleepScreen, xoffMin * 60000);
}
function sleepScreen() {
  if (screenOff || !xoffEnabled() || xoffMin <= 0) return;
  screenOff = true;
  document.body.classList.add('screenoff');
  fetch('/screen/off').catch(() => {});
}
function wakeScreen() {
  if (!screenOff) return;
  screenOff = false;
  document.body.classList.remove('screenoff');
  fetch('/screen/on').catch(() => {});
}
function activity() {
  wakeScreen();
  const now = Date.now();
  if (now - lastAct > 800) { lastAct = now; scheduleXoff(); }
}
document.addEventListener('pointerdown', activity);
document.addEventListener('pointermove', activity);
document.addEventListener('mousemove', activity);
document.addEventListener('wheel', activity, {passive: true});
document.addEventListener('touchmove', activity, {passive: true});
function cycleXoff() {
  const vals = [1, 3, 5, 10, 0];
  const i = vals.indexOf(xoffMin);
  xoffMin = vals[(i < 0 ? 1 : i + 1) % vals.length];
  try { localStorage.setItem('ra:xoff', xoffMin); } catch (e) {}
  scheduleXoff();
  if (tocOpen) renderToc();
}
function xoffLabel() { return xoffMin ? xoffMin + ' min' : 'never'; }

scheduleXoff();

let tocActions = [];

function renderToc() {
  const body = document.getElementById('tocbody');
  body.textContent = '';
  tocRows = [];
  tocActions = [];
  const add = (text, num, cls, action) => {
    const d = document.createElement('div');
    d.className = 'tocrow ' + (cls || '');
    const n = document.createElement('span');
    n.className = 'n';
    n.textContent = num;
    const l = document.createElement('span');
    l.className = 'l';
    l.textContent = text;
    d.append(n, l);
    d.onclick = () => {
      tocSel = tocRows.indexOf(d);
      markToc();
      tocActivate();
    };
    body.appendChild(d);
    tocRows.push(d);
    tocActions.push(action);
  };
  if (narrated) {
    add('Tape view: ' + (tapeMode ? 'on' : 'off'), '\u25a4', 'tog',
        () => { setTape(!tapeMode); renderToc(); });
    add('Tape skins: ' + SKIN_NAMES[tapeSkin] + '  \u25b8', '\u25a3', 'tog',
        () => { closeToc(); if (!tapeMode) setTape(true); openSkins(); });
  }
  add('Spritz view: ' + (spritz ? 'on' : 'off'), '\u25cf', 'tog',
      () => { setSpritz(!spritz); renderToc(); });
  add('Theme: ' + themeById(currentThemeId()).name + '  \u25b8', '\u25d1', 'tog',
      () => { cycleTheme(); });
  add('Controls auto-hide: ' + (zen ? 'on' : 'off'), '\u25cc', 'tog',
      () => { zen = !zen; try { localStorage.setItem('ra:zen', zen ? '1' : '0'); } catch (e) {}
              renderToc(); showUI(); });
  add('Screen off: ' + xoffLabel() + '  \u25b8', '\u25d3', 'tog', () => cycleXoff());
  data.sections.forEach((s, i) => add(chapterName(i), i + 1, i === sec ? 'cur' : '',
      () => { closeToc(); jumpTo(i, !audio.paused || !!wpmTimer); }));
  tocSel = 0;
  markToc();
}

function markToc() {
  tocRows.forEach((r, i) => r.classList.toggle('sel', i === tocSel));
  if (tocRows[tocSel]) tocRows[tocSel].scrollIntoView({block: 'nearest'});
}

function openToc() {
  if (!data) return;
  tocOpen = true;
  showUI(0);
  renderToc();
  document.getElementById('toc').style.display = 'flex';
}

function closeToc() {
  tocOpen = false;
  document.getElementById('toc').style.display = 'none';
  showUI();
}

function jumpTo(i, play) {
  if (!data || i < 0 || i >= data.sections.length) return;
  if (narrated) { goto(i, 0, play); return; }
  stopWpm();
  sec = i;
  wpWords = null;
  wpIdx = 0;
  pendingWpm = !!play;
  showSection();
  save();
}

function tocActivate() {
  const a = tocActions[tocSel];
  if (a) a();
}

document.getElementById('tocbtn').onclick = () => (tocOpen ? closeToc() : openToc());

// ---- zen: the chrome hides itself while you listen ----------------------
let zen = true;
try { zen = localStorage.getItem('ra:zen') !== '0'; } catch (e) {}
let hideTimer = null;
const isPlaying = () => (narrated ? !audio.paused : !!wpmTimer);
function showUI(ms) {
  document.body.classList.remove('zen');
  clearTimeout(hideTimer);
  if (zen && ms !== 0 && isPlaying() && !tapeMode) {
    hideTimer = setTimeout(() => { if (!tocOpen) document.body.classList.add('zen'); },
                           ms || 3200);
  }
}
document.addEventListener('pointermove', () => showUI());
document.addEventListener('pointerdown', () => showUI());

function loadOff() {
  const l = document.getElementById('load');
  if (l) l.style.display = 'none';
}

let spritz = false, spzKey = '';
let narrated = true, wpm = 300, wpmTimer = null, wpIdx = 0, pendingWpm = false;
try { wpm = Math.min(900, Math.max(60, +(localStorage.getItem('ra:wpm') || 300) || 300)); } catch (e) {}
function setSpritz(on) {
  if (on && tapeMode) setTape(false);
  spritz = on;
  showUI();
  spzKey = '';
  document.getElementById('spritz').style.display = on ? 'flex' : 'none';
  f.style.display = on ? 'none' : 'block';
  document.getElementById('spzbtn').classList.toggle('on', on);
  if (on && !narrated && wpWords) renderWord(wpWords[Math.max(0, wpIdx - 1)]);
  else if (on) drawSpritz();
}

function renderWord(w) {
  const pivot = Math.min(w.length - 1, Math.max(0, Math.round(w.length * 0.3) - 1));
  const node = document.getElementById('spz');
  node.textContent = '';
  const orp = document.createElement('span');
  orp.className = 'orp';
  orp.textContent = w[pivot];
  node.append(document.createTextNode(w.slice(0, pivot)), orp,
              document.createTextNode(w.slice(pivot + 1)));
  // Proportional glyphs make an index-based offset approximate, so measure the
  // rendered ORP box and centre *that* on the guide line.
  node.style.transform = 'none';
  const wr = node.getBoundingClientRect();
  const or = orp.getBoundingClientRect();
  const dx = (or.left + or.width / 2) - (wr.left + wr.width / 2);
  node.style.transform = 'translateX(' + (-dx).toFixed(1) + 'px)';
}

// Words-per-minute reader for books without narration: wrap the whole section
// once so the live word can be marked on the page, not only in the Spritz view.
let sectionSpans = null, curSpan = null, wpWords = null;

function wrapSection() {
  const d = f.contentDocument;
  if (!d || !d.body) return [];
  if (sectionSpans) return sectionSpans;
  const spans = [];
  const walker = d.createTreeWalker(d.body, NodeFilter.SHOW_TEXT);
  const nodes = [];
  while (walker.nextNode()) nodes.push(walker.currentNode);
  for (const t of nodes) {
    if (!/\S/.test(t.nodeValue)) continue;
    const parent = t.parentNode;
    if (!parent || (parent.closest && parent.closest('script,style'))) continue;
    const frag = d.createDocumentFragment();
    for (const part of t.nodeValue.split(/(\s+)/)) {
      if (!part) continue;
      if (/^\s+$/.test(part)) { frag.appendChild(d.createTextNode(part)); continue; }
      const s = d.createElement('span');
      s.className = 'ra-word';
      const pivot = Math.min(part.length - 1,
                             Math.max(0, Math.round(part.length * 0.3) - 1));
      const o = d.createElement('span');
      o.className = 'orp';
      o.textContent = part[pivot];
      s.append(d.createTextNode(part.slice(0, pivot)), o,
               d.createTextNode(part.slice(pivot + 1)));
      frag.appendChild(s);
      spans.push(s);
    }
    parent.replaceChild(frag, t);
  }
  sectionSpans = spans;
  return spans;
}

function markWord(i) {
  if (!sectionSpans || !sectionSpans.length) return;
  const s = sectionSpans[Math.min(i, sectionSpans.length - 1)];
  if (curSpan && curSpan !== s) curSpan.classList.remove('ra-cur');
  s.classList.add('ra-cur');
  curSpan = s;
  const r = s.getBoundingClientRect(), h = f.contentWindow.innerHeight;
  if (r.top < 40 || r.bottom > h - 40) s.scrollIntoView({block: 'center'});
}

function stopWpm() {
  if (wpmTimer) { clearInterval(wpmTimer); wpmTimer = null; }
  pp.innerHTML = '&#9654;';
  showUI(0);
}

function startWpm() {
  stopWpm();
  if (!wpWords || !wpWords.length) wpWords = wrapSection().map(s => s.textContent);
  if (!wpWords.length) {                 // cover or blank spread: move on
    if (sec + 1 < data.sections.length) nextSection(true);
    return;
  }
  const step = () => {
    if (wpIdx >= wpWords.length) { wpWords = null; wpIdx = 0; nextSection(true); return; }
    markWord(wpIdx);
    if (spritz) renderWord(wpWords[wpIdx]);
    wpIdx++;
    if (!dragging) paintScrub(scrubFrac());
    save();
  };
  step();
  wpmTimer = setInterval(step, 60000 / wpm);
  pp.innerHTML = '&#10074;&#10074;';
  showUI();
}

// Spritz/RSVP: one word at a time, the recognition point pinned to the centre
// line, paced by the narration so it stays a read-along and not a timer.
let spzCache = null;

function drawSpritz() {
  if (!spritz || !narrated) return;
  const p = cur();
  const d = f.contentDocument;
  if (!p || !d) return;
  const ckey = sec + ':' + par;
  if (!spzCache || spzCache.key !== ckey) {
    const el = d.getElementById(p.frag);
    if (!el) return;
    const words = el.textContent.trim().split(/\s+/).filter(Boolean);
    if (!words.length) return;
    spzCache = {key: ckey, words, times: parTimes(p, words)};
  }
  const {words, times} = spzCache;
  const t = audio.currentTime;
  let i = 0;
  while (i + 1 < times.length && times[i + 1].start <= t) i++;
  const key = sec + ':' + par + ':' + i;
  if (key === spzKey) return;
  spzKey = key;
  renderWord(words[i]);
}

function showSection() {
  const name = (data.title || '') + (data.subtitle ? ': ' + data.subtitle : '');
  titleEl.textContent = name + '  \u00b7  ' + (sec + 1) + '/' + data.sections.length;
  const src = url(data.sections[sec].href);
  if (f.dataset.src !== src) {
    f.dataset.src = src;
    f.onload = () => {
      applyTheme(currentThemeId());
      hl();
      loadOff();
      sectionSpans = null;
      curSpan = null;
      spzCache = null;
      if (pendingWpm) { pendingWpm = false; wpWords = null; wpIdx = 0; startWpm(); }
    };
    f.src = src;
  }
}

function seekPar() {
  if (!narrated) { showSection(); return; }
  const p = cur(), src = url(p.audio);
  const start = (resumeAt != null && resumeAt >= p.begin && resumeAt < p.end) ? resumeAt : p.begin;
  resumeAt = null;
  showSection();
  hl();
  if (audioSrc !== src) {
    audioSrc = src;
    audio.src = src;
    applyRate();
    audio.onloadedmetadata = () => {
      applyRate();
      audio.currentTime = start;
      if (autoplay) audio.play().catch(() => {});
    };
  } else {
    audio.currentTime = start;
  }
}

function goto(s, p, play) {
  sec = Math.max(0, Math.min(data.sections.length - 1, s));
  par = Math.max(0, Math.min(pars().length - 1, p || 0));
  autoplay = !!play;
  seekPar();
  if (play) audio.play().catch(() => {});
  save();
}

function nextSection(play) {
  if (!narrated) {
    if (sec + 1 >= data.sections.length) { stopWpm(); return; }
    stopWpm();
    sec++;
    wpWords = null;
    wpIdx = 0;
    pendingWpm = play;
    showSection();
    save();
    return;
  }
  if (sec + 1 < data.sections.length) goto(sec + 1, 0, play);
}

function toggle() {
  if (!narrated) {
    if (wpmTimer) { autoplay = false; stopWpm(); }
    else { autoplay = true; startWpm(); }
    return;
  }
  if (audio.paused) { autoplay = true; audio.play().catch(() => {}); }
  else { autoplay = false; audio.pause(); }
}

function setRate(r) {
  if (!narrated) {
    wpm = Math.min(900, Math.max(60, Math.round((wpm + (r > rate ? 30 : -30)) / 10) * 10));
    rateEl.textContent = wpm + ' wpm';
    try { localStorage.setItem('ra:wpm', wpm); } catch (e) {}
    if (wpmTimer) { stopWpm(); startWpm(); }
    save();
    return;
  }
  rate = Math.min(3, Math.max(0.4, Math.round(r * 100) / 100));
  applyRate();
  try { localStorage.setItem('ra:rate', rate); } catch (e) {}
  rateEl.textContent = rate.toFixed(2) + 'x';
  karaoke();     // animations are timed in wall-clock, so re-lay them out
  save();
}

function save() {
  try {
    if (!data || !data.sections.length) return;
    let pct;
    if (narrated) {
      pct = Math.min(1, (sec + (par + 1) / pars().length) / data.sections.length);
    } else {
      const n = wpWords ? wpWords.length : 0;
      pct = Math.min(1, (sec + (n ? wpIdx / n : 0)) / data.sections.length);
    }
    localStorage.setItem('ra:' + BOOK, JSON.stringify({
      sec, par, t: audio.currentTime, rate, wpm, word: wpIdx, pct,
      total: data.sections.length, narration: narrated, at: Date.now(),
    }));
  } catch (e) {}
}

function advance() {
  const ps = pars(), p = ps[par];
  if (par + 1 < ps.length) {
    par++;
    if (ps[par].audio !== p.audio) seekPar();   // chapter switched audio file
    else { hl(); save(); }
  } else nextSection(autoplay);
}

audio.ontimeupdate = () => {
  if (!dragging) paintScrub(scrubFrac());
  if (tapeMode) updateTape();
  const ps = pars(), t = audio.currentTime;
  while (par + 1 < ps.length && ps[par + 1].audio === ps[par].audio
         && ps[par + 1].begin <= t + 0.05) { par++; hl(); }
  if (t >= ps[par].end - 0.05) advance();
};
audio.onplay = () => { applyRate(); pp.innerHTML = '&#10074;&#10074;'; document.body.classList.add('playing');
  fetch('/player/on').catch(() => {}); karaoke(); showUI(); };
audio.onpause = () => { pp.innerHTML = '&#9654;'; document.body.classList.remove('playing');
  fetch('/player/off').catch(() => {}); karaoke(); showUI(0); };
audio.onerror = () => { titleEl.textContent = 'audio error: ' + audio.error.code; };

pp.onclick = toggle;
document.getElementById('slow').onclick = () => setRate(rate - 0.1);
document.getElementById('fast').onclick = () => setRate(rate + 0.1);
document.getElementById('spzbtn').onclick = () => setSpritz(!spritz);
document.getElementById('tapebtn').onclick = () => setTape(!tapeMode);

function pollStatus() {
  fetch('/api/status').then(r => r.json()).then(s => {
    const b = document.getElementById('batt');
    if (s.level != null) {
      b.textContent = (s.charging ? '\u26a1' : '') + s.level + '%';
      b.classList.toggle('low', s.level <= 15 && !s.charging);
    }
  }).catch(() => {});
}
pollStatus();
setInterval(pollStatus, 60000);

function back() {
  audio.pause();
  save();
  fetch('/screen/on').catch(() => {});
  fetch('/player/off').catch(() => {});
  location.href = '/';
}
document.getElementById('quit').onclick = back;

function onKey(e) {
  showUI();
  activity();
  if (skOpen) {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { skinStep(1); e.preventDefault(); return; }
    if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { skinStep(-1); e.preventDefault(); return; }
    if (e.key === 'Enter' || e.key === ' ') { closeSkins(true); e.preventDefault(); return; }
    if (e.key === 'Escape' || e.key === 'k') { closeSkins(false); return; }
  }
  if (e.key === 'K') { openSkins(); return; }
  if (e.key === 'Escape') { if (tocOpen) { closeToc(); return; } back(); return; }
  if (tocOpen) {
    if (e.key === 'ArrowDown' || e.key === 'j') { tocSel = Math.min(tocRows.length - 1, tocSel + 1); markToc(); }
    else if (e.key === 'ArrowUp' || e.key === 'k') { tocSel = Math.max(0, tocSel - 1); markToc(); }
    else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); tocActivate(); }
    else if (e.key === 'c') closeToc();
    return;
  }
  if (e.key === 'c') { openToc(); return; }
  if (e.key === ' ') { e.preventDefault(); toggle(); }
  else if (e.key === 'ArrowRight') nextSection(!audio.paused);
  else if (e.key === 'ArrowLeft') goto(sec - 1, 0, !audio.paused);
  else if (e.key === 'ArrowUp') setRate(rate + 0.1);
  else if (e.key === 'ArrowDown') setRate(rate - 0.1);
  else if (e.key === '-' || e.key === '_') setFont(fontPct - 10);
  else if (e.key === '=' || e.key === '+') setFont(fontPct + 10);
  else if (e.key === 's' || e.key === 'S') setSpritz(!spritz);
  else if (e.key === 'l' || e.key === 'L') setTape(!tapeMode);
  else if (e.key === 'k' || e.key === 'K') cycleSkin();
}
addEventListener('keydown', onKey);

// Gamepad: the daemon hands the pad to the app in gamepad mode (Start), as a
// standard-mapping Xbox pad. A play/pause, B replay sentence, X/Y font size,
// shoulders and left/right skip section, up/down change speed.
const padHeld = {};
const PAD = {0: 'toggle', 1: 'replay', 2: 'fontup', 3: 'fontdown',
             4: 'prev', 5: 'next', 6: 'scrubback', 7: 'scrubfwd', 8: 'toc',
             12: 'speedup', 13: 'speeddown', 14: 'prev', 15: 'next'};

function doAction(a) {
  if (a === 'toggle') toggle();
  else if (a === 'replay') { audio.currentTime = cur().begin; karaoke(); }
  else if (a === 'prev') goto(sec - 1, 0, !audio.paused);
  else if (a === 'next') nextSection(!audio.paused);
  else if (a === 'speedup') setRate(rate + 0.1);
  else if (a === 'speeddown') setRate(rate - 0.1);
  else if (a === 'fontup') setFont(fontPct + 10);
  else if (a === 'fontdown') setFont(fontPct - 10);
  else if (a === 'spritz') setSpritz(!spritz);
  else if (a === 'toc') { tocOpen ? closeToc() : openToc(); }
  else if (a === 'scrubback') seekFrac(scrubFrac() - 0.05);
  else if (a === 'scrubfwd') seekFrac(scrubFrac() + 0.05);
}

const MENU_PAD = {0: 'ok', 1: 'close', 12: 'up', 13: 'down'};

function padTick() {
  for (const gp of (navigator.getGamepads ? navigator.getGamepads() : [])) {
    if (!gp) continue;
    if (gp.axes && gp.axes.some(a => Math.abs(a) > 0.25)) activity();
    gp.buttons.forEach((b, i) => {
      const key = gp.index + ':' + i;
      if (b.pressed && !padHeld[key]) activity();
      if (skOpen) {
        const sk = {0: 'ok', 1: 'close', 12: 'prev', 13: 'next', 14: 'prev', 15: 'next'}[i];
        if (sk && b.pressed && !padHeld[key]) {
          if (sk === 'prev') skinStep(-1);
          else if (sk === 'next') skinStep(1);
          else if (sk === 'ok') closeSkins(true);
          else closeSkins(false);
        }
        padHeld[key] = b.pressed;
        return;
      }
      const act = tocOpen ? MENU_PAD[i] : PAD[i];
      if (act && b.pressed && !padHeld[key]) {
        showUI();
        if (act === 'up') { tocSel = Math.max(0, tocSel - 1); markToc(); }
        else if (act === 'down') { tocSel = Math.min(tocRows.length - 1, tocSel + 1); markToc(); }
        else if (act === 'ok') tocActivate();
        else if (act === 'close') closeToc();
        else doAction(act);
      }
      padHeld[key] = b.pressed;
    });
  }
  drawSpritz();
}
function pollPad() { padTick(); requestAnimationFrame(pollPad); }
pollPad();

