const pp = document.getElementById('pp'), rateEl = document.getElementById('rate');
const titleEl = document.getElementById('title');
let data = null, chapters = [], duration = 0, rate = 1, sec = -1;
try { rate = Math.min(3, Math.max(0.4, +(localStorage.getItem('ra:rate') || 1) || 1)); } catch (e) {}

const fmt = t => {
  t = Math.max(0, Math.floor(t || 0));
  const h = Math.floor(t / 3600), m = Math.floor(t / 60) % 60, s = t % 60;
  const mm = h ? String(m).padStart(2, '0') : String(m);
  return (h ? h + ':' : '') + mm + ':' + String(s).padStart(2, '0');
};
const enc = p => p.split('/').map(encodeURIComponent).join('/');

function applyRate() {
  audio.defaultPlaybackRate = rate;
  audio.playbackRate = rate;
  // one revolution per ~3.4 s at 1x: the reels answer the speed setting
  tape.style.setProperty('--spin', (3.4 / Math.max(0.25, rate)).toFixed(2) + 's');
  rateEl.textContent = rate.toFixed(2) + 'x';
}

function paint() {
  const t = audio.currentTime || 0;
  const d = duration || audio.duration || 0;
  const f = d ? Math.min(1, Math.max(0, t / d)) : 0;
  const pct = Math.round(f * 100);
  document.getElementById('scrubfill').style.width = (f * 100).toFixed(2) + '%';
  document.getElementById('scrubgrab').style.left = (f * 100).toFixed(2) + '%';
  // supply reel empties, take-up reel fills
  tape.style.setProperty('--pa', (0.62 + 0.38 * (1 - f)).toFixed(3));
  tape.style.setProperty('--pb', (0.62 + 0.38 * f).toFixed(3));
  document.getElementById('counter').textContent = fmt(t);
  document.getElementById('pct').textContent = pct + '%';
  document.getElementById('slimtime').textContent = fmt(t);
  document.getElementById('slimpct').textContent = 'read along \u00b7 ' + pct + '%';
  if (music) {
    document.getElementById('stkcap').textContent =
      'TR ' + String(sec + 1).padStart(2, '0') + ' \u00b7 ' + pct + '%';
    document.getElementById('slimpct').textContent =
      'track ' + (sec + 1) + '/' + chapters.length + ' \u00b7 ' + pct + '%';
    return;
  }
  document.getElementById('stkcap').textContent =
    'CH ' + String(Math.max(0, sec) + 1).padStart(2, '0') + ' \u00b7 ' + pct + '%';
  if (!chapters.length) return;
  let i = 0;
  while (i + 1 < chapters.length && chapters[i + 1].start <= t) i++;
  if (i !== sec) { sec = i; showChapter(); save(); }
}

function showChapter() {
  if (!chapters.length) return;
  const c = chapters[sec] || chapters[0];
  const total = chapters.length;
  document.getElementById('chp').textContent =
    (total > 1 ? 'Ch ' + (sec + 1) + '/' + total + ' \u00b7 ' : '') + c.title;
  document.getElementById('rednum').textContent = String(Math.max(0, sec) + 1).padStart(2, '0');
  document.getElementById('slimline').textContent =
    (data && data.title ? data.title : '') +
    (total > 1 ? '  \u00b7  Ch ' + (sec + 1) + '/' + total : '') +
    (c.title ? '  \u00b7  ' + c.title : '');
  titleEl.textContent = (data && data.title ? data.title : '') +
    (total > 1 ? '  \u00b7  ' + (sec + 1) + '/' + total : '');
}

// ---- skins --------------------------------------------------------------
const SKINS = ['label', 'studio', 'slim', 'paper', 'chrome', 'clear', 'wood', 'vinyl', 'minidisc', 'walkman', 'cart', 'boombox'];
const SKIN_NAMES = {label: 'Mixtape', studio: 'Studio', slim: 'Slim', paper: 'Paper',
  chrome: 'Chrome', clear: 'Clear', wood: 'Wood', vinyl: 'Vinyl', minidisc: 'MiniDisc',
  walkman: 'Walkman', cart: '8-Track', boombox: 'Boombox'};
let skin = 'label';
try { skin = localStorage.getItem('ra:skin') || 'label'; } catch (e) {}
const forcedSkin = new URLSearchParams(location.search).get('skin');
if (SKINS.includes(forcedSkin)) skin = forcedSkin;
function applySkin(id, savePref) {
  if (!SKINS.includes(id)) id = 'label';
  skin = id;
  document.getElementById('tape').dataset.skin = id;
  if (savePref !== false) { try { localStorage.setItem('ra:skin', id); } catch (e) {} }
}
function cycleSkin() {
  applySkin(SKINS[(SKINS.indexOf(skin) + 1) % SKINS.length]);
  if (tocOpen) renderToc();
}

// ---- skin picker: a filmstrip with the real cover in every skin ----
let skOpen = false, skCards = [], skSel = 0, skBefore = 'label';
function renderSkins() {
  const g = document.getElementById('skingrid');
  if (!g) return;
  g.textContent = '';
  skCards = [];
  for (const id of SKINS) {
    const c = document.createElement('div');
    c.className = 'skcard';
    c.dataset.skin = id;
    c.tabIndex = 0;
    const t = document.createElement('div');
    t.className = 'skthumb';
    const im = document.createElement('img');
    im.alt = '';
    im.src = '/cover/' + encodeURIComponent(BOOK);
    im.onerror = () => { im.style.display = 'none'; };
    t.appendChild(im);
    for (const k of ['a', 'b']) {
      const b = document.createElement('b');
      b.className = k;
      t.appendChild(b);
    }
    const n = document.createElement('span');
    n.className = 'skname';
    n.textContent = SKIN_NAMES[id];
    c.append(t, n);
    c.onfocus = () => {
      skSel = skCards.indexOf(c);
      applySkin(id, false);
      document.getElementById('skinnow').textContent = SKIN_NAMES[id];
      c.scrollIntoView({inline: 'center', block: 'nearest'});
    };
    c.onclick = () => { applySkin(id, true); closeSkins(true); };
    g.appendChild(c);
    skCards.push(c);
  }
}
function openSkins() {
  const cur = document.getElementById('tape').dataset.skin || 'label';
  skBefore = cur;
  renderSkins();
  skOpen = true;
  document.getElementById('skins').classList.add('open');
  document.getElementById('skinnow').textContent = SKIN_NAMES[cur] || '';
  const i = Math.max(0, SKINS.indexOf(cur));
  if (skCards[i]) skCards[i].focus();
}
function closeSkins(commit) {
  if (!skOpen) return;
  skOpen = false;
  document.getElementById('skins').classList.remove('open');
  if (!commit) applySkin(skBefore, false);
}
function skinStep(d) {
  if (!skCards.length) return;
  skinStep.at = ((skSel + d) % skCards.length + skCards.length) % skCards.length;
  skCards[skinStep.at].focus();
}
document.getElementById('skinsx').onclick = () => closeSkins(false);

applySkin(skin, false);


let music = false, queue = [];
function setImg(id, src) {
  const im = document.getElementById(id);
  if (!im) return;
  im.src = src;
  im.onerror = () => { im.style.visibility = 'hidden'; };
}
function applyMusicTrack(i, play) {
  if (!queue.length) return;
  sec = Math.max(0, Math.min(queue.length - 1, i));
  const t = queue[sec], total = queue.length, n = sec + 1;
  music = true;
  data = {title: t.title, author: t.artist, album: t.album};
  const f = encodeURIComponent(t.file);
  setImg('cov', '/label/' + f);
  setImg('stk', '/art/' + f);
  setImg('big', '/art/' + f);
  setImg('slimcov', '/art/' + f);
  setImg('blurimg', '/bg/' + f);
  setImg('slimheadcov', '/label/' + f);
  fetch('/colors/' + f).then(r => r.json()).then(c => {
    const st = document.documentElement.style;
    if (c.top) st.setProperty('--amb-top', 'rgb(' + c.top.join(',') + ')');
    if (c.bottom) st.setProperty('--amb-bot', 'rgb(' + c.bottom.join(',') + ')');
    if (c.left) st.setProperty('--amb-left', 'rgb(' + c.left.join(',') + ')');
    if (c.right) st.setProperty('--amb-right', 'rgb(' + c.right.join(',') + ')');
  }).catch(() => {});
  document.getElementById('ttl').textContent = t.title;
  document.getElementById('aut').textContent = t.artist;
  document.getElementById('tagline').textContent = t.title;
  document.getElementById('topaut').textContent =
    t.artist + (t.album ? '  \u00b7  ' + t.album : '');
  document.getElementById('redlab').textContent = 'track';
  document.getElementById('slimaut').textContent = t.artist;
  document.getElementById('slimline').textContent =
    t.title + (t.album ? '  \u00b7  ' + t.album : '');
  document.getElementById('slimpct').textContent = 'track ' + n + '/' + total;
  document.getElementById('chp').textContent =
    (t.album ? t.album + '  \u00b7  ' : '') + 'Track ' + n + '/' + total;
  document.getElementById('rednum').textContent = String(n).padStart(2, '0');
  document.getElementById('side').textContent = 'Album';
  document.getElementById('stkcap').textContent = 'TR ' + String(n).padStart(2, '0') + ' \u00b7 0%';
  document.getElementById('pct').textContent = '0%';
  document.getElementById('counter').textContent = '0:00';
  titleEl.textContent = t.title;
  document.title = t.title;
  duration = t.duration || 0;
  document.getElementById('dur').textContent = fmt(duration);
  audio.src = '/audio/' + f;
  applyRate();
  audio.onloadedmetadata = () => {
    if (isFinite(audio.duration) && audio.duration > 0) duration = audio.duration;
    document.getElementById('dur').textContent = fmt(duration);
    let pos = null;
    try { pos = JSON.parse(localStorage.getItem('ra:m:' + t.file)); } catch (e) {}
    if (pos && pos.t) audio.currentTime = Math.min(pos.t, Math.max(0, duration - 1));
    paint();
    save();
    if (play) audio.play().catch(() => {});
  };
  audio.onended = () => {
    if (music && sec + 1 < queue.length) applyMusicTrack(sec + 1, true);
    else setPlaying(false);
  };
  paint();
}
function loadMusic() {
  fetch('/api/music/queue?album=' + encodeURIComponent(ALBUM || '') +
        '&shuffle=' + (SHUFFLE ? 1 : 0))
  .then(r => r.json()).then(q => {
    queue = q.tracks || [];
    if (!queue.length) {
      document.getElementById('loadtxt').textContent = 'no music tracks found';
      return;
    }
    music = true;
    chapters = queue.map(t => ({title: t.title, start: 0,
                                duration: t.duration || 0, file: t.file}));
    let idx = queue.findIndex(t => t.file === BOOK);
    if (idx < 0) idx = 0;
    applyMusicTrack(idx, false);
    document.getElementById('load').style.display = 'none';
    if (new URLSearchParams(location.search).get('check') === '1') {
      document.title = 'CHECK OK music';
    }
    if (new URLSearchParams(location.search).get('check') === 'ui') {
      runUITests().catch(e => { document.title = 'UITESTS ERROR ' + e.message; });
    }
    if (new URLSearchParams(location.search).get('perf') === 'idle') {
      setPlaying(true);
      setTimeout(() => {
        let frames = 0; const t0 = performance.now();
        const step = () => {
          frames++;
          if (performance.now() - t0 < 3000) requestAnimationFrame(step);
          else console.log('TAPEFPS', Math.round(frames / 3));
        };
        requestAnimationFrame(step);
      }, 3500);
    }
  }).catch(() => {
    document.getElementById('loadtxt').textContent = 'could not open this album';
  });
}

function setPlaying(on) {
  document.body.classList.toggle('playing', !!on);
  pp.innerHTML = on ? '&#10074;&#10074;' : '&#9654;';
}

function toggle() {
  if (audio.paused) {
    setPlaying(true);                       // respond to the button at once
    audio.play().catch(() => setPlaying(false));
  } else {
    audio.pause();
    setPlaying(false);
  }
}

function seek(t, play) {
  if (!isFinite(t)) return;
  audio.currentTime = Math.max(0, Math.min(duration || audio.duration || t, t));
  paint();
  if (play) audio.play().catch(() => {});
}

function gotoChapter(i, play) {
  if (music) { applyMusicTrack(i, play); return; }
  if (!chapters.length) return;
  i = Math.max(0, Math.min(chapters.length - 1, i));
  seek(chapters[i].start, play);
}

function stepChapter(d) {
  if (music) { applyMusicTrack(sec + d, !audio.paused); return; }
  if (!chapters.length) return;
  let i = 0;
  while (i + 1 < chapters.length && chapters[i + 1].start <= audio.currentTime + 0.4) i++;
  gotoChapter(i + d, !audio.paused);
}

function setRate(r) {
  rate = Math.min(3, Math.max(0.4, Math.round(r * 100) / 100));
  applyRate();
  try { localStorage.setItem('ra:rate', rate); } catch (e) {}
  save();
}

function save() {
  try {
    if (music) {
      if (queue[sec]) localStorage.setItem('ra:m:' + queue[sec].file,
        JSON.stringify({t: audio.currentTime || 0, rate}));
      return;
    }
    if (!data) return;
    const d = duration || audio.duration || 0;
    localStorage.setItem('ra:' + BOOK, JSON.stringify({
      sec: Math.max(0, sec), par: 0, t: audio.currentTime || 0, rate,
      pct: d ? Math.min(1, (audio.currentTime || 0) / d) : 0,
      total: chapters.length || 1, narration: true, audio: true, at: Date.now(),
    }));
  } catch (e) {}
}

// ---- scrubber -----------------------------------------------------------
const scrub = document.getElementById('scrub');
let dragging = false;
const fracAt = e => {
  const r = scrub.getBoundingClientRect();
  return r.width ? Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)) : 0;
};
const seekFrac = f => seek(f * (duration || audio.duration || 0));
scrub.addEventListener('pointerdown', e => {
  dragging = true;
  try { scrub.setPointerCapture(e.pointerId); } catch (err) {}
  seekFrac(fracAt(e));
});
scrub.addEventListener('pointermove', e => { if (dragging) seekFrac(fracAt(e)); });
scrub.addEventListener('pointerup', () => { dragging = false; });
scrub.addEventListener('pointercancel', () => { dragging = false; });

const xoffEnabled = () => true;

// ---- display off after inactivity ---------------------------------------
let xoffMin = 3, xoffTimer = null, screenOff = false, lastAct = 0;
try {
  const v = localStorage.getItem('ra:xoff');
  if (v !== null) xoffMin = Math.max(0, +v || 0);
} catch (e) {}
const forceXoff = new URLSearchParams(location.search).get('xoff');
if (forceXoff !== null) xoffMin = Math.max(0, parseFloat(forceXoff) || 0);
function scheduleXoff() {
  clearTimeout(xoffTimer);
  if (!xoffEnabled() || xoffMin <= 0) return;
  xoffTimer = setTimeout(sleepScreen, xoffMin * 60000);
}
function sleepScreen() {
  if (screenOff || !xoffEnabled() || xoffMin <= 0) return;
  screenOff = true;
  document.body.classList.add('screenoff');
  fetch('/screen/off').catch(() => {});
}
function wakeScreen() {
  if (!screenOff) return;
  screenOff = false;
  document.body.classList.remove('screenoff');
  fetch('/screen/on').catch(() => {});
}
function activity() {
  wakeScreen();
  const now = Date.now();
  if (now - lastAct > 800) { lastAct = now; scheduleXoff(); }
}
document.addEventListener('pointerdown', activity);
document.addEventListener('pointermove', activity);
document.addEventListener('mousemove', activity);
document.addEventListener('wheel', activity, {passive: true});
document.addEventListener('touchmove', activity, {passive: true});
function cycleXoff() {
  const vals = [1, 3, 5, 10, 0];
  const i = vals.indexOf(xoffMin);
  xoffMin = vals[(i < 0 ? 1 : i + 1) % vals.length];
  try { localStorage.setItem('ra:xoff', xoffMin); } catch (e) {}
  scheduleXoff();
  if (tocOpen) renderToc();
}
function xoffLabel() { return xoffMin ? xoffMin + ' min' : 'never'; }

scheduleXoff();


// ---- the transport stays on screen in the player ----------------------
let zen = false;
function showUI() { document.body.classList.remove('zen'); }
document.addEventListener('pointermove', () => showUI());
document.addEventListener('pointerdown', () => showUI());

// ---- chapter picker -----------------------------------------------------
let tocOpen = false, tocSel = 0, tocRows = [], tocActions = [];

function chapterName(i) {
  const c = chapters[i] || {};
  return c.title || ('Chapter ' + (i + 1));
}

function renderToc() {
  const body = document.getElementById('tocbody');
  body.textContent = '';
  tocRows = [];
  tocActions = [];
  const add = (text, num, cls, action) => {
    const d = document.createElement('div');
    d.className = 'tocrow ' + (cls || '');
    const n = document.createElement('span');
    n.className = 'n';
    n.textContent = num;
    const l = document.createElement('span');
    l.className = 'l';
    l.textContent = text;
    d.append(n, l);
    d.onclick = () => { tocSel = tocRows.indexOf(d); markToc(); tocActivate(); };
    body.appendChild(d);
    tocRows.push(d);
    tocActions.push(action);
  };
  add('Theme: ' + themeById(currentThemeId()).name + '  \u25b8', '\u25d1', 'tog',
      () => cycleTheme());
  add('Skins: ' + SKIN_NAMES[skin] + '  \u25b8', '\u25a3', 'tog',
      () => { closeToc(); openSkins(); });
  add('Screen off: ' + xoffLabel() + '  \u25b8', '\u25d3', 'tog', () => cycleXoff());
  chapters.forEach((c, i) => add(chapterName(i), fmt(music ? c.duration : c.start),
      i === sec ? 'cur' : '',
      () => { closeToc(); gotoChapter(i, !audio.paused); }));
  tocSel = 0;
  markToc();
}

function markToc() {
  tocRows.forEach((r, i) => r.classList.toggle('sel', i === tocSel));
  if (tocRows[tocSel]) tocRows[tocSel].scrollIntoView({block: 'nearest'});
}

function openToc() {
  if (!data) return;
  tocOpen = true;
  showUI(0);
  renderToc();
  document.getElementById('toc').style.display = 'flex';
}

function closeToc() {
  tocOpen = false;
  document.getElementById('toc').style.display = 'none';
  showUI();
}

function tocActivate() { const a = tocActions[tocSel]; if (a) a(); }
document.getElementById('tocbtn').onclick = () => (tocOpen ? closeToc() : openToc());

pp.onclick = toggle;
document.getElementById('prev').onclick = () => stepChapter(-1);
document.getElementById('next').onclick = () => stepChapter(1);
document.getElementById('slow').onclick = () => setRate(rate - 0.1);
document.getElementById('fast').onclick = () => setRate(rate + 0.1);
document.getElementById('quit').onclick = back;

function back() {
  audio.pause();
  save();
  fetch('/screen/on').catch(() => {});
  fetch('/player/off').catch(() => {});
  location.href = '/';
}

audio.ontimeupdate = () => { if (!dragging) paint(); };
audio.ondurationchange = () => { if (isFinite(audio.duration)) duration = audio.duration; paint(); };
audio.onplay = () => { applyRate(); setPlaying(true); fetch('/player/on').catch(() => {}); showUI(); };
audio.onpause = () => { setPlaying(false); fetch('/player/off').catch(() => {}); showUI(0); };
audio.onended = () => { setPlaying(false); save(); };
audio.onerror = () => {
  setPlaying(false);
  document.getElementById('chp').textContent = 'this file cannot be decoded here';
  document.getElementById('load').style.display = 'none';
};
audio.addEventListener('timeupdate', save);
addEventListener('pagehide', save);

function onKey(e) {
  showUI();
  activity();
  if (skOpen) {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { skinStep(1); e.preventDefault(); return; }
    if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { skinStep(-1); e.preventDefault(); return; }
    if (e.key === 'Enter' || e.key === ' ') { closeSkins(true); e.preventDefault(); return; }
    if (e.key === 'Escape' || e.key === 'k') { closeSkins(false); return; }
  }
  if (e.key === 'K') { openSkins(); return; }
  if (e.key === 'Escape') { if (tocOpen) { closeToc(); return; } back(); return; }
  if (tocOpen) {
    if (e.key === 'ArrowDown' || e.key === 'j') { tocSel = Math.min(tocRows.length - 1, tocSel + 1); markToc(); }
    else if (e.key === 'ArrowUp' || e.key === 'k') { tocSel = Math.max(0, tocSel - 1); markToc(); }
    else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); tocActivate(); }
    else if (e.key === 'c') closeToc();
    return;
  }
  if (e.key === 'c') { openToc(); return; }
  if (e.key === ' ') { e.preventDefault(); toggle(); }
  else if (e.key === 'ArrowRight') stepChapter(1);
  else if (e.key === 'ArrowLeft') stepChapter(-1);
  else if (e.key === 'ArrowUp') setRate(rate + 0.1);
  else if (e.key === 'ArrowDown') setRate(rate - 0.1);
  else if (e.key === 't' || e.key === 'T') cycleTheme();
  else if (e.key === 'k' || e.key === 'K') cycleSkin();
}
addEventListener('keydown', onKey);

// Gamepad: same mapping as the reader, with B as "back 30 seconds".
const padHeld = {};
const PAD = {0: 'toggle', 1: 'back30', 2: 'theme', 3: 'theme', 4: 'prev', 5: 'next',
             6: 'scrubback', 7: 'scrubfwd', 8: 'toc', 12: 'speedup', 13: 'speeddown',
             14: 'prev', 15: 'next'};
const MENU_PAD = {0: 'ok', 1: 'close', 12: 'up', 13: 'down'};

function doAction(a) {
  if (a === 'toggle') toggle();
  else if (a === 'back30') seek(audio.currentTime - 30);
  else if (a === 'prev') stepChapter(-1);
  else if (a === 'next') stepChapter(1);
  else if (a === 'speedup') setRate(rate + 0.1);
  else if (a === 'speeddown') setRate(rate - 0.1);
  else if (a === 'theme') cycleTheme();
  else if (a === 'toc') { tocOpen ? closeToc() : openToc(); }
  else if (a === 'scrubback') seekFrac(Math.max(0, audio.currentTime / (duration || 1) - 0.05));
  else if (a === 'scrubfwd') seekFrac(Math.min(1, audio.currentTime / (duration || 1) + 0.05));
}

function padTick() {
  for (const gp of (navigator.getGamepads ? navigator.getGamepads() : [])) {
    if (!gp) continue;
    if (gp.axes && gp.axes.some(a => Math.abs(a) > 0.25)) activity();
    gp.buttons.forEach((b, i) => {
      const key = gp.index + ':' + i;
      if (b.pressed && !padHeld[key]) activity();
      if (skOpen) {
        const sk = {0: 'ok', 1: 'close', 12: 'prev', 13: 'next', 14: 'prev', 15: 'next'}[i];
        if (sk && b.pressed && !padHeld[key]) {
          if (sk === 'prev') skinStep(-1);
          else if (sk === 'next') skinStep(1);
          else if (sk === 'ok') closeSkins(true);
          else closeSkins(false);
        }
        padHeld[key] = b.pressed;
        return;
      }
      const act = tocOpen ? MENU_PAD[i] : PAD[i];
      if (act && b.pressed && !padHeld[key]) {
        showUI();
        if (act === 'up') { tocSel = Math.max(0, tocSel - 1); markToc(); }
        else if (act === 'down') { tocSel = Math.min(tocRows.length - 1, tocSel + 1); markToc(); }
        else if (act === 'ok') tocActivate();
        else if (act === 'close') closeToc();
        else doAction(act);
      }
      padHeld[key] = b.pressed;
    });
  }
}
function pollPad() { padTick(); requestAnimationFrame(pollPad); }
pollPad();
tape.addEventListener('click', e => { if (!tocOpen) toggle(); });

// ---- themes (same ids as the library and the reader) --------------------
const THEMES = [
  {id: 'midnight', name: 'Midnight', bg: '#141414', panel: '#1d1d1d', card: '#191919',
   text: '#e8e8e8', dim: '#8a8a8a', line: '#242424', accent: '#ffb300', accent2: '#ffd60a'},
