function themeById(id) {
  return THEMES.find(t => t.id === id) || THEMES[0];
}

function currentThemeId() {
  let id = 'midnight';
  try { id = localStorage.getItem('ra:theme') || 'midnight'; } catch (e) {}
  const forced = new URLSearchParams(location.search).get('theme');
  if (forced && THEMES.some(t => t.id === forced)) id = forced;
  return themeById(id).id;
}

function applyTheme(id) {
  const t = themeById(id);
  const r = document.documentElement.style;
  r.setProperty('--bg', t.bg);
  r.setProperty('--panel', t.panel);
  r.setProperty('--card', t.card);
  r.setProperty('--text', t.text);
  r.setProperty('--dim', t.dim);
  r.setProperty('--line', t.line);
  r.setProperty('--accent', t.accent);
  r.setProperty('--accent2', t.accent2);
  r.setProperty('--page', t.page);
  r.setProperty('--ink', t.ink);
  r.setProperty('color-scheme', t.bg === '#f5f2ec' || t.bg === '#efe9dd' ? 'light' : 'dark');
  try { localStorage.setItem('ra:theme', t.id); } catch (e) {}
  const f = document.getElementById('f');
  if (f && f.contentDocument) {
    f.contentDocument.documentElement.style.setProperty('--ra-accent', t.accent);
    f.contentDocument.documentElement.style.setProperty('--ra-accent2', t.accent2);
    f.contentDocument.documentElement.style.setProperty('--ra-page', t.page);
    f.contentDocument.documentElement.style.setProperty('--ra-ink', t.ink);
  }
  return t;
}

// Theme sheet: each card previews its own palette, tapping applies it live.
function openThemes() {
  const grid = document.getElementById('themegrid');
  grid.textContent = '';
  const active = currentThemeId();
  for (const t of THEMES) {
    const card = document.createElement('div');
    card.className = 'tcard' + (t.id === active ? ' sel' : '');
    const prev = document.createElement('div');
    prev.className = 'tprev';
    prev.style.background = t.bg;
    const cv = document.createElement('div');
    cv.className = 'cv';
    cv.style.background = t.accent;
    const txt = document.createElement('div');
    txt.className = 'txt';
    for (const [cls, color, w] of [['tl', t.text, '100%'], ['ts', t.dim, '70%']]) {
      const el = document.createElement('div');
      el.className = cls;
      el.style.background = color;
      if (w !== '100%') el.style.width = w;
      txt.appendChild(el);
    }
    const pb = document.createElement('div');
    pb.className = 'pb';
    pb.style.background = t.accent;
    pb.style.width = '60%';
    txt.appendChild(pb);
    prev.append(cv, txt);
    const name = document.createElement('div');
    name.className = 'tname';
    name.style.background = t.card;
    name.style.color = t.text;
    name.textContent = t.name + (t.id === active ? '  \u2713' : '');
    card.append(prev, name);
    card.onclick = () => { applyTheme(t.id); openThemes(); };
    grid.appendChild(card);
  }
  document.getElementById('themes').classList.add('open');
}
