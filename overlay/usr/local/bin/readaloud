<script>
fetch('/screen/on').catch(() => {});
window.onerror = (m, s, l, c) => {
  const box = document.getElementById('list');
  if (box) box.innerHTML = '<div id="empty">UI error: ' + m + ' &#64;' + l + ':' + c + '</div>';
};
document.getElementById('quit').onclick = () => fetch('/quit').catch(() => {});
addEventListener('keydown', e => {
  if (e.key === '1') { setTab('books'); return; }
  if (e.key === '2') { setTab('music'); return; }
  if (e.key === 'm' || e.key === 'M') { setTab(tab === 'music' ? 'books' : 'music'); return; }
  if (e.key === 't' || e.key === 'T') {
    const el = document.getElementById('themes');
    if (el.classList.contains('open')) closeThemes(); else openThemes();
    return;
  }
  if (e.key === 'v' || e.key === 'V') { cycleView(); return; }
  if (e.key === 'ArrowDown') { moveFocus(1); e.preventDefault(); }
  else if (e.key === 'ArrowUp') { moveFocus(-1); e.preventDefault(); }
  else if (e.key === 'ArrowRight') { focusRow(sel + 1); e.preventDefault(); }
  else if (e.key === 'ArrowLeft') { focusRow(sel - 1); e.preventDefault(); }
  else if (e.key === 'Enter') { const r = rows()[sel]; if (r) r.click(); e.preventDefault(); }
});
addEventListener('keydown', e => {
  if (e.key === 'Escape' || e.key === 'q') {
    if (tracksOpen) { closeTracks(); return; }
    if (document.getElementById('themes').classList.contains('open')) { closeThemes(); return; }
    fetch('/quit').catch(() => {});
  }
});

fetch('/api/books').then(r => r.json()).then(books => {
  const list = document.getElementById('list');
  if (!books.length) {
    list.innerHTML = '<div id="empty">No .epub or .m4b in this folder.<br>' +
      'Drop read-aloud books or audiobooks here and reload.</div>';
    return;
  }
  const withPos = books.map(b => {
    let p = null;
    try { p = JSON.parse(localStorage.getItem('ra:' + b.name)); } catch (e) {}
    return {b, p};
  });
  const cont = withPos
    .filter(x => x.p && x.p.at && x.p.pct > 0 && x.p.pct < 0.995)
    .sort((x, y) => y.p.at - x.p.at)
    .slice(0, 3);
  const contNames = new Set(cont.map(x => x.b.name));
  const rest = withPos.filter(x => !contNames.has(x.b.name));
  if (cont.length) list.appendChild(sectionHead('Continue'));

  for (const {b, p} of cont.concat(rest)) {
    const a = document.createElement('a');
    a.href = '/play?book=' + encodeURIComponent(b.name);

    const cover = document.createElement('div');
    cover.className = 'cover';
    const img = document.createElement('img');
    if (b.cover) img.src = '/cover/' + encodeURIComponent(b.name);
    img.alt = '';
    img.width = 40;
    img.height = 58;
    cover.appendChild(img);
    if (b.readaloud) {
      const badge = document.createElement('div');
      badge.className = 'badge';
      badge.title = 'narration included';
      badge.innerHTML = '<svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor">' +
        '<path d="M4 9h4l5-4v14l-5-4H4z"/></svg>';
      cover.appendChild(badge);
    } else if (b.audio) {
      const badge = document.createElement('div');
      badge.className = 'badge tape';
      badge.title = 'audiobook';
      badge.innerHTML = '<svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor">' +
        '<path d="M3 6h18v12H3zM7 9a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4zM6 16h12v1H6z"/></svg>';
      cover.appendChild(badge);
    }
    a.appendChild(cover);

    const info = document.createElement('div');
    info.className = 'info';

    const t = document.createElement('div');
    t.className = 't';
    t.textContent = b.title || b.name;
    info.appendChild(t);

    if (b.subtitle) {
      const s = document.createElement('div');
      s.className = 's';
      s.textContent = b.subtitle;
      info.appendChild(s);
    }
    const by = [b.author, b.series].filter(Boolean).join(' \u00b7 ');
    if (by) {
      const el = document.createElement('div');
      el.className = 'a';
      el.textContent = by;
      info.appendChild(el);
    }

    const pct = (p && p.pct != null) ? Math.round(p.pct * 100) : null;
    const m = document.createElement('div');
    m.className = 'm' + (pct == null ? ' new' : '');
    m.textContent = pct == null
      ? (b.readaloud ? 'not started' : b.audio ? 'audiobook' : 'no narration')
      : pct + '% \u00b7 chapter ' + ((p.sec || 0) + 1) + '/' + (p.total || '?');
    info.appendChild(m);

    if (pct != null) {
      const bar = document.createElement('div');
      bar.className = 'bar';
      bar.style.width = pct + '%';
      a.appendChild(bar);
    }
    a.appendChild(info);
    if (b.readaloud) {
      const listen = document.createElement('span');
      listen.className = 'listen';
      listen.tabIndex = 0;
      listen.setAttribute('role', 'button');
      listen.title = 'listen on the tape';
      listen.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">' +
        '<path d="M3 5h18a1 1 0 011 1v12a1 1 0 01-1 1h-4l-2-3H9l-2 3H3a1 1 0 01-1-1V6a1 1 0 011-1zm2 3a2 2 0 100 4 2 2 0 000-4zm14 0a2 2 0 100 4 2 2 0 000-4zM7 17h10v1H7z"/></svg>';
      const goTape = e => {
        e.preventDefault();
        e.stopPropagation();
        location.href = '/play?book=' + encodeURIComponent(b.name) + '&view=tape';
      };
      listen.onclick = goTape;
      listen.onkeydown = e => { if (e.key === 'Enter') goTape(e); };
      a.appendChild(listen);
    }
    list.appendChild(a);
    if (p && contNames.has(b.name) && b.name === cont[cont.length - 1].b.name
        && rest.length) {
      list.appendChild(sectionHead('All books'));
    }
  }
  focusRow(0);
  applyTheme(currentThemeId());
  if (new URLSearchParams(location.search).get('tab') === 'music') setTab('music');
  if (new URLSearchParams(location.search).get('check') === 'ui') {
    runUITests().catch(e => { document.title = 'UITESTS ERROR ' + e.message; });
  }
  if (new URLSearchParams(location.search).get('perf') === 'idle') {
    let frames = 0; const t0 = performance.now();
    const step = () => {
      frames++;
      if (performance.now() - t0 < 3000) requestAnimationFrame(step);
      else console.log('IDLEFPS', Math.round(frames / 3));
    };
    requestAnimationFrame(step);
  }
  if (new URLSearchParams(location.search).get('perf') === 'scroll') {
    let frames = 0, dir = 1;
    const t0 = performance.now();
    const step = () => {
      const el = document.getElementById('list');
      el.scrollTop += dir * 26;
      if (el.scrollTop + el.clientHeight >= el.scrollHeight - 2) dir = -1;
      if (el.scrollTop <= 0) dir = 1;
      frames++;
      if (performance.now() - t0 < 3000) requestAnimationFrame(step);
      else console.log('SCROLLFPS', Math.round(frames / 3),
                       'rows', document.querySelectorAll('#list > *').length);
    };
    requestAnimationFrame(step);
  }
});

// ---- gamepad navigation ------------------------------------------------
// ---- view modes: list / grid / covers ----------------------------------
const VIEWS = ['list', 'grid', 'flow'];
let view = 'list';
try { view = localStorage.getItem('ra:view') || 'list'; } catch (e) {}
if (!VIEWS.includes(view)) view = 'list';
const forced = new URLSearchParams(location.search).get('view');
if (VIEWS.includes(forced)) view = forced;
const listEl = document.getElementById('list');
const viewBtn = document.getElementById('viewbtn');
let tab = 'books', musicData = null, musicSort = 'artist', tracksOpen = false;
const activeEl = () => document.getElementById(tab === 'music' ? 'music' : 'list');

function applyView() {
  activeEl().className = view === 'list' ? '' : view;
  viewBtn.textContent = view === 'list' ? '\u2630' : view === 'grid' ? '\u25a6' : '\u25c8';
  try { localStorage.setItem('ra:view', view); } catch (e) {}
  if (view !== 'flow') {
    rows().forEach(el => { el.style.transform = ''; el.style.opacity = ''; el.style.zIndex = ''; });
  }
  requestAnimationFrame(styleFlow);
}

function cycleView() {
  view = VIEWS[(VIEWS.indexOf(view) + 1) % VIEWS.length];
  applyView();
  if (rows()[sel]) focusRow(sel);
}
viewBtn.onclick = cycleView;

let sel = 0;
const rows = () => {
  if (tracksOpen) {
    return [...document.querySelectorAll('#tracks .trow')].filter(el => el.offsetParent !== null);
  }
  return [...activeEl().querySelectorAll('a, .st, .series')]
    .filter(el => el.offsetParent !== null);
};

// ---- tabs: books / music ------------------------------------------------
function setTab(t) {
  tab = t === 'music' ? 'music' : 'books';
  document.getElementById('list').style.display = tab === 'books' ? '' : 'none';
  document.getElementById('music').style.display = tab === 'music' ? '' : 'none';
  document.getElementById('tabbooks').classList.toggle('on', tab === 'books');
  document.getElementById('tabmusic').classList.toggle('on', tab === 'music');
  document.getElementById('sortbtn').style.display = tab === 'music' ? '' : 'none';
  document.getElementById('shufbtn').style.display = tab === 'music' ? '' : 'none';
  sel = 0;
  applyView();
  if (tab === 'music') loadMusic(); else focusRow(0);
}
document.getElementById('tabbooks').onclick = () => setTab('books');
document.getElementById('tabmusic').onclick = () => setTab('music');

function fmtDur(s) {
  s = Math.max(0, Math.round(s || 0));
  return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
}
function loadMusic() {
  if (musicData) { renderMusic(); return; }
  const el = document.getElementById('music');
  el.textContent = 'loading music\u2026';
  fetch('/api/music').then(r => r.json()).then(d => {
    musicData = d.albums || [];
    renderMusic();
  }).catch(() => { el.textContent = 'could not read the music folder'; });
}
function renderMusic() {
  const el = document.getElementById('music');
  el.textContent = '';
  if (!musicData || !musicData.length) {
    el.innerHTML = '<div id="empty">No music in this folder.<br>' +
      'Put .mp3/.m4a/.flac/.ogg files here and reload.</div>';
    return;
  }
  const albums = [...musicData];
  if (musicSort === 'album') albums.sort((a, b) => a.album.localeCompare(b.album));
  else if (musicSort === 'year') albums.sort((a, b) => (b.year || '').localeCompare(a.year || '') ||
                                                        a.album.localeCompare(b.album));
  else albums.sort((a, b) => a.artist.localeCompare(b.artist) || a.album.localeCompare(b.album));
  for (const a of albums) {
    const row = document.createElement('div');
    row.className = 'st album';
    row.tabIndex = 0;
    row.setAttribute('role', 'button');
    const cover = document.createElement('div');
    cover.className = 'cover';
    const img = document.createElement('img');
    if (a.cover) img.src = '/cover/' + encodeURIComponent(a.cover);
    img.alt = '';
    img.width = 40; img.height = 58;
    img.onerror = () => { img.style.visibility = 'hidden'; };
    cover.appendChild(img);
    const info = document.createElement('div');
    info.className = 'info';
    const t = document.createElement('div'); t.className = 't'; t.textContent = a.album;
    const by = document.createElement('div'); by.className = 'a';
    by.textContent = a.artist + (a.year ? ' \u00b7 ' + a.year : '');
    const m = document.createElement('div'); m.className = 'm';
    m.textContent = a.tracks.length + (a.tracks.length === 1 ? ' track' : ' tracks') +
      ' \u00b7 ' + fmtDur(a.duration);
    info.append(t, by, m);
    row.append(cover, info);
    row.onclick = () => openTracks(a);
    el.appendChild(row);
  }
  applyView();
  focusRow(0);
}
function openTracks(a) {
  tracksOpen = true;
  const body = document.getElementById('tracksbody');
  body.textContent = '';
  document.getElementById('trackstitle').textContent = a.album + '  \u00b7  ' + a.artist;
  const add = (text, num, dur, cls, action) => {
    const r = document.createElement('div');
    r.className = 'trow ' + (cls || '');
    r.tabIndex = 0;
    const n = document.createElement('span'); n.className = 'n'; n.textContent = num;
    const l = document.createElement('span'); l.className = 'l'; l.textContent = text;
    const d = document.createElement('span'); d.className = 'd'; d.textContent = dur || '';
    r.append(n, l, d);
    r.onclick = action;
    body.appendChild(r);
  };
  add('Shuffle album', '\u21c4', '', 'shuf',
      () => { location.href = '/play?album=' + encodeURIComponent(a.id) + '&shuffle=1'; });
  a.tracks.forEach((t, i) => add(t.title, t.track || (i + 1), fmtDur(t.duration), '',
      () => { location.href = '/play?album=' + encodeURIComponent(a.id) +
              '&track=' + encodeURIComponent(t.file); }));
  document.getElementById('tracks').classList.add('open');
  sel = 0;
  focusRow(0);
}
function closeTracks() {
  tracksOpen = false;
  document.getElementById('tracks').classList.remove('open');
  focusRow(sel);
}
document.getElementById('tracksx').onclick = closeTracks;
