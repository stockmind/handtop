    fetch('/colors/' + encodeURIComponent(BOOK)).then(r => r.json()).then(c => {
      const st = document.documentElement.style;
      if (c.top) st.setProperty('--amb-top', 'rgb(' + c.top.join(',') + ')');
      if (c.bottom) st.setProperty('--amb-bot', 'rgb(' + c.bottom.join(',') + ')');
      if (c.left) st.setProperty('--amb-left', 'rgb(' + c.left.join(',') + ')');
      if (c.right) st.setProperty('--amb-right', 'rgb(' + c.right.join(',') + ')');
    }).catch(() => {});
  }
  titleEl.textContent = d.title || '';
  document.title = d.title || 'tape';
  let pos = null;
  try { pos = JSON.parse(localStorage.getItem('ra:' + BOOK)); } catch (e) {}
  if (pos && pos.rate) { rate = pos.rate; applyRate(); }
  if (chapters.length) showChapter(); else {
    chapters = [{title: 'whole tape', start: 0}];
    showChapter();
  }
  audio.src = '/audio/' + encodeURIComponent(BOOK);
  applyRate();
  audio.onloadedmetadata = () => {
    if (isFinite(audio.duration) && audio.duration > 0) duration = audio.duration;
    document.getElementById('dur').textContent = fmt(duration);
    if (pos && pos.t) audio.currentTime = Math.min(pos.t, Math.max(0, duration - 2));
    paint();
    save();
    document.getElementById('load').style.display = 'none';
  };
  // hide the spinner even if metadata never arrives (broken file)
  setTimeout(() => { document.getElementById('load').style.display = 'none'; paint(); }, 2500);
  if (new URLSearchParams(location.search).get('check') === '1') {
    const ok = document.querySelectorAll('.win').length === 2 &&
      document.getElementById('ra') && document.getElementById('rb') &&
      chapters.length > 0 && !!document.getElementById('ttl').textContent;
    document.title = ok ? 'CHECK OK tape' : 'CHECK FAIL tape';
  }
  if (new URLSearchParams(location.search).get('check') === 'ui') {
    runUITests().catch(e => { document.title = 'UITESTS ERROR ' + e.message; });
  }
  if (new URLSearchParams(location.search).get('perf') === 'idle') {
    if (!new URLSearchParams(location.search).get('still')) setPlaying(true);
    // Measure after the label/art encodes and the first range read settle:
    // they otherwise land inside the sample and report the encoder, not the tape.
    setTimeout(() => {
      let frames = 0; const t0 = performance.now();
      const step = () => {
        frames++;
        if (performance.now() - t0 < 3000) requestAnimationFrame(step);
        else console.log('TAPEFPS', Math.round(frames / 3));
      };
      requestAnimationFrame(step);
    }, 3500);
  }
}).catch(() => {
  document.getElementById('loadtxt').textContent = 'could not open this tape';
});
}

// ---- UI self-tests (?check=ui) -----------------------------------------
async function runUITests() {
  const results = [];
  const check = async (name, fn) => {
    try { await fn(); results.push(name + ' PASS'); }
    catch (e) { results.push(name + ' FAIL ' + ((e && e.message) || e)); }
  };
  const assert = (c, m) => { if (!c) throw new Error(m || 'assert'); };
  const pad = {index: 0, buttons: Array.from({length: 18}, () => ({pressed: false}))};
  navigator.getGamepads = () => [pad];
  const tap = i => {
    pad.buttons[i].pressed = true;
    padTick();
    pad.buttons[i].pressed = false;
    padTick();
  };

  await check('tape has two reels', async () => {
    assert(document.querySelectorAll('.win .reel').length === 2, 'reels missing');
  });
  await check('reels stay still while paused', async () => {
    setPlaying(false);
    const st = getComputedStyle(document.querySelector('#ra .hub')).animationPlayState;
    assert(st === 'paused', 'state ' + st);
  });
  await check('reels turn while playing', async () => {
    setPlaying(true);
    const st = getComputedStyle(document.querySelector('#ra .hub')).animationPlayState;
    assert(st === 'running', 'state ' + st);
    setPlaying(false);
  });
  await check('rate changes the reel period', async () => {
    const before = getComputedStyle(document.querySelector('#ra .hub')).animationDuration;
    setRate(2);
    const after = getComputedStyle(document.querySelector('#ra .hub')).animationDuration;
    assert(before !== after, 'duration unchanged');
    setRate(1);
  });
  await check('picker opens and lists chapters', async () => {
    openToc();
    assert(tocOpen, 'did not open');
    assert(tocRows.length >= 2, 'no rows');
    closeToc();
  });
  await check('pad opens the picker and moves', async () => {
    tap(8);
    assert(tocOpen, 'pad did not open');
    const before = tocSel;
    tap(13);
    assert(tocSel !== before, 'selection did not move');
    tap(1);
    assert(!tocOpen, 'pad B did not close');
  });
  await check('theme cycles', async () => {
    const before = currentThemeId();
    cycleTheme();
    assert(currentThemeId() !== before, 'theme unchanged');
    applyTheme(before);
  });
  await check('skins cycle', async () => {
    const before = skin;
    cycleSkin();
    assert(skin !== before, 'skin unchanged');
    assert(document.getElementById('tape').dataset.skin === skin, 'skin not applied');
    applySkin(before);
  });
  await check('skin sheet previews and commits', async () => {
    openSkins();
    assert(skOpen, 'sheet did not open');
    assert(skCards.length === SKINS.length, 'missing tiles');
    skCards[1].focus();
    assert(document.getElementById('tape').dataset.skin === 'studio', 'no live preview');
    closeSkins(true);
    assert(!skOpen, 'sheet stayed open');
    assert(skin === 'studio', 'choice not kept');
    applySkin('label');
  });
  await check('speed buttons click', async () => {
    const before = rate;
    document.getElementById('fast').click();
    assert(rate > before, 'rate unchanged');
    setRate(before);
  });
  await check('scrubber seeks', async () => {
    seekFrac(0.5);
    const d = duration || audio.duration || 0;
    if (d) assert(Math.abs(audio.currentTime - d / 2) < d * 0.2, 'not applied');
  });
  await check('pad A toggles playback state', async () => {
    const before = document.body.classList.contains('playing');
    tap(0);
    assert(document.body.classList.contains('playing') !== before, 'state unchanged');
    audio.pause();
  });

  const pass = results.filter(r => r.includes(' PASS')).length;
  document.title = 'UITESTS ' + pass + '/' + results.length + ' ' + results.join(' | ');
}
</script></body></html>"""

PLAYER_HTML = (PLAYER_HTML.replace("__CASSETTE_CSS__", CASSETTE_CSS)
               .replace("__CASSETTE__", CASSETTE_HTML).replace("__SKINS__", SKIN_SHEET))
TAPE_HTML = (TAPE_HTML.replace("__CASSETTE_CSS__", CASSETTE_CSS)
             .replace("__CASSETTE__", CASSETTE_HTML).replace("__SKINS__", SKIN_SHEET))


class Handler(BaseHTTPRequestHandler):
    server_version = 'readaloud/1.0'

    def log_message(self, *a):
        pass

    def _books(self):
        root = self.server.root
        out = []
        for n in sorted(os.listdir(root)):
            low = n.lower()
            if not (low.endswith('.epub') or low.endswith('.m4b')):
                continue
            i = media_info(os.path.join(root, n))
            out.append({
                'name': n, 'title': i['title'], 'author': i['author'],
                'subtitle': i['subtitle'], 'series': i['series'],
                'readaloud': i['readaloud'], 'cover': i['cover'],
                'audio': bool(i.get('audio')),
            })
        out.sort(key=lambda b: (b['title'] or b['name']).lower())
        return out

    def _book_path(self, name):
        root = os.path.abspath(self.server.root)
        p = os.path.abspath(os.path.join(root, name))
        if p != root and not p.startswith(root + os.sep):
            return None
        return p if os.path.isfile(p) else None

    def _send(self, code, body, ctype='text/html; charset=utf-8', extra=None):
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(body)))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(body)

    def _send_gz(self, body, ctype, cache='no-cache'):
        """Text responses are 2 MB of JSON on a slow CPU: gzip and let the
        browser reuse them."""
        extra = {'Cache-Control': cache}
        if len(body) > 1024 and 'gzip' in self.headers.get('Accept-Encoding', ''):
            body = gzip.compress(body, 6)
            extra['Content-Encoding'] = 'gzip'
        self._send(200, body, ctype, extra)

    def do_HEAD(self):
        self.do_GET()

    def do_POST(self):
        self.do_GET()

    def do_GET(self):
        url = urlparse(self.path)
        path = unquote(url.path)

        if path == '/':
            if getattr(self.server, 't0', None) and not getattr(self.server, 't1', None):
                self.server.t1 = time.time()
                print("first paint request after %.1f s" % (self.server.t1 - self.server.t0), flush=True)
            return self._send_gz(LIBRARY_HTML.encode(), 'text/html; charset=utf-8')

        if path == '/api/books':
            return self._send_gz(json.dumps(self._books()).encode(), 'application/json')

        if path.startswith('/cover/st/'):
            uuid = path[len('/cover/st/'):]
            cfg = st_config()
            if not cfg.get('url') or not re.fullmatch(r'[0-9a-fA-F-]{36}', uuid or ''):
                return self._send(404, b'no cover')
            try:
                fname, ctype = st_cover(cfg, uuid)
                with open(fname, 'rb') as f:
                    return self._send(200, f.read(), ctype, {'Cache-Control': 'no-cache'})
            except Exception:
                return self._send(404, b'no cover')

        if path.startswith('/cover/'):
            p = self._book_path(path[len('/cover/'):])
            if not p:
                return self._send(404, b'no cover')
            fname, ctype = cover_file(p)
            if not fname:
                return self._send(404, b'no cover')
            with open(fname, 'rb') as f:
                # revalidate: a half-written thumbnail must never stick for a day
                return self._send(200, f.read(), ctype, {'Cache-Control': 'no-cache'})

        if path.startswith('/label/'):
            p = self._book_path(path[len('/label/'):])
            if not p:
                return self._send(404, b'no cover')
            fname = label_file(p)
            if not fname:
                return self._send(404, b'no cover')
            ctype = 'image/jpeg'
            if fname.endswith('.cover'):
                try:
                    with open(os.path.join(CACHE_DIR, audio_info(p)['key'] + '.mime')) as f:
                        ctype = f.read().strip() or ctype
                except Exception:
                    pass
            with open(fname, 'rb') as f:
                return self._send(200, f.read(), ctype, {'Cache-Control': 'no-cache'})

        if path.startswith('/art/'):
            p = self._book_path(path[len('/art/'):])
            if not p:
                return self._send(404, b'no cover')
            fname = art_file(p)
            if not fname:
                return self._send(404, b'no cover')
            ctype = 'image/jpeg'
            if fname.endswith('.cover'):
                try:
                    with open(os.path.join(CACHE_DIR, media_info(p)['key'] + '.mime')) as f:
                        ctype = f.read().strip() or ctype
                except Exception:
                    pass
            with open(fname, 'rb') as f:
                return self._send(200, f.read(), ctype, {'Cache-Control': 'no-cache'})

        if path.startswith('/bg/'):
            p = self._book_path(path[len('/bg/'):])
            if not p:
                return self._send(404, b'no cover')
            fname = bg_file(p)
            if not fname:
                return self._send(404, b'no cover')
            with open(fname, 'rb') as f:
                return self._send(200, f.read(), 'image/jpeg',
                                  {'Cache-Control': 'max-age=86400'})

        if path.startswith('/colors/'):
            p = self._book_path(path[len('/colors/'):])
            if not p:
                return self._send(404, b'no cover')
            return self._send(200, json.dumps(palette_file(p)).encode(), 'application/json',
                              {'Cache-Control': 'no-cache'})

        if path.startswith('/audio/'):
            p = self._book_path(path[len('/audio/'):])
            if not p or not is_audio(p):
                return self._send(404, b'no audio')
            return self._serve_audio(p)

        if path == '/api/storyteller':
            cfg = st_config()
            if not cfg.get('url'):
                return self._send(200, json.dumps({'configured': False, 'books': []}).encode(),
                                  'application/json')
            cache = os.path.join(CACHE_DIR, 'storyteller.json')
            books, online = [], False
            try:
                books = storyteller_list(cfg)
                online = True
                os.makedirs(CACHE_DIR, exist_ok=True)
                with open(cache, 'w') as f:
                    json.dump({'at': time.time(), 'books': books}, f)
            except Exception:
                try:
                    with open(cache) as f:
                        books = json.load(f).get('books') or []
                except Exception:
                    books = []
            local = {}
            for n in os.listdir(self.server.root):
                if not n.lower().endswith('.epub'):
                    continue
                i = book_info(os.path.join(self.server.root, n))
                full = i['title'] + (': ' + i['subtitle'] if i['subtitle'] else '')
                for k in (i['title'], full, full.replace(': ', ' ')):
                    local[_norm(k)] = n
            for b in books:
                b['local'] = local.get(_norm(b['title']))
            return self._send_gz(json.dumps({'configured': True, 'online': online,
                                             'books': books}).encode(), 'application/json')

        if path == '/api/music':
            return self._send_gz(json.dumps({'albums': music_data(self.server.root)}).encode(),
                                 'application/json')

        if path == '/api/music/queue':
            q = parse_qs(url.query)
            album = q.get('album', [''])[0]
            shuffle = q.get('shuffle', ['0'])[0] in ('1', 'true')
            tracks = music_queue(self.server.root, album, shuffle)
            return self._send_gz(json.dumps({'tracks': tracks}).encode(), 'application/json')

        if path == '/player/on' or path == '/player/off':
            player_active(path.endswith('/on'))
            return self._send(200, b'{"ok":true}', 'application/json')

        if path == '/screen/off' or path == '/screen/on':
            return self._send(200, json.dumps({'ok': screen_set(path.endswith('on'))}).encode(),
                              'application/json')

        if path == '/api/status':
            state = battery_state()
            state['screen'] = SCREEN['on']
            return self._send(200, json.dumps(state).encode(), 'application/json')

        if path == '/api/download':
            body = b''
            n = int(self.headers.get('Content-Length') or 0)
            if n:
                body = self.rfile.read(n)
            try:
                req = json.loads(body or b'{}')
            except Exception:
                req = {}
            cfg = st_config()
            uuid, title = req.get('uuid'), req.get('title')
            if not cfg.get('url') or not uuid:
                return self._send(400, b'{"error":"not configured"}', 'application/json')
            with DL_LOCK:
                cur = DOWNLOADS.get(uuid)
            if not cur or cur.get('state') in ('failed', 'done'):
                threading.Thread(target=download_book,
                                 args=(cfg, uuid, title, self.server.root), daemon=True).start()
            return self._send(200, b'{"started":true}', 'application/json')

        if path.startswith('/api/download/'):
            uuid = path[len('/api/download/'):]
            with DL_LOCK:
                info = dict(DOWNLOADS.get(uuid) or {'state': 'unknown'})
            return self._send(200, json.dumps(info).encode(), 'application/json')

        if path == '/api/jack':
            return self._send(200, json.dumps(JACK).encode(), 'application/json')

        if path == '/quit':
            self._send(200, b'bye')
            threading.Thread(target=close_app, daemon=True).start()
            return

        if path == '/play':
            q = parse_qs(url.query)
            book = q.get('book', [''])[0] or q.get('track', [''])[0]
            album = q.get('album', [''])[0]
            shuffle = q.get('shuffle', ['0'])[0] in ('1', 'true')
            if not book and (album or shuffle):
                tracks = music_queue(self.server.root, album, shuffle)
                if tracks:
                    book = tracks[0]['file']
            if not book or not self._book_path(book):
                return self._send(404, b'no such book')
            page = (TAPE_HTML if is_audio(book) else PLAYER_HTML)
            page = (page.replace('__BOOK__', json.dumps(book))
                        .replace('__ALBUM__', json.dumps(album))
                        .replace('__SHUFFLE__', 'true' if shuffle else 'false'))
            return self._send(200, page.encode())

        if path.startswith('/api/book/'):
            p = self._book_path(path[len('/api/book/'):])
            if not p:
                return self._send(404, b'{}', 'application/json')
            if is_audio(p):
                i = audio_info(p)
                data = {'audio': True, 'title': i['title'], 'subtitle': i['subtitle'],
                        'author': i['author'], 'duration': i['duration'],
                        'chapters': i['chapters'], 'cover': i['cover'],
                        'section_count': len(i['chapters'])}
                return self._send_gz(json.dumps(data).encode(), 'application/json',
                                     cache='max-age=300')
            try:
                _, raw, gz = load_book_cached(p)
            except Exception as e:
                return self._send(500, json.dumps({'error': str(e)}).encode(), 'application/json')
            if 'gzip' in self.headers.get('Accept-Encoding', ''):
                return self._send(200, gz, 'application/json',
                                  {'Content-Encoding': 'gzip', 'Cache-Control': 'max-age=300'})
            return self._send(200, raw, 'application/json', {'Cache-Control': 'max-age=300'})

        if path.startswith('/book/'):
            rest = path[len('/book/'):]
            name, _, entry = rest.partition('/')
            p = self._book_path(name)
            if not p or not entry:
                return self._send(404, b'not found')
            return self._serve_entry(p, entry)

        self._send(404, b'not found')

    def _serve_audio(self, book):
        """Stream the m4b itself. Chromium seeks with Range requests, so this
        must not read the file into memory; 64 KB chunks keep it at one buffer."""
        try:
            size = os.path.getsize(book)
        except OSError:
            return self._send(404, b'no audio')
        if size <= 0:
            return self._send(404, b'no audio')
        ctype = 'audio/mp4' if book.lower().endswith(AUDIO_EXTS) else 'application/octet-stream'
        start, end, code = 0, size - 1, 200
        m = re.match(r'bytes=(\d*)-(\d*)$', (self.headers.get('Range') or '').strip())
        if m and (m.group(1) or m.group(2)):
            if m.group(1):
                start = int(m.group(1))
                end = int(m.group(2)) if m.group(2) else size - 1
            else:
                start = max(0, size - int(m.group(2) or 0))
            end = min(end, size - 1)
            if start > end or start >= size:
                return self._send(416, b'', extra={'Content-Range': 'bytes */%d' % size})
            code = 206
        length = end - start + 1
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(length))
        self.send_header('Accept-Ranges', 'bytes')
        self.send_header('Cache-Control', 'no-cache')
        if code == 206:
            self.send_header('Content-Range', 'bytes %d-%d/%d' % (start, end, size))
        self.end_headers()
        if self.command == 'HEAD':
            return
        with open(book, 'rb') as f:
            f.seek(start)
            left = length
            while left > 0:
                chunk = f.read(min(65536, left))
                if not chunk:
                    break
                try:
                    self.wfile.write(chunk)
                except (BrokenPipeError, ConnectionResetError):
                    return
                left -= len(chunk)

    def _serve_entry(self, book, entry):
        try:
            with zipfile.ZipFile(book) as z:
                info = z.getinfo(entry)
        except KeyError:
            return self._send(404, b'no entry')
        except Exception:
            return self._send(404, b'bad zip')
        ctype = mime(entry)
        size = info.file_size
        rng = self.headers.get('Range', '')
        m = re.match(r'bytes=(\d*)-(\d*)$', rng.strip())
        with zipfile.ZipFile(book) as z:
            if m and (m.group(1) or m.group(2)):
                start = int(m.group(1)) if m.group(1) else 0
                end = int(m.group(2)) if m.group(2) else size - 1
                end = min(end, size - 1)
                if start > end:
                    return self._send(416, b'', extra={'Content-Range': 'bytes */%d' % size})
                body = z.read(entry)[start:end + 1]
                return self._send(206, body, ctype, {
                    'Content-Range': 'bytes %d-%d/%d' % (start, end, size),
                    'Accept-Ranges': 'bytes',
                })
            body = z.read(entry)
        self._send(200, body, ctype, {'Accept-Ranges': 'bytes'})


def selftest(path):
    data = load_book(path)
    secs = data['sections']
    assert secs, 'no sections with media overlays'
    total = 0
    for s in secs:
        assert s['pars'], 'section without pars: ' + s['href']
        prev, prev_audio = -1.0, None
        for p in s['pars']:
            assert p['audio'].endswith(('.mp4', '.m4a', '.mp3', '.ogg')), p['audio']
            assert p['end'] >= p['begin'], 'end before begin in ' + s['href']
            if p['audio'] != prev_audio:
                prev_audio, prev = p['audio'], -1.0     # each audio file has its own clock
            assert p['begin'] >= prev - 1e-6, 'pars out of order in ' + s['href']
            prev = p['begin']
            total += 1
    print('%s: %d sections, %d pars, first=%r' % (
        os.path.basename(path), len(secs), total, secs[0]['title']))
    print('ok')


def st_config():
    try:
        with open(os.path.expanduser('~/.config/readaloud/config.json')) as f:
            cfg = json.load(f) or {}
        return cfg.get('storyteller') or {}
    except Exception:
        return {}


def _norm(s):
    return re.sub(r'[^a-z0-9]+', '', (s or '').lower())


_ST_TOKEN = {'tok': None, 'at': 0.0}


def st_token(cfg):
    import urllib.parse
    import urllib.request
    now = time.time()
    if _ST_TOKEN['tok'] and now - _ST_TOKEN['at'] < 600:
        return _ST_TOKEN['tok']
    base = (cfg.get('url') or '').rstrip('/')
    body = urllib.parse.urlencode({'username': cfg.get('username', ''),
                                   'password': cfg.get('password', '')}).encode()
    with urllib.request.urlopen(urllib.request.Request(base + '/api/token', data=body),
                                timeout=1.5) as r:
        token = (json.load(r) or {}).get('access_token')
    _ST_TOKEN.update(tok=token, at=now)
    return token


def st_cover(cfg, uuid):
    """Cache Storyteller covers locally; the handheld asks once per book."""
    import urllib.request
    img = os.path.join(CACHE_DIR, 'st-' + uuid + '.img')
    if os.path.exists(img):
        return img, 'image/jpeg'
    base = (cfg.get('url') or '').rstrip('/')
    req = urllib.request.Request(base + '/api/v2/books/%s/cover' % uuid,
                                 headers={'Authorization': 'Bearer ' + (st_token(cfg) or '')})
    with urllib.request.urlopen(req, timeout=4.0) as r:
        data = r.read()
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(img, 'wb') as f:
        f.write(data)
    make_thumb(img, 'st-' + uuid)          # queued, not blocking this request
    return img, 'image/jpeg'


def storyteller_list(cfg):
    """Storyteller library. Short timeouts: the local list must never wait on it."""
    import urllib.request
    base = (cfg.get('url') or '').rstrip('/')
    if not base:
        return []
    req = urllib.request.Request(base + '/api/v2/books?limit=200',
                                 headers={'Authorization': 'Bearer ' + (st_token(cfg) or '')})
    with urllib.request.urlopen(req, timeout=2.0) as r:
        raw = json.load(r)
    items = raw if isinstance(raw, list) else (raw.get('books') or [])
    out = []
    for b in items:
        ra = b.get('readaloud') or {}
        se = b.get('series') or []
        series = (se[0].get('name') or '').strip() if se else ''
        position = se[0].get('position') if se else None
        colls = [c.get('name') or '' for c in (b.get('collections') or [])]
        collection = colls[0].split('\u00b7')[-1].strip() if colls else ''
        if not series and colls:                 # no series relation: use edition
            series = colls[0].split('\u00b7')[0].strip()
        out.append({
            'uuid': b.get('uuid'),
            'title': (b.get('title') or '').strip(),
            'series': series,
            'position': position,
            'collection': collection,
            'aligned': ra.get('status') == 'ALIGNED' or bool(b.get('alignedAt')),
        })
    return out


DOWNLOADS = {}
DL_LOCK = threading.Lock()


def battery_state():
    import glob
    for d in glob.glob('/sys/class/power_supply/*'):
        if os.path.basename(d) == 'battery':
            try:
                cap = int(open(os.path.join(d, 'capacity')).read().strip())
                st = open(os.path.join(d, 'status')).read().strip()
                return {'level': cap, 'charging': st.lower().startswith('charg')}
            except Exception:
                pass
    return {'level': None, 'charging': False}


def download_book(cfg, uuid, title, root):
    """Stream the readaloud epub from Storyteller to the library, tracking bytes."""
    import urllib.parse
    import urllib.request
    key = uuid
    name = re.sub(r'[\\/:*?"<>|]+', ' ', title or 'book').strip() or 'book'
    dest = os.path.join(root, name + ' (readaloud).epub')
    part = dest + '.part'
    with DL_LOCK:
        DOWNLOADS[key] = {'state': 'running', 'done': 0, 'total': 0, 'name': os.path.basename(dest)}
    try:
        base = (cfg.get('url') or '').rstrip('/')
        req = urllib.request.Request(base + '/api/v2/books/%s/files' % uuid,
                                     headers={'Authorization': 'Bearer ' + (st_token(cfg) or '')})
        with urllib.request.urlopen(req, timeout=180) as r:
            total = int(r.headers.get('Content-Length') or 0)
            done = 0
            with open(part, 'wb') as f:
                while True:
                    chunk = r.read(262144)
                    if not chunk:
                        break
                    f.write(chunk)
                    done += len(chunk)
                    with DL_LOCK:
                        DOWNLOADS[key].update(done=done, total=total)
        os.replace(part, dest)
        with DL_LOCK:
            DOWNLOADS[key]['state'] = 'done'
            DOWNLOADS[key]['file'] = os.path.basename(dest)
    except Exception as e:
        try:
            os.unlink(part)
        except Exception:
            pass
        with DL_LOCK:
            DOWNLOADS[key]['state'] = 'failed'
            DOWNLOADS[key]['error'] = str(e)


def chromium_args(port):
    return [
        'chromium', '--kiosk', '--disable-smooth-scrolling',
        '--app=http://127.0.0.1:%d/' % port,
        '--user-data-dir=' + os.path.expanduser('~/.cache/readaloud-chromium'),
        '--autoplay-policy=no-user-gesture-required', '--no-first-run',
        '--disable-background-networking', '--disable-component-update',
        '--disable-default-apps', '--disable-sync', '--no-service-autorun',
        '--disable-features=Translate,MediaRouter,CalculateNativeWinOcclusion',
        '--disable-backgrounding-occluded-windows',
        '--disable-renderer-backgrounding',
        '--disable-background-timer-throttling',
        '--disable-extensions', '--password-store=basic',
    ]


def port_up(port):
    import socket
    with socket.socket() as s:
        s.settimeout(0.3)
        return s.connect_ex(('127.0.0.1', port)) == 0


def server_pids(marker='--serve'):
    """Server processes started detached by --open (never this process)."""
    out = []
    for pid in os.listdir('/proc'):
        if not pid.isdigit() or int(pid) == os.getpid():
            continue
        try:
            cl = open('/proc/%s/cmdline' % pid, 'rb').read().decode('utf8', 'replace')
        except Exception:
            continue
        argv = cl.split('\0')
        if argv and argv[0].endswith('python3') and marker in argv and 'readaloud' in cl:
            out.append(int(pid))
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('dir', nargs='?', default=os.path.expanduser('~/Downloads'))
    ap.add_argument('--port', type=int, default=8099)
    ap.add_argument('--open', action='store_true', help='launch the player window')
    ap.add_argument('--serve', action='store_true', help='run the server in the foreground')
    ap.add_argument('--stop', action='store_true', help='stop a detached server')
    ap.add_argument('--selftest', metavar='EPUB')
    a = ap.parse_args()
    if a.selftest:
        return selftest(a.selftest)
    if a.stop:
        for pid in server_pids():
            try:
                os.kill(pid, 15)
            except Exception:
                pass
        return
    root = os.path.abspath(os.path.expanduser(a.dir))
    if not os.path.isdir(root):
        sys.exit('not a directory: ' + root)

    if a.open:
        import subprocess
        # Never stack windows: duplicates are what quietly ate the 1 GB.
        close_app()
        time.sleep(0.4)
        if not port_up(a.port):
            # The server outlives the window: closing a book (or the app) must
            # never leave the browser pointing at a dead port.
            os.makedirs(CACHE_DIR, exist_ok=True)
            log = open(os.path.join(CACHE_DIR, 'server.log'), 'a')
            subprocess.Popen([sys.executable, os.path.abspath(__file__), root,
                              '--port', str(a.port), '--serve'],
                             start_new_session=True, stdout=log, stderr=log)
            for _ in range(50):
                if port_up(a.port):
                    break
                time.sleep(0.1)
        subprocess.Popen(chromium_args(a.port)).wait()
        return

    # If a previous run left the panel black, put the backlight back.
    st = _bright_state()
    if os.path.exists(st) and _backlight():
        try:
            with open(st) as f:
                val = f.read().strip()
            with open(_backlight(), 'w') as f:
                f.write(val or '255')
            os.unlink(st)
        except OSError:
            pass
    srv = ThreadingHTTPServer(('127.0.0.1', a.port), Handler)
    srv.root = root
    print("library: %s -> http://127.0.0.1:%d/" % (root, a.port), flush=True)
    threading.Thread(target=watch_jack, daemon=True).start()
    threading.Thread(target=warm_thumbs, daemon=True).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == '__main__':
    main()
