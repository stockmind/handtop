diff -urN a/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c b/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c	2026-10-29 17:19:46.650872653 +0100
@@ -0,0 +1,258 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Cedrus VPU driver
+ *
+ * VP9 backend for the Allwinner H616/H700 VPU.
+ *
+ * The VE register map is not documented in the H616 user manual. Everything
+ * here comes from the vendor decoder (libawvp9Hw.so, Vp9Asic* functions) and
+ * the recovered map in docs/vp9-h700-regs.h: the decoder is programmed through
+ * a 184-word parameter block laid out at the start of the VE window, plus a
+ * tile table in DMA memory.
+ *
+ * State: the block is filled from the stateless controls (dimensions, tiles,
+ * references) but the engine is not started yet - the bitstream and output
+ * address registers, the probability block and the engine mode word are still
+ * unknown, so setup() refuses the job instead of handing the engine garbage.
+ */
+
+#include <linux/types.h>
+#include <linux/unaligned.h>
+
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+/* Parameter block words (byte offset = word * 4, from docs/vp9-h700-regs.h). */
+#define VE_VP9_PIC_MODE		0x00c	/* Vp9AsicInit writes 13 here */
+#define VE_VP9_PIC_MODE_INIT	13
+#define VE_VP9_PIC_SIZE		0x010	/* (w+7)/8 << 19 | (h+7)/8 << 6 */
+#define VE_VP9_PIC_SIZE_SHIFT	19
+#define VE_VP9_PIC_HEIGHT_SHIFT	6
+#define VE_VP9_PIC_SIZE_MASK	0x1fff
+#define VE_VP9_PIC_WIDTH4	0x050	/* ((w+7) & ~3) / 4 << 16 */
+#define VE_VP9_PIC_WIDTH4_SHIFT	16
+#define VE_VP9_TILE_CFG		0x028	/* tiled << 1, cols << 20, rows << 15 */
+#define VE_VP9_TILE_ENABLE	BIT(1)
+#define VE_VP9_TILE_COLS_SHIFT	20
+#define VE_VP9_TILE_ROWS_SHIFT	15
+#define VE_VP9_TILE_COUNT_MASK	0x1f
+#define VE_VP9_TILE_COLS_LOG2	0x29c
+#define VE_VP9_REF_SIZE		0x084	/* per slot: ref_w << 16 | ref_h */
+#define VE_VP9_REF_SCALE	0x090	/* per slot: hscale << 16 | vscale */
+
+#define CEDRUS_VP9_REF_SLOTS	3
+
+static u32 cedrus_vp9_field_get(u32 *block, u32 off)
+{
+	return block[off / 4];
+}
+
+static void cedrus_vp9_field_set(u32 *block, u32 off, u32 mask, u32 shift,
+				 u32 value)
+{
+	block[off / 4] &= ~(mask << shift);
+	block[off / 4] |= (value & mask) << shift;
+}
+
+/*
+ * Tile grid, same shape the vendor decoder builds: one 32-bit entry per tile
+ * with the tile width in 64-pixel units in the upper half and the tile height
+ * in the lower half, rows outer, columns inner.
+ */
+static void cedrus_vp9_fill_tiles(struct cedrus_ctx *ctx,
+				  const struct v4l2_ctrl_vp9_frame *frame,
+				  u32 width, u32 height)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u8 *tiles = ctx->codec.vp9.tile_buf;
+	unsigned int cols_log2 = frame->tile_cols_log2;
+	unsigned int rows_log2 = frame->tile_rows_log2;
+	unsigned int cols = 1 << cols_log2;
+	unsigned int rows = 1 << rows_log2;
+	unsigned int col, row, i = 0;
+	unsigned int sb_cols = DIV_ROUND_UP(width, CEDRUS_VP9_TILE_SIZE);
+	unsigned int sb_rows = DIV_ROUND_UP(height, CEDRUS_VP9_TILE_SIZE);
+
+	for (row = 0; row < rows; row++) {
+		unsigned int y0 = sb_rows * row / rows;
+		unsigned int y1 = sb_rows * (row + 1) / rows;
+
+		for (col = 0; col < cols; col++) {
+			unsigned int x0 = sb_cols * col / cols;
+			unsigned int x1 = sb_cols * (col + 1) / cols;
+
+			if (i * 4 + 4 > CEDRUS_VP9_TILE_BUF_SIZE)
+				return;
+			put_unaligned_le32(((x1 - x0) << 16) | (y1 - y0),
+					   tiles + i * 4);
+			i++;
+		}
+	}
+
+	dma_sync_single_for_device(dev->dev, ctx->codec.vp9.tile_buf_dma,
+				   CEDRUS_VP9_TILE_BUF_SIZE, DMA_TO_DEVICE);
+}
+
+static void cedrus_vp9_fill_refs(struct cedrus_ctx *ctx,
+				 const struct v4l2_ctrl_vp9_frame *frame,
+				 u32 width, u32 height)
+{
+	struct vb2_queue *cap_q = &ctx->fh.m2m_ctx->cap_q_ctx.q;
+	u32 *block = ctx->codec.vp9.block;
+	const u64 ts[CEDRUS_VP9_REF_SLOTS] = {
+		frame->last_frame_ts, frame->golden_frame_ts, frame->alt_frame_ts
+	};
+	unsigned int i;
+
+	for (i = 0; i < CEDRUS_VP9_REF_SLOTS; i++) {
+		struct vb2_buffer *buf = vb2_find_buffer(cap_q, ts[i]);
+		struct v4l2_pix_format *fmt = &ctx->dst_fmt;
+		u32 ref_w, ref_h, hscale, vscale;
+
+		if (!buf)
+			continue;
+
+		/* Reference frames are decoded at the capture resolution. */
+		ref_w = fmt->width;
+		ref_h = fmt->height;
+		hscale = (ref_w << 14) / width;
+		vscale = (ref_h << 14) / height;
+
+		cedrus_vp9_field_set(block, VE_VP9_REF_SIZE + i * 4,
+				     0xffff, 16, ref_w);
+		cedrus_vp9_field_set(block, VE_VP9_REF_SIZE + i * 4,
+				     0xffff, 0, ref_h);
+		cedrus_vp9_field_set(block, VE_VP9_REF_SCALE + i * 4,
+				     0xffff, 16, hscale);
+		cedrus_vp9_field_set(block, VE_VP9_REF_SCALE + i * 4,
+				     0xffff, 0, vscale);
+	}
+
+}
+
+static enum cedrus_irq_status
+cedrus_vp9_irq_status(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 reg = cedrus_read(dev, 0x04);
+
+	/* FIXME: the VP9 status bits are still being decoded; the vendor shim
+	 * polls 0x04 & 0x53900 for "engine did something". */
+	if (reg & 0x53900)
+		return CEDRUS_IRQ_OK;
+
+	return CEDRUS_IRQ_NONE;
+}
+
+static void cedrus_vp9_irq_clear(struct cedrus_ctx *ctx)
+{
+	/* FIXME: the vendor clears bit 8 of 0x04. */
+	cedrus_write(ctx->dev, 0x04, cedrus_read(ctx->dev, 0x04) & ~0x100);
+}
+
+static void cedrus_vp9_irq_disable(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, 0x04, cedrus_read(ctx->dev, 0x04) & ~0x10);
+}
+
+static int cedrus_vp9_start(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	ctx->codec.vp9.tile_buf = dma_alloc_coherent(dev->dev,
+						    CEDRUS_VP9_TILE_BUF_SIZE,
+						    &ctx->codec.vp9.tile_buf_dma,
+						    GFP_KERNEL);
+	if (!ctx->codec.vp9.tile_buf)
+		return -ENOMEM;
+
+	return 0;
+}
+
+static int cedrus_vp9_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	const struct v4l2_ctrl_vp9_frame *frame = run->vp9.frame_params;
+	u32 *block = ctx->codec.vp9.block;
+	u32 width, height, tiles;
+
+	if (!frame || !run->vp9.hdr) {
+		v4l2_err(&ctx->dev->v4l2_dev, "VP9: missing frame controls\n");
+		return -EINVAL;
+	}
+
+	width = frame->frame_width_minus_1 + 1;
+	height = frame->frame_height_minus_1 + 1;
+
+	memset(block, 0, sizeof(ctx->codec.vp9.block));
+
+	cedrus_vp9_field_set(block, VE_VP9_PIC_MODE, 0x3f, 27,
+			     VE_VP9_PIC_MODE_INIT);
+	cedrus_vp9_field_set(block, VE_VP9_PIC_SIZE, VE_VP9_PIC_SIZE_MASK,
+			     VE_VP9_PIC_SIZE_SHIFT, (width + 7) >> 3);
+	cedrus_vp9_field_set(block, VE_VP9_PIC_SIZE, VE_VP9_PIC_SIZE_MASK,
+			     VE_VP9_PIC_HEIGHT_SHIFT, (height + 7) >> 3);
+	cedrus_vp9_field_set(block, VE_VP9_PIC_WIDTH4, 0xfff,
+			     VE_VP9_PIC_WIDTH4_SHIFT,
+			     ((width + 7) & ~3) >> 2);
+
+	tiles = frame->tile_cols_log2 | frame->tile_rows_log2;
+	cedrus_vp9_field_set(block, VE_VP9_TILE_CFG, 1, 1, tiles ? 1 : 0);
+	cedrus_vp9_field_set(block, VE_VP9_TILE_CFG, VE_VP9_TILE_COUNT_MASK,
+			     VE_VP9_TILE_COLS_SHIFT,
+			     1 << frame->tile_cols_log2);
+	cedrus_vp9_field_set(block, VE_VP9_TILE_CFG, VE_VP9_TILE_COUNT_MASK,
+			     VE_VP9_TILE_ROWS_SHIFT,
+			     1 << frame->tile_rows_log2);
+	cedrus_vp9_field_set(block, VE_VP9_TILE_COLS_LOG2, 0xffff, 0,
+			     frame->tile_cols_log2);
+
+	cedrus_vp9_fill_tiles(ctx, frame, width, height);
+	cedrus_vp9_fill_refs(ctx, frame, width, height);
+
+	ctx->codec.vp9.tile_cols_log2 = frame->tile_cols_log2;
+	ctx->codec.vp9.tile_rows_log2 = frame->tile_rows_log2;
+
+	v4l2_dbg(1, 2, &ctx->dev->v4l2_dev,
+		 "VP9 %ux%u profile %u tiles %u/%u: size=0x%08x width4=0x%08x tile=0x%08x ref0=0x%08x scale0=0x%08x\n",
+		 width, height, frame->profile, frame->tile_cols_log2,
+		 frame->tile_rows_log2,
+		 cedrus_vp9_field_get(block, VE_VP9_PIC_SIZE),
+		 cedrus_vp9_field_get(block, VE_VP9_PIC_WIDTH4),
+		 cedrus_vp9_field_get(block, VE_VP9_TILE_CFG),
+		 cedrus_vp9_field_get(block, VE_VP9_REF_SIZE),
+		 cedrus_vp9_field_get(block, VE_VP9_REF_SCALE));
+
+	/* M3+: program the block, bitstream/output addresses and kick 0x04. */
+	return -EINVAL;
+}
+
+static void cedrus_vp9_stop(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	cedrus_engine_disable(dev);
+
+	if (ctx->codec.vp9.tile_buf) {
+		dma_free_coherent(dev->dev, CEDRUS_VP9_TILE_BUF_SIZE,
+				  ctx->codec.vp9.tile_buf,
+				  ctx->codec.vp9.tile_buf_dma);
+		ctx->codec.vp9.tile_buf = NULL;
+	}
+}
+
+static void cedrus_vp9_trigger(struct cedrus_ctx *ctx)
+{
+}
+
+struct cedrus_dec_ops cedrus_dec_ops_vp9 = {
+	.irq_clear	= cedrus_vp9_irq_clear,
+	.irq_disable	= cedrus_vp9_irq_disable,
+	.irq_status	= cedrus_vp9_irq_status,
+	.setup		= cedrus_vp9_setup,
+	.start		= cedrus_vp9_start,
+	.stop		= cedrus_vp9_stop,
+	.trigger	= cedrus_vp9_trigger,
+};
