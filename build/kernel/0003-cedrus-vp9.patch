diff -urN a/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c b/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c	2026-10-29 16:48:16.297640623 +0100
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Cedrus VPU driver
+ *
+ * VP9 backend for the Allwinner H616/H700 VPU.
+ *
+ * The VE register map is not documented in the H616 user manual; the offsets
+ * below come from the vendor decoder (libawvp9Hw.so, Vp9Asic* functions).
+ *
+ * Work in progress: the codec is advertised and the controls are wired up,
+ * register programming is not implemented yet, so every job is refused with
+ * -EINVAL instead of producing garbage.
+ */
+
+#include <linux/types.h>
+
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+static enum cedrus_irq_status
+cedrus_vp9_irq_status(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 reg = cedrus_read(dev, VE_H264_STATUS);
+
+	/* FIXME: VP9 status bits are not known yet, share the VP8 ones. */
+	if (reg & (VE_H264_STATUS_DECODE_ERR_INT |
+		   VE_H264_STATUS_VLD_DATA_REQ_INT))
+		return CEDRUS_IRQ_ERROR;
+
+	if (reg & VE_H264_CTRL_SLICE_DECODE_INT)
+		return CEDRUS_IRQ_OK;
+
+	return CEDRUS_IRQ_NONE;
+}
+
+static void cedrus_vp9_irq_clear(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_H264_STATUS, VE_H264_STATUS_INT_MASK);
+}
+
+static void cedrus_vp9_irq_disable(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 reg = cedrus_read(dev, VE_H264_CTRL);
+
+	cedrus_write(dev, VE_H264_CTRL, reg & ~VE_H264_CTRL_INT_MASK);
+}
+
+static int cedrus_vp9_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	const struct v4l2_ctrl_vp9_frame *frame = run->vp9.frame_params;
+	const struct v4l2_ctrl_vp9_compressed_hdr *hdr = run->vp9.hdr;
+
+	if (!frame || !hdr) {
+		v4l2_err(&ctx->dev->v4l2_dev, "VP9: missing frame controls\n");
+		return -EINVAL;
+	}
+
+	v4l2_dbg(1, 2, &ctx->dev->v4l2_dev,
+		 "VP9 %ux%u profile %u, %u/%u header bytes, tiles %u/%u\n",
+		 frame->frame_width_minus_1 + 1,
+		 frame->frame_height_minus_1 + 1, frame->profile,
+		 frame->uncompressed_header_size,
+		 frame->compressed_header_size,
+		 frame->tile_cols_log2, frame->tile_rows_log2);
+
+	/* Register programming lands in M2. */
+	return -EINVAL;
+}
+
+static void cedrus_vp9_stop(struct cedrus_ctx *ctx)
+{
+	cedrus_engine_disable(ctx->dev);
+}
+
+static void cedrus_vp9_trigger(struct cedrus_ctx *ctx)
+{
+}
+
+struct cedrus_dec_ops cedrus_dec_ops_vp9 = {
+	.irq_clear	= cedrus_vp9_irq_clear,
+	.irq_disable	= cedrus_vp9_irq_disable,
+	.irq_status	= cedrus_vp9_irq_status,
+	.setup		= cedrus_vp9_setup,
+	.stop		= cedrus_vp9_stop,
+	.trigger	= cedrus_vp9_trigger,
+};
