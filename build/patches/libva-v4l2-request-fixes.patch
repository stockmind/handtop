diff --git a/src/surface.c b/src/surface.c
index da433b2..01a3905 100644
--- a/src/surface.c
+++ b/src/surface.c
@@ -238,6 +238,51 @@ VAStatus v4l2r_QuerySurfaceAttributes(VADriverContextP va_ctx, VAConfigID config
  * back for reordering, wait for the decode itself, then for any pending
  * format conversion into the backing.
  */
+/*
+ * Copy the decoded CAPTURE buffer into the surface's own backing. Used for
+ * surfaces a client imported before they were ever decoded (keep_backing):
+ * that import is the backing, so its contents have to keep up. Pitch-aware
+ * because CAPTURE and backing layouts can differ by rounding.
+ */
+void v4l2r_surface_copy_backing(struct v4l2r_surface *surface)
+{
+	struct v4l2r_frame_view src;
+	struct v4l2r_surface_backing *dst = surface->backing;
+	unsigned int planes, i;
+
+	if (!dst || v4l2r_surface_capture_view(surface, true, &src) != VA_STATUS_SUCCESS)
+		return;
+
+	planes = src.nb_planes < dst->nb_planes ? src.nb_planes : dst->nb_planes;
+	for (i = 0; i < planes; i++) {
+		const uint8_t *from = src.map[i];
+		uint8_t *to = dst->map[i];
+		size_t row = src.pitch < dst->pitch ? src.pitch : dst->pitch;
+		size_t rows = i ? (src.height + 1) / 2 : src.height;
+
+		/* A client that only ever took the dma-buf fd never mapped the
+		 * backing; map it here so the copy has somewhere to land. */
+		if (!to && dst->dmabuf_fd[i] >= 0) {
+			to = mmap(NULL, dst->plane_size[i], PROT_READ | PROT_WRITE,
+				  MAP_SHARED, dst->dmabuf_fd[i], 0);
+			if (to == MAP_FAILED)
+				to = NULL;
+			else
+				dst->map[i] = to;
+		}
+		if (!from || !to)
+			continue;
+		if (src.pitch == dst->pitch) {
+			size_t bytes = src.plane_size[i] < dst->plane_size[i] ?
+				       src.plane_size[i] : dst->plane_size[i];
+			memcpy(to, from, bytes);
+			continue;
+		}
+		for (size_t y = 0; y < rows; y++)
+			memcpy(to + y * dst->pitch, from + y * src.pitch, row);
+	}
+}
