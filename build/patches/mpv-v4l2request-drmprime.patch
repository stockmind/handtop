--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -484,6 +484,26 @@
 
         if (hw_ctx && hw_ctx->av_device_ref)
             return av_buffer_ref(hw_ctx->av_device_ref);
+
+        // No interop provides a device of this hwdec's type, but the VO may
+        // still be able to consume its frames: the dmabuf (DRM PRIME) interop
+        // renders frames from any producer (e.g. a stateless V4L2 request
+        // decoder) through its own, differently typed DRM device. The decoder
+        // only needs a device of its own type, so create that here.
+        if (hw_ctx)
+            return NULL;
+
+        for (int n = 0; ; n++) {
+            struct mp_hwdec_ctx *vo_ctx = hwdec_devices_get_n(ctx->hwdec_devs, n);
+            if (!vo_ctx)
+                break;
+            if (vo_ctx->hw_imgfmt != imgfmt)
+                continue;
+            AVBufferRef *ref = NULL;
+            if (av_hwdevice_ctx_create(&ref, hwdec->lavc_device, NULL, NULL, 0) < 0)
+                return NULL;
+            return ref;
+        }
     }
 
     return NULL;
